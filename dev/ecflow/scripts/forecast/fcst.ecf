#!/bin/bash
%include <head.h>
%include <envir.h>

set -x

export HOMEglobal=%HOMEglobal%
export EXPDIR=%EXPDIR%
export COMROOT=%COMROOT%
export DATAROOT=%DATAROOT%
export NET=%NET%
export PDY=%PDY%
export cyc=%CYC%
export machine=URSA

source "${HOMEglobal}/dev/ush/load_modules.sh" run
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR loading modules***"
  ecflow_client --abort
  exit "${status}"
fi

export job="fcst"
export jobid="${job}.${SLURM_JOB_ID:-$$}"
export FCST_SEGMENT=0

"${HOMEglobal}/dev/jobs/JGLOBAL_FCST"
status=$?
if [[ ${status} -ne 0 ]]; then
  ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT***"
  ecflow_client --abort
  exit "${status}"
fi

%include <tail.h>
