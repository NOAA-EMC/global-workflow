#! /usr/bin/env bash

########## config.atmensanl ##########
# configuration common to all atm ens analysis tasks

echo "BEGIN: config.atmensanl"

export JCB_ALGO_YAML_LETKF="${PARMgfs}/gdas/atm/jcb-prototype_lgetkf.yaml.j2"
export JCB_ALGO_YAML_OBS="${PARMgfs}/gdas/atm/jcb-prototype_lgetkf_observer.yaml.j2"
export JCB_ALGO_YAML_SOL="${PARMgfs}/gdas/atm/jcb-prototype_lgetkf_solver.yaml.j2"
export JCB_ALGO_YAML_FV3INC="${PARMgfs}/gdas/atm/jcb-prototype_lgetkf-fv3inc.yaml.j2"

export INTERP_METHOD='barycentric'

export CRTM_FIX_YAML="${PARMgfs}/gdas/atm_crtm_coeff.yaml.j2"
export JEDI_FIX_YAML="${PARMgfs}/gdas/atm_jedi_fix.yaml.j2"

export JEDI_CONFIG_YAML="${PARMgfs}/gdas/atmensanl_jedi_config.yaml.j2"
export LGETKF_BKG_STAGING_YAML="${PARMgfs}/gdas/staging/atm_lgetkf_bkg.yaml.j2"

export layout_x_atmensanl="8"
export layout_y_atmensanl="8"

export io_layout_x="1"
export io_layout_y="1"

echo "END: config.atmensanl"