#!/bin/bash

########## config.prepoceanobs ##########

echo "BEGIN: config.prepoceanobs"

export OCNOBS2IODAEXEC="${HOMEgfs}/sorc/gdas.cd/build/bin/gdas_ioda_obsprovider2ioda.x"

export SOCA_INPUT_FIX_DIR="${FIXgfs}/gdas/soca/72x35x25/soca"

export OBSPREP_YAML="${PARMgfs}/gdas/soca/obsprep/obsprep_config.yaml"

# ocean analysis needs own dmpdir until standard dmpdir has full ocean obs
use_exp_obs="YES"
if [[ "${use_exp_obs}" == "YES" ]]; then
    dmpdir_exp="${BASE_DATA}/experimental_obs"
fi

export DMPDIR="${dmpdir_exp:-${DMPDIR}}"

# Get task specific resources
. "${EXPDIR}/config.resources" prepoceanobs
echo "END: config.prepoceanobs"