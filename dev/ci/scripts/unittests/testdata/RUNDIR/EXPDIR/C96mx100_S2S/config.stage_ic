#! /usr/bin/env bash

########## config.stage_ic ##########

echo "BEGIN: config.stage_ic"

# Get task specific resources
source "${EXPDIR}/config.resources" stage_ic

export ICSDIR="/home/tmcguinness/GITHUB/COPILOT/global-workflow_forked/dev/ci/scripts/unittests/testdata/ICSDIR/C96mx100/20240610" # User provided ICSDIR; blank if not provided
export BASE_IC="/gpfs/f6/drsa-precip3/world-shared/role.glopara/data/ICSDIR" # Platform home for staged ICs

if [[ ${RUN} == "gefs" ]] ; then
  if [[ ${GEFSTYPE} = "near-real-time" ]] ; then
    export STAGE_IC_YAML_TMPL="${PARMgfs}/stage/master_gefs_RT.yaml.j2"
  elif [[ ${GEFSTYPE} = "gefs-offline" ]] ; then
    export STAGE_IC_YAML_TMPL="${PARMgfs}/stage/master_gefs.yaml.j2"
  else
    echo "ERROR: Invalid GEFSTYPE=${GEFSTYPE} for config.stage_ic"
  fi
else
  export STAGE_IC_YAML_TMPL="${PARMgfs}/stage/master_gefs.yaml.j2"
fi

source "${HOMEgfs}/versions/ic.ver"

if [[ ${EXP_WARM_START} = ".false." ]] ; then
  export DOIAU="NO"        # Turn off for staging
fi

# Set ICSDIR (if not defined)
if [[ -z "${ICSDIR}" ]] ; then

  if (( NMEM_ENS > 0 )) ; then
    ensic="${CASE_ENS}"
  fi

  if [[ "${DO_OCN:-NO}" == "YES" ]] ; then
    ocnic="mx${OCNRES}"
  fi

  dir_name="${CASE}${ensic:-}${ocnic:-}"
  ic_ver="${ic_versions[${dir_name}]}"

  export ICSDIR="${BASE_IC}/${dir_name}/${ic_ver}"

fi

echo "END: config.stage_ic"