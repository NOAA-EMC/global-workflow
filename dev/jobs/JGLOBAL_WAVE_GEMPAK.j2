#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh
source "${EXPDIR}/config.base"
source "${EXPDIR}/config.wave"
source "${EXPDIR}/config.wavegempak"



source "${USHgfs}/wave_domain_grid.sh"

###################################
# Set COM Paths
###################################
export DBN_ALERT_TYPE=GFS_WAVE_GEMPAK

export YMD=${PDY}
export HH=${cyc}
export COMOUT_WAVE_GEMPAK="{{ COM_WAVE_GEMPAK_TMPL }}"

if [[ -n "${GEMPAK_GRIDS}" ]]; then
    for grdID in ${GEMPAK_GRIDS}; do
        process_grdID "${grdID}"
        export YMD=${PDY}
        export HH=${cyc}
        export GRDRESNAME=${grdNAME}
        export COMIN_WAVE_GRID_${GRDREGION}_${GRDRES}="{{ COM_WAVE_GRID_RES_TMPL }}"
    done
else
    echo "'GEMPAK_GRIDS' is empty. No grids to process."
fi

if [[ ! -d ${COMOUT_WAVE_GEMPAK} ]]; then mkdir -p "${COMOUT_WAVE_GEMPAK}"; fi

########################################################
# Execute the script.
"${SCRgfs}/exgfs_wave_nawips.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi
###################################

# Remove temp directories
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" != "YES" ]]; then
    rm -rf "${DATA}"
fi

exit 0
