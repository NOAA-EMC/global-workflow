#! /usr/bin/env bash

# Ignore possible spelling error (nothing is misspelled)
# shellcheck disable=SC2153

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.ecen_fv3jedi"



GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
gPDY=${GDATE:0:8}
gcyc=${GDATE:8:2}
GDUMP="gdas"
GDUMP_ENS="enkfgdas"

##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates
export RUN=${GDUMP}
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMOUT_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"

export MEMDIR='ensstat'
export RUN=${GDUMP_ENS}
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_ANALYSIS_ENSSTAT="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMOUT_ATMOS_ANALYSIS_ENSSTAT="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMOUT_CONF="{{ COM_CONF_TMPL }}"

export RUN=${GDUMP}
export YMD=${gPDY}
export HH=${gcyc}
export COMIN_ATMOS_HISTORY_PREV="{{ COM_ATMOS_HISTORY_TMPL }}"

export RUN=${RUN}
export YMD=${PDY}
export HH=${cyc}

mkdir -m 755 -p "${COMOUT_CONF}"

##############################################
# Run relevant script
##############################################

EXSCRIPT=${GDASATMRUNPY:-${SCRgfs}/exglobal_enkf_ecen_fv3jedi.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################

if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##############################################
# Remove the Temporary working directory
##############################################

cd "${DATAROOT}" && true
export err=$?
set +x
if [[ ${err} -ne 0 ]]; then
    err_exit "${DATAROOT} does not exist, ABORT!"
fi
set_trace
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
