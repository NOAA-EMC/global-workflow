#! /usr/bin/env bash
set -x

# JEDI based 3DVar soil analysis in land only (weakly coupled) mode. This script is independent from
# JGLOBAL_ATMOS_SFCANL_GCYCLE which calls the GSI based coupled ATM-SOIL DA

export WIPE_DATA="NO"
export DATA=${DATA:-${DATAROOT}/${RUN}soilvar_${cyc}}
source "${HOMEglobal}/ush/jjob_header.sh" -e "soilanlvar" -c "base soilanlvar"

#{% if false %}
source "${HOMEglobal}/ush/jjob_standard_vars.sh"
#{% else %}
#{% include jjob_var_setup.j2 %}
#{% endif %}

source "${USHglobal}/jjob_shell_setup.sh"
# Set strict mode which will exit on error or undefined variable
# and exit on error in a pipeline (e.g. if a command in "cmd | cmd2" fails)
source "${USHglobal}/set_strict.sh"

##############################################
# Set variables used in the script
##############################################
# Setup Python path for pygfs
PYTHONPATH="${HOMEglobal}/ush/python${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH

##############################################
# Begin JOB SPECIFIC work
##############################################
# Ignore possible spelling error (nothing is misspelled)
# shellcheck disable=SC2153
GDATE=$(date --utc -d "${PDY} ${cyc} - ${assim_freq} hours" +%Y%m%d%H)
export GDATE

BKG_RUN="gdas"
if [[ "${RUN}" == "gcafs" || "${RUN}" == "gcdas" ]]; then
    BKG_RUN="gcdas"
fi

declare -rx COMIN_OBS_PREV="${ROTDIR}/${BKG_RUN}.${GDATE:0:8}/${GDATE:8:2}/obs"
declare -rx COMIN_ATMOS_RESTART_PREV="${ROTDIR}/${BKG_RUN}.${GDATE:0:8}/${GDATE:8:2}/model/atmos/restart"

declare -rx COMIN_OBS="${ROTDIR}/${RUN}.${PDY}/${cyc}/obs"
declare -rx COMIN_ATMOS_ANALYSIS="${ROTDIR}/${RUN}.${PDY}/${cyc}/analysis/atmos"
declare -rx COMIN_SNOW_ANALYSIS="${ROTDIR}/${RUN}.${PDY}/${cyc}/analysis/snow"

declare -rx COMOUT_ATMOS_RESTART="${ROTDIR}/${RUN}.${PDY}/${cyc}/model/atmos/restart"

declare -rx COMIN_ATMOS_ENKF_ANALYSIS_STAT="${ROTDIR}/enkfgdas.${PDY}/${cyc}/ensstat/analysis/atmos"

declare -rx COMIN_ATMOS_ANALYSIS_PREV="${ROTDIR}/${BKG_RUN}.${GDATE:0:8}/${GDATE:8:2}/analysis/atmos"
declare -rx COMIN_ATMOS_HISTORY_PREV="${ROTDIR}/${BKG_RUN}.${GDATE:0:8}/${GDATE:8:2}/model/atmos/history"

declare -rx COMOUT_SOIL_ANALYSIS="${ROTDIR}/${RUN}.${PDY}/${cyc}/analysis/atmos"
declare -rx COMOUT_SOIL_DIAG="${ROTDIR}/${RUN}.${PDY}/${cyc}/analysis/atmos"
declare -rx COMOUT_CONF="${ROTDIR}/${RUN}.${PDY}/${cyc}/conf"

# Use CFP to stage and save files in parallel
export USE_CFP=YES

mkdir -p "${COMOUT_SOIL_ANALYSIS}"
mkdir -p "${COMOUT_SOIL_DIAG}"
mkdir -p "${COMOUT_CONF}"

###############################################################
# Run relevant script

EXSCRIPT=${SOILANALSH:-${SCRglobal}/exglobal_soil_analysis.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "Failed to calculate the soil variational analysis"
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${WIPE_DATA}" == "YES" ]]; then
    rm -rf "${DATA}"
fi

exit 0
