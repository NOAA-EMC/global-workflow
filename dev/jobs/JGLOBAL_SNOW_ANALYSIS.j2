#! /usr/bin/env bash

cat "${HOMEglobal}/ush/jjob_header.sh"
source "${EXPDIR}/config.base"
source "${EXPDIR}/config.snowanl"



# Ignore possible spelling error (nothing is misspelled)
# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
gPDY=${GDATE:0:8}
gcyc=${GDATE:8:2}
GDUMP="gdas"

##############################################
# Begin JOB SPECIFIC work
##############################################
# Generate COM variables from templates
export YMD=${PDY}
export HH=${cyc}
export COMIN_OBS="{{ COM_OBS_TMPL }}"
export COMOUT_SNOW_ANALYSIS="{{ COM_SNOW_ANALYSIS_TMPL }}"
export COMOUT_CONF="{{ COM_CONF_TMPL }}"

export RUN=${GDUMP}
export YMD=${gPDY}
export HH=${gcyc}
export COMIN_ATMOS_RESTART_PREV="{{ COM_ATMOS_RESTART_TMPL }}"

mkdir -m 775 -p "${COMOUT_SNOW_ANALYSIS}" "${COMOUT_CONF}"

###############################################################
# Run relevant script

EXSCRIPT=${SNOWANLPY:-${SCRgfs}/exglobal_snow_analysis.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
