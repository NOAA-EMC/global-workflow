#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.anlstat"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates

export YMD=${PDY}
export HH=${cyc}
export COMIN_OBS="{{ COM_OBS_TMPL }}"
export COMOUT_CONF="{{ COM_CONF_TMPL }}"
export COMIN_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMOUT_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMOUT_ATMOS_ANLMON="{{ COM_ATMOS_ANLMON_TMPL }}"

mkdir -m 755 -p "${COMOUT_ATMOS_ANALYSIS}"
mkdir -m 755 -p "${COMOUT_ATMOS_ANLMON}"
mkdir -m 755 -p "${COMOUT_CONF}"

if [[ "${DO_AERO_ANL:-NO}" == "YES" ]]; then
    export COMIN_AERO_ANALYSIS="{{ COM_CHEM_ANALYSIS_TMPL }}"
    export COMOUT_AERO_ANALYSIS="{{ COM_CHEM_ANALYSIS_TMPL }}"
    export COMOUT_AERO_ANLMON="{{ COM_CHEM_ANLMON_TMPL }}"
    mkdir -m 755 -p "${COMOUT_AERO_ANALYSIS}"
    mkdir -m 755 -p "${COMOUT_AERO_ANLMON}"
fi

if [[ "${DO_JEDISNOWDA:-NO}" == "YES" ]]; then
    export COMIN_SNOW_ANALYSIS="{{ COM_SNOW_ANALYSIS_TMPL }}"
    export COMOUT_SNOW_ANALYSIS="{{ COM_SNOW_ANALYSIS_TMPL }}"
    export COMOUT_SNOW_ANLMON="{{ COM_SNOW_ANLMON_TMPL }}"
    mkdir -m 755 -p "${COMOUT_SNOW_ANALYSIS}"
    mkdir -m 755 -p "${COMOUT_SNOW_ANLMON}"
fi

###############################################################
# Run relevant script

EXSCRIPT=${ANLSTATSPY:-${SCRgfs}/exglobal_analysis_stats.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

exit 0
