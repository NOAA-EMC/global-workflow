#! /usr/bin/env bash

source "${HOMEgfs}/ush/preamble.sh"
source "${HOMEgfs}/ush/jjob_header.sh" -e "offlineanl"

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.offlineanl"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

##############################################
# Begin JOB SPECIFIC work
##############################################
# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
export gPDY=${GDATE:0:8}
export gcyc=${GDATE:8:2}
export GDUMP="${RUN}"

export APREFIX_IN="gdas.t${cyc}z."
export APREFIX="${RUN}.t${cyc}z."
export GPREFIX="${GDUMP}.t${gcyc}z."

export RUN_TMPL="gdas"
export DUMP_TMPL="gdas"

export YMD=${PDY}
export HH=${cyc}
export COMIN_OBSPROC="{{ COM_OBSPROC_TMPL }}"
export COMIN_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMOUT_OBS="{{ COM_OBS_TMPL }}"
export COMOUT_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"

export YMD=${gPDY}
export HH=${gcyc}
export COMIN_ATMOS_HISTORY_PREV="{{ COM_ATMOS_HISTORY_TMPL }}"

mkdir -p "${COMOUT_ATMOS_ANALYSIS}"
mkdir -p "${COMOUT_OBS}"

# Execute generation of increments from offline analysis
EXSCRIPT=${OFFLINEANLPY:-${SCRgfs}/exglobal_offline_atmos_analysis.py}
${EXSCRIPT}

export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "${EXSCRIPT} returned a non-zero status!"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || (
    echo "${DATAROOT} does not exist. ABORT!"
    exit 1
)
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
