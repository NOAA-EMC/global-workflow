#! /usr/bin/env bash
set -x
export DATA=${DATA:-${DATAROOT}/${RUN}fetch_${cyc}}
source "${HOMEglobal}/ush/jjob_header.sh" -e "fetch" -c "base fetch"
source "${HOMEglobal}/ush/jjob_standard_vars.sh"
source "${USHglobal}/jjob_shell_setup.sh"

# Setup Python path for pygfs
PYTHONPATH="${HOMEglobal}/ush/python${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH

# Execute fetching
# Do not export shell opts to the bash scripts in the htar/hsi wrappers
export -n SHELLOPTS
"${SCRglobal}/exglobal_fetch.py"
err=$?

###############################################################
# Check for errors and exit if any of the above failed
if [[ ${err} -ne 0 ]]; then
    err_exit "Unable to fetch ICs to ${ROTDIR}; ABORT!"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || exit 1
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
