#! /usr/bin/env bash

# TODO (#1225) This job is not part of the rocoto suite

############################################
# GFS PGRB2_SPECIAL_POST PRODUCT GENERATION
############################################
cat ${HOMEglobal}/ush/jjob_header.sh
source "${EXPDIR}/config.base"
source "${EXPDIR}/config.npoess"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}

##############################################
# Define COM directories
##############################################

export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_MASTER="{{ COM_ATMOS_MASTER_TMPL }}"
export COMOUT_ATMOS_GOES="{{ COM_ATMOS_GOES_TMPL }}"
export GRID="0p50"
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_GRIB_0p50="{{ COM_ATMOS_GRIB_GRID_TMPL }}"

mkdir -m 775 -p "${COMOUT_ATMOS_GOES}"

#############################################################
# Execute the script
"${SCRgfs}/exgfs_atmos_grib2_special_npoess.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi
#############################################################

############################################
# print exec I/O output
############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

###################################
# Remove temp directories
###################################
if [[ "${KEEPDATA}" != "YES" ]]; then
    rm -rf "${DATA}"
fi
