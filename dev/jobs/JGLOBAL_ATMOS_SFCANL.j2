#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.sfcanl"



##############################################
# Begin JOB SPECIFIC work
##############################################
# Ignore possible spelling error (nothing is misspelled)
# shellcheck disable=SC2153
GDATE=$(date --utc -d "${PDY} ${cyc} - ${assim_freq} hours" +%Y%m%d%H)
export GDATE

BKG_RUN="gdas"
if [[ "${RUN}" == "gcafs" || "${RUN}" == "gcdas" ]]; then
    BKG_RUN="gcdas"
fi

export YMD=${GDATE:0:8}
export HH=${GDATE:8:2}
export COMIN_OBS_PREV="{{ COM_OBS_TMPL }}"
export COMIN_ATMOS_RESTART_PREV="{{ COM_ATMOS_RESTART_TMPL }}"

export YMD=${PDY}
export HH=${cyc}
export COMIN_OBS="{{ COM_OBS_TMPL }}"
export COMIN_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMIN_SNOW_ANALYSIS="{{ COM_SNOW_ANALYSIS_TMPL }}"

export COMOUT_ATMOS_RESTART="{{ COM_ATMOS_RESTART_TMPL }}"

export MEMDIR="ensstat"
export COMIN_ATMOS_ENKF_ANALYSIS_STAT="{{ COM_ATMOS_ANALYSIS_TMPL }}"

mkdir -p "${COMOUT_ATMOS_RESTART}"

# Use CFP to stage and save files in parallel
export USE_CFP=YES

###############################################################
# Run relevant script

${SFCANALSH:-${SCRgfs}/exglobal_atmos_sfcanl.sh} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
