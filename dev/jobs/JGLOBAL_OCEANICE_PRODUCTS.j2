#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh
source "${EXPDIR}/config.base"
source "${EXPDIR}/config.oceanice_products"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

##############################################
# Begin JOB SPECIFIC work
##############################################

# Construct COM variables from templates
export YMD="${PDY}"
export HH="${cyc}"
export COMIN_${COMPONENT^^}_HISTORY="{{ COM_${COMPONENT^^}_HISTORY_TMPL }}"

export YMD="${PDY}"
export HH="${cyc}"
export COMOUT_${COMPONENT^^}_GRIB="{{ COM_${COMPONENT^^}_GRIB_TMPL }}"

export YMD="${PDY}"
export HH="${cyc}"
export COMOUT_${COMPONENT^^}_NETCDF="{{ COM_${COMPONENT^^}_NETCDF_TMPL }}"

###############################################################
# Run exglobal script
"${SCRgfs}/exglobal_oceanice_products.py" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || exit 1
if [[ "${KEEPDATA:-NO}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
