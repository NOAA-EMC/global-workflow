#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.ecen"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

##############################################
# Begin JOB SPECIFIC work
##############################################
# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
export gPDY=${GDATE:0:8}
export gcyc=${GDATE:8:2}
export GDUMP="gdas"
export GDUMP_ENS="enkf${GDUMP}"

export CASE=${CASE_ENS}

export OPREFIX="${RUN/enkf/}.t${cyc}z."
export APREFIX="${RUN/enkf/}.t${cyc}z."
export APREFIX_ENS="${RUN}.t${cyc}z."
export GPREFIX="${GDUMP}.t${gcyc}z."
export GPREFIX_ENS="${GDUMP_ENS}.t${gcyc}z."

export RUN=${RUN/enkf/}
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_ANALYSIS_DET="{{ COM_ATMOS_ANALYSIS_TMPL }}"

export MEMDIR="ensstat"
export YMD=${PDY}
export HH=${cyc}
export COMOUT_ATMOS_ANALYSIS_STAT="{{ COM_ATMOS_ANALYSIS_TMPL }}"

export MEMDIR="ensstat"
export RUN=${GDUMP}
export YMD=${gPDY}
export HH=${gcyc}
export COMIN_ATMOS_HISTORY_STAT_PREV="{{ COM_ATMOS_HISTORY_TMPL }}"

export RUN=${RUN}
export YMD=${PDY}
export HH=${cyc}

###############################################################
# Run relevant script

${ENKFRECENSH:-${SCRgfs}/exglobal_enkf_ecen.sh} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
