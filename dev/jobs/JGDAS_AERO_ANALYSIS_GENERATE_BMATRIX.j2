#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.aeroanl"
source "${EXPDIR}/config.aeroanlgenb"



##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates
export YMD=${PDY}
export HH=${cyc}
export COMIN_OBS="{{ COM_OBS_TMPL }}"
export COMOUT_CHEM_BMAT="{{ COM_CHEM_BMAT_TMPL }}"
export COMIN_ATMOS_RESTART="{{ COM_ATMOS_RESTART_TMPL }}"
export COMOUT_CONF="{{ COM_CONF_TMPL }}"

mkdir -p "${COMOUT_CHEM_BMAT}"
mkdir -p "${COMOUT_CONF}"

###############################################################
# Run relevant script

EXSCRIPT=${GDASAEROBMATPY:-${SCRgfs}/exgdas_aero_analysis_generate_bmatrix.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
