#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.atmos_products"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

##############################################
# Begin JOB SPECIFIC work
##############################################

# Construct COM variables from templates
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_ANALYSIS="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMIN_ATMOS_HISTORY="{{ COM_ATMOS_HISTORY_TMPL }}"
export COMIN_ATMOS_MASTER="{{ COM_ATMOS_MASTER_TMPL }}"

for grid in '0p25' '0p50' '1p00'; do
    prod_dir="COMOUT_ATMOS_GRIB_${grid}"
    export GRID=${grid}
    export YMD=${PDY}
    export HH=${cyc}
    export ${prod_dir}="{{ COM_ATMOS_GRIB_GRID_TMPL }}"
    mkdir -m 775 -p "${!prod_dir}"
done

# Variables used in this job
export PREFIX="${RUN}.t${cyc}z."

###############################################################
# Run exglobal script
"${SCRgfs}/exglobal_atmos_products.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || exit 1
if [[ "${KEEPDATA:-NO}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
