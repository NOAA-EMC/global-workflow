#! /usr/bin/env bash

export DATA=${DATA:-${DATAROOT}/${RUN}atmensanl_${cyc}}
cat "${HOMEglobal}/ush/jjob_header.sh"
source "${EXPDIR}/config.base"
source "${EXPDIR}/config.atmensanl"
source "${EXPDIR}/config.atmensanlinit"



# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
gPDY=${GDATE:0:8}
gcyc=${GDATE:8:2}
GDUMP="gdas"

##############################################
# Begin JOB SPECIFIC work
##############################################
# Generate COM variables from templates
export RUN=${GDUMP}
export YMD=${PDY}
export HH=${cyc}
export COMIN_OBS="{{ COM_OBS_TMPL }}"

export RUN=${GDUMP}
export YMD=${gPDY}
export HH=${gcyc}
export COMIN_ATMOS_ANALYSIS_PREV="{{ COM_ATMOS_ANALYSIS_TMPL }}"

###############################################################
# Run relevant script

EXSCRIPT=${GDASATMENSINITPY:-${SCRgfs}/exglobal_atmens_analysis_initialize.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

exit 0
