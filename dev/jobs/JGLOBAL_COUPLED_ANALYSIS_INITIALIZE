#!/bin/bash
set -x
# The marine job directory: marinebmat writes the SOCA static B (staticb) there
export DATAjob="${DATAROOT}/${RUN}_marineanalysis.${PDY:-}${cyc}"
export DATA="${DATAjob}/coupledanlvar"
source "${HOMEglobal}/ush/jjob_header.sh" -e "coupledanlinit" -c "base coupledanl coupledanlinit"

#{% if false %}
source "${HOMEglobal}/ush/jjob_standard_vars.sh"
#{% else %}
#{% include jjob_var_setup.j2 %}
#{% endif %}

source "${USHglobal}/jjob_shell_setup.sh"
# Set strict mode which will exit on error or undefined variable
# and exit on error in a pipeline (e.g. if a command in "cmd | cmd2" fails)
source "${USHglobal}/set_strict.sh"

##############################################
# Set variables used in the script
##############################################
# Setup Python path for pygfs
PYTHONPATH="${HOMEglobal}/ush/python${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH

# Ignore possible spelling error (nothing is misspelled)
# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
gPDY=${GDATE:0:8}
gcyc=${GDATE:8:2}
export GDUMP=${GDUMP:-"gdas"}

##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates
declare -rx COMIN_OBS="${ROTDIR}/${RUN}.${PDY}/${cyc}/obs"

declare -rx COMIN_ATMOS_ANALYSIS_PREV="${ROTDIR}/${GDUMP}.${gPDY}/${gcyc}/analysis/atmos"
declare -rx COMIN_ATMOS_HISTORY_PREV="${ROTDIR}/${GDUMP}.${gPDY}/${gcyc}/model/atmos/history"

declare -rx COMIN_OCEAN_HISTORY_PREV="${ROTDIR}/${GDUMP}.${gPDY}/${gcyc}/model/ocean/history"
declare -rx COMIN_ICE_HISTORY_PREV="${ROTDIR}/${GDUMP}.${gPDY}/${gcyc}/model/ice/history"
declare -rx COMIN_ICE_RESTART_PREV="${ROTDIR}/${GDUMP}.${gPDY}/${gcyc}/model/ice/restart"

declare -rx COMIN_OCEAN_BMATRIX="${ROTDIR}/${RUN}.${PDY}/${cyc}/analysis/ocean/bmatrix"
declare -rx COMIN_ICE_BMATRIX="${ROTDIR}/${RUN}.${PDY}/${cyc}/analysis/ice/bmatrix"

###############################################################
# Run relevant script

EXSCRIPT=${GDASCOUPLEDANALYSIS:-${SCRglobal}/exglobal_coupled_analysis_initialize.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "Failed to initialize the coupled analysis"
fi

# Fill in the gsibec namelist variant staged above: TLNMC on the static increment (option 1,
# what GSIBEC uses without an ensemble) and the hybrid ensemble block off, which leaves the
# static B at full weight. beta_s0 and n_ens must still be numbers for the namelist read.
if [[ "${LOCALIZATION_TYPE}" == "gsibec" ]]; then
    target_file="${DATA}/berror/gfs_gsi_global.nml"

    sed -i \
        -e "s|TLNMC_OPTION|1|g" \
        -e "s|l_hyb_ens=\.true\.|l_hyb_ens=.false.|g" \
        -e "s|BETAS0|1.0|g" \
        -e "s|NMEM_ENS|0|g" \
        "${target_file}"
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

exit 0
