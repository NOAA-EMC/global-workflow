#! /usr/bin/env bash

cat "${HOMEglobal}/ush/jjob_header.sh"

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.wave"
source "${EXPDIR}/config.wavepostsbs"



source "${USHgfs}/wave_domain_grid.sh"

# Set COM Paths
export YMD=${PDY}
export HH=${cyc}
export COMIN_WAVE_PREP="{{ COM_WAVE_PREP_TMPL }}"
export COMIN_WAVE_HISTORY="{{ COM_WAVE_HISTORY_TMPL }}"
export COMOUT_WAVE_GRID="{{ COM_WAVE_GRID_TMPL }}"

mkdir -p "${COMOUT_WAVE_GRID}"

if [[ -n "${wavepostGRD}" || -n "${waveinterpGRD}" ]]; then
    for grdID in ${wavepostGRD} ${waveinterpGRD}; do
        process_grdID "${grdID}"
        export YMD=${PDY}
        export HH=${cyc}
        export GRDRESNAME=${grdNAME}
        export COMOUT_WAVE_GRID_${GRDREGION}_${GRDRES}="{{ COM_WAVE_GRID_RES_TMPL }}"
        out_dir_varname="COMOUT_WAVE_GRID_${GRDREGION}_${GRDRES}"
        out_dir=${!out_dir_varname}
        mkdir -p "${out_dir}"
    done
else
    echo "Both wavepostGRD and waveinterpGRD are empty. No grids to process."
fi

# Execute the Script
"${SCRgfs}/exgfs_wave_post_gridded_sbs.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "ex-script of gridded wave post failed!"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" != "YES" ]]; then
    rm -rf "${DATA}"
fi

exit 0
