#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.anal"
source "${EXPDIR}/config.echgres"



export DO_CALC_ANALYSIS=${DO_CALC_ANALYSIS:-"YES"}

##############################################
# Begin JOB SPECIFIC work
##############################################

export APREFIX="${RUN/enkf/}.t${cyc}z."
export APREFIX_ENS="${RUN}.t${cyc}z."

export RUN=${RUN/enkf/}
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_HISTORY="{{ COM_ATMOS_HISTORY_TMPL }}"
export COMOUT_ATMOS_HISTORY="{{ COM_ATMOS_HISTORY_TMPL }}"

export MEMDIR="mem001"
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_HISTORY_MEM="{{ COM_ATMOS_HISTORY_TMPL }}"

###############################################################
# Run relevant script
${CHGRESFCSTSH:-${SCRgfs}/exgdas_atmos_chgres_forenkf.sh} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
