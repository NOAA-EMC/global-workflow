#! /usr/bin/env bash

source "${HOMEgfs}/ush/jjob_header.sh" -e "oceanice_products" -c "base oceanice_products"

##############################################
# Begin JOB SPECIFIC work
##############################################

# Construct COM variables from templates
if [[ -z "${COMPONENT:-}" ]]; then
    export err=1
    err_exit "COMPONENT variable is not set."
elif [[ "${COMPONENT}" == "ice" ]]; then
    YMD="${PDY}" HH="${cyc}" declare_from_tmpl -rx COMIN_ICE_HISTORY:COM_ICE_HISTORY_TMPL
    YMD="${PDY}" HH="${cyc}" declare_from_tmpl -rx COMOUT_ICE_GRIB:COM_ICE_GRIB_TMPL
    YMD="${PDY}" HH="${cyc}" declare_from_tmpl -rx COMOUT_ICE_NETCDF:COM_ICE_NETCDF_TMPL
elif [[ "${COMPONENT}" == "ocean" ]]; then
    YMD="${PDY}" HH="${cyc}" declare_from_tmpl -rx COMIN_OCEAN_HISTORY:COM_OCEAN_HISTORY_TMPL
    YMD="${PDY}" HH="${cyc}" declare_from_tmpl -rx COMOUT_OCEAN_GRIB:COM_OCEAN_GRIB_TMPL
    YMD="${PDY}" HH="${cyc}" declare_from_tmpl -rx COMOUT_OCEAN_NETCDF:COM_OCEAN_NETCDF_TMPL
else
    export err=1
    err_exit "COMPONENT variable '${COMPONENT}' is invalid. Must be 'ice' or 'ocean'."
fi

###############################################################
# Run exglobal script
"${SCRgfs}/exglobal_oceanice_products.py" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || exit 1
if [[ "${KEEPDATA:-NO}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
