#! /usr/bin/env bash

cat "${HOMEglobal}/ush/jjob_header.sh"

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.wave"
source "${EXPDIR}/config.waveawipsgridded"

source "${USHgfs}/wave_domain_grid.sh"

###################################
# Set COM Paths
###################################

export YMD=${PDY}
export HH=${cyc}
export COMIN_WAVE_GRID="{{ COM_WAVE_GRID_TMPL }}"
export COMOUT_WAVE_WMO="{{ COM_WAVE_WMO_TMPL }}"

mkdir -p "${COMOUT_WAVE_WMO}"

if [[ -n "${GEMPAK_GRIDS}" ]]; then
    for grdID in ${GEMPAK_GRIDS}; do
        process_grdID "${grdID}"
        export YMD=${PDY}
        export HH=${cyc}
        export GRDRESNAME=${grdNAME}
        export COMIN_WAVE_GRID_${GRDREGION}_${GRDRES}="{{ COM_WAVE_GRID_RES_TMPL }}"
    done
else
    echo "GEMPAK_GRIDS are empty. No grids to process."
fi

###################################
# Execute the Script
###################################
"${SCRgfs}/exgfs_wave_prdgen_gridded.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

###################################
# Remove temp directories
###################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" != "YES" ]]; then
    rm -rf "${DATA}"
fi

exit 0
