#! /usr/bin/env bash
set -x

#############################################################################
# UNIX Script Documentation Block
# Script name:         JGLOBAL_FORECAST_MGR
# Script description:  Forecast manager job
#
# Abstract: Runs alongside the UFS model (JGLOBAL_FORECAST) to transfer
#           output products to COM as they are written by the model. Shares
#           the DATAjob umbrella directory with the forecast job and reads
#           product tables from COMOUT_CONF that were written by the forecast
#           job pre-run setup phase.
#
#           Currently manages real-time copy for components that emit per-file
#           sentinel log files (FV3ATM and WW3). Ocean and ice history files
#           are copied at the end of the forecast job by JGLOBAL_FORECAST.
#############################################################################

export DATAjob="${DATAROOT}/${RUN}fcst.${PDY:-}${cyc}"
export DATA="${DATAjob}/mgr.${jobid}"
source "${HOMEglobal}/ush/jjob_header.sh" -e "fcst_mgr" -c "base fcst"

#{# ***NOTE: lines starting with #{ are Jinja templating and will be ignored by Bash.***
#{% if false %}
# When running the workflow in development, source jjob_standard_vars.sh #}
source "${HOMEglobal}/ush/jjob_standard_vars.sh"
#{% else %}
#{# When rendered for operations, place the contents of jjob_var_setup.j2 here #}
#{# Note that the first line of jjob_var_setup.j2 will be commented #}
#{% include jjob_var_setup.j2 %}
#{% endif %}

source "${USHglobal}/jjob_shell_setup.sh"
source "${USHglobal}/set_strict.sh"

PYTHONPATH="${HOMEglobal}/ush/python${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH

# The manager shares DATAjob with the forecast job; DATAoutput is created
# by the forecast job before the model is launched.
export DATArestart="${DATAjob}/restart"
export DATAoutput="${DATAjob}/output"

##############################################
# Construct COM variables (mirrors JGLOBAL_FORECAST)
##############################################

rCDUMP="${RUN/gfs/gdas}"
export rCDUMP="${rCDUMP/gcafs/gcdas}"

# shellcheck disable=SC2309
if [[ 10#${ENSMEM:--1} -ge 0 ]]; then
    memdir=$(printf "mem%03i" $((10#${ENSMEM})))
    declare -rx COMIN="${ROTDIR}/${RUN}.${PDY}/${cyc}/${memdir}"
    declare -rx COMOUT="${ROTDIR}/${RUN}.${PDY}/${cyc}/${memdir}"
else
    declare -rx COMIN="${ROTDIR}/${RUN}.${PDY}/${cyc}"
    declare -rx COMOUT="${ROTDIR}/${RUN}.${PDY}/${cyc}"
fi

declare -rx COMOUT_CONF="${COMOUT}/conf"
declare -rx COMOUT_ATMOS_HISTORY="${COMOUT}/model/atmos/history"
declare -rx COMOUT_ATMOS_MASTER="${COMOUT}/model/atmos/master"

if [[ "${DO_WAVE}" == "YES" ]]; then
    declare -rx COMOUT_WAVE_HISTORY="${COMOUT}/model/wave/history"
fi

##############################################
# Begin JOB SPECIFIC work
##############################################

# Load manager functions
source "${USHglobal}/forecast_mgr.sh"

# Wait for the ATM product table to arrive in COM_CONF. The forecast job
# writes this during its pre-run setup phase (FV3_postdet), which occurs
# before the model executable is launched.
MGR_INIT_TIMEOUT="${FCST_MGR_INIT_TIMEOUT:-7200}"
ATM_TABLE="${COMOUT_CONF}/atm_products.txt"
elapsed=0
echo "INFO: Waiting for ATM product table at ${ATM_TABLE}"
while [[ ! -f "${ATM_TABLE}" ]]; do
    if [[ ${elapsed} -ge ${MGR_INIT_TIMEOUT} ]]; then
        err_exit "Timed out after ${elapsed}s waiting for ${ATM_TABLE}"
    fi
    sleep 30
    (( elapsed += 30 )) || true
done
echo "INFO: ATM product table found after ${elapsed}s"

# Launch component managers as background processes so they run concurrently
mgr_pids=()

fcst_mgr_wait_and_copy "${ATM_TABLE}" "atm" &
mgr_pids+=($!)

if [[ "${DO_WAVE}" == "YES" ]]; then
    WW3_TABLE="${COMOUT_CONF}/ww3_products.txt"
    elapsed=0
    echo "INFO: Waiting for WW3 product table at ${WW3_TABLE}"
    while [[ ! -f "${WW3_TABLE}" ]]; do
        if [[ ${elapsed} -ge ${MGR_INIT_TIMEOUT} ]]; then
            err_exit "Timed out after ${elapsed}s waiting for ${WW3_TABLE}"
        fi
        sleep 30
        (( elapsed += 30 )) || true
    done
    echo "INFO: WW3 product table found after ${elapsed}s"
    fcst_mgr_wait_and_copy "${WW3_TABLE}" "ww3" &
    mgr_pids+=($!)
fi

# Wait for all manager processes and collect errors
manager_err=0
for pid in "${mgr_pids[@]}"; do
    wait "${pid}" || manager_err=$?
done

if [[ ${manager_err} -ne 0 ]]; then
    err_exit "One or more forecast manager processes failed (last err=${manager_err})"
fi

##############################################
# End JOB SPECIFIC work
##############################################

if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
