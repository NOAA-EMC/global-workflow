#! /usr/bin/env bash
set -x

#############################################################################
# UNIX Script Documentation Block
# Script name:         JGLOBAL_FORECAST_MGR
# Script description:  Forecast manager job
#
# Abstract: Runs alongside the UFS model (JGLOBAL_FORECAST) to transfer
#           output products to COM as they are written by the model. Shares
#           the DATAjob umbrella directory with the forecast job and reads
#           product tables from COMOUT_CONF that were written by the forecast
#           job pre-run setup phase.
#
#           Currently manages real-time copy for components that emit per-file
#           sentinel log files (FV3ATM and WW3). Ocean and ice history files
#           are copied at the end of the forecast job by JGLOBAL_FORECAST.
#############################################################################

export DATAjob="${DATAROOT}/${RUN}fcst.${PDY:-}${cyc}"
export DATA="${DATAjob}/mgr.${jobid}"
source "${HOMEglobal}/ush/jjob_header.sh" -e "fcst_mgr" -c "base fcst"

#{# ***NOTE: lines starting with #{ are Jinja templating and will be ignored by Bash.***
#{% if false %}
# When running the workflow in development, source jjob_standard_vars.sh #}
source "${HOMEglobal}/ush/jjob_standard_vars.sh"
#{% else %}
#{# When rendered for operations, place the contents of jjob_var_setup.j2 here #}
#{# Note that the first line of jjob_var_setup.j2 will be commented #}
#{% include jjob_var_setup.j2 %}
#{% endif %}

source "${USHglobal}/jjob_shell_setup.sh"
source "${USHglobal}/set_strict.sh"

PYTHONPATH="${HOMEglobal}/ush/python${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH

# The manager shares DATAjob with the forecast job; DATAoutput is created
# by the forecast job before the model is launched.
export DATArestart="${DATAjob}/restart"
export DATAoutput="${DATAjob}/output"

##############################################
# Construct COM variables (mirrors JGLOBAL_FORECAST)
##############################################

rCDUMP="${RUN/gfs/gdas}"
export rCDUMP="${rCDUMP/gcafs/gcdas}"

# shellcheck disable=SC2309
if [[ 10#${ENSMEM:--1} -ge 0 ]]; then
    memdir=$(printf "mem%03i" $((10#${ENSMEM})))
    declare -rx COMIN="${ROTDIR}/${RUN}.${PDY}/${cyc}/${memdir}"
    declare -rx COMOUT="${ROTDIR}/${RUN}.${PDY}/${cyc}/${memdir}"
else
    declare -rx COMIN="${ROTDIR}/${RUN}.${PDY}/${cyc}"
    declare -rx COMOUT="${ROTDIR}/${RUN}.${PDY}/${cyc}"
fi

declare -rx COMOUT_CONF="${COMOUT}/conf"
declare -rx COMOUT_ATMOS_HISTORY="${COMOUT}/model/atmos/history"
declare -rx COMOUT_ATMOS_MASTER="${COMOUT}/model/atmos/master"

if [[ "${DO_WAVE}" == "YES" ]]; then
    declare -rx COMOUT_WAVE_HISTORY="${COMOUT}/model/wave/history"
fi

if [[ "${DO_OCN:-NO}" == "YES" ]]; then
    declare -rx COMOUT_OCEAN_HISTORY="${COMOUT}/model/ocean/history"
fi

if [[ "${DO_ICE:-NO}" == "YES" ]]; then
    declare -rx COMOUT_ICE_HISTORY="${COMOUT}/model/ice/history"
fi

##############################################
# Begin JOB SPECIFIC work
##############################################

# Wait for a product table to appear in COMOUT_CONF; used for each component.
# Arguments: <label> <table_path> <timeout_seconds>
wait_for_table() {
    local label="$1" table="$2" timeout="$3"
    local elapsed=0
    echo "INFO: Waiting for ${label} product table at ${table}"
    while [[ ! -f "${table}" ]]; do
        if [[ ${elapsed} -ge ${timeout} ]]; then
            err_exit "Timed out after ${elapsed}s waiting for ${table}"
        fi
        sleep 30
        (( elapsed += 30 )) || true
    done
    echo "INFO: ${label} product table found after ${elapsed}s"
}

MGR_INIT_TIMEOUT="${FCST_MGR_INIT_TIMEOUT:-7200}"

# Collect active component tables in order: ATM, WW3, OCN, ICE.
# Each active component gets one MPMD rank; the wrapper script sources
# forecast_mgr.sh and calls fcst_mgr_wait_and_copy for that component.
declare -a mgr_components mgr_tables
mgr_rank=0

ATM_TABLE="${COMOUT_CONF}/atm_products.txt"
wait_for_table "ATM" "${ATM_TABLE}" "${MGR_INIT_TIMEOUT}"
mgr_components[mgr_rank]="atm"
mgr_tables[mgr_rank]="${ATM_TABLE}"
(( mgr_rank++ )) || true

if [[ "${DO_WAVE}" == "YES" ]]; then
    WW3_TABLE="${COMOUT_CONF}/ww3_products.txt"
    wait_for_table "WW3" "${WW3_TABLE}" "${MGR_INIT_TIMEOUT}"
    mgr_components[mgr_rank]="ww3"
    mgr_tables[mgr_rank]="${WW3_TABLE}"
    (( mgr_rank++ )) || true
fi

if [[ "${DO_OCN:-NO}" == "YES" && -f "${COMOUT_CONF}/ocn_products.txt" ]]; then
    OCN_TABLE="${COMOUT_CONF}/ocn_products.txt"
    mgr_components[mgr_rank]="ocn"
    mgr_tables[mgr_rank]="${OCN_TABLE}"
    (( mgr_rank++ )) || true
    echo "INFO: OCN product table found; adding OCN manager rank"
fi

if [[ "${DO_ICE:-NO}" == "YES" && -f "${COMOUT_CONF}/ice_products.txt" ]]; then
    ICE_TABLE="${COMOUT_CONF}/ice_products.txt"
    mgr_components[mgr_rank]="ice"
    mgr_tables[mgr_rank]="${ICE_TABLE}"
    (( mgr_rank++ )) || true
    echo "INFO: ICE product table found; adding ICE manager rank"
fi

num_ranks=${mgr_rank}
echo "INFO: Launching ${num_ranks} MPMD component manager rank(s): ${mgr_components[*]}"

# Build the MPMD configuration file: one rank per component.
MPMD_CONF="${DATA}/fcst_mgr_mpmd.conf"
rm -f "${MPMD_CONF}"
for (( r = 0; r < num_ranks; r++ )); do
    echo "${r} ${USHglobal}/fcst_mgr_component.sh ${mgr_components[r]} ${mgr_tables[r]}" >> "${MPMD_CONF}"
done

# Run all component managers concurrently, each on its own SLURM task.
export USHglobal COMOUT_CONF COMOUT_ATMOS_HISTORY COMOUT_ATMOS_MASTER
[[ "${DO_WAVE}" == "YES" ]] && export COMOUT_WAVE_HISTORY
[[ "${DO_OCN:-NO}" == "YES" ]] && export COMOUT_OCEAN_HISTORY
[[ "${DO_ICE:-NO}" == "YES" ]] && export COMOUT_ICE_HISTORY

srun --ntasks="${num_ranks}" --multi-prog "${MPMD_CONF}"
manager_err=$?

if [[ ${manager_err} -ne 0 ]]; then
    err_exit "One or more forecast manager MPMD ranks failed (err=${manager_err})"
fi

##############################################
# End JOB SPECIFIC work
##############################################

if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
