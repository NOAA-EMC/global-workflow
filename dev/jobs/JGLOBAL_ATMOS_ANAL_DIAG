#! /usr/bin/env bash
set -x
export EXPDIR="${EXPDIR:-${HOMEglobal}/parm/config/${NET}}"
source "${HOMEglobal}/ush/jjob_header.sh" -e "analdiag" -c "base anal analdiag"

#{% if false %}
source "${HOMEglobal}/ush/jjob_standard_vars.sh"
#{% else %}
#{% include jjob_var_setup.j2 %}
#{% endif %}

source "${USHglobal}/jjob_shell_setup.sh"
# Set strict mode which will exit on error or undefined variable
# and exit on error in a pipeline (e.g. if a command in "cmd | cmd2" fails)
source "${USHglobal}/set_strict.sh"

##############################################
# Set variables used in the script
##############################################
declare -rx COMIN=${COMIN:-${ROTDIR}}
declare -rx COMOUT=${COMOUT:-${ROTDIR}}
declare -rx COMIN_ATMOS_ANALYSIS="${COMIN}/${RUN}.${PDY}/${cyc}/analysis/atmos"
declare -rx COMOUT_ATMOS_ANALYSIS="${COMOUT}/${RUN}.${PDY}/${cyc}/analysis/atmos"

mkdir -m 775 -p "${COMOUT_ATMOS_ANALYSIS}"

# Create a DATAROOT directory variable where the gsidiags live
# shellcheck disable=SC2153,SC2311
pCOMIN_ATMOS_ANALYSIS="$(dataroot_com_path "${COMIN_ATMOS_ANALYSIS}")"
export pCOMIN_ATMOS_ANALYSIS

###############################################################
# Run relevant script
${ANALDIAGSH:-${SCRglobal}/exglobal_atmos_diag.sh} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "Failed to generate GSI diagnostics from the atmospheric analysis"
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
