#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh
source "${EXPDIR}/config.base"
source "${EXPDIR}/config.arch_tars"
source "${EXPDIR}/config.earc_tars"
source "${EXPDIR}/config.earc_groups"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

export MEMDIR="ensstat"
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_ANALYSIS_ENSSTAT="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMIN_ATMOS_HISTORY_ENSSTAT="{{ COM_ATMOS_HISTORY_TMPL }}"
export COMIN_ICE_ANALYSIS_ENSSTAT="{{ COM_ICE_ANALYSIS_TMPL }}"
export COMIN_OCEAN_ANALYSIS_ENSSTAT="{{ COM_OCEAN_ANALYSIS_TMPL }}"
export COMIN_SNOW_ANALYSIS_ENSSTAT="{{ COM_SNOW_ANALYSIS_TMPL }}"
export COMIN_CONF="{{ COM_CONF_TMPL }}"

export RUN=${RUN/enkf/}
export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_HISTORY="{{ COM_ATMOS_HISTORY_TMPL }}"

mkdir -p "${COMIN_CONF}"

###############################################################
# Run archive script
###############################################################

# Calls an external bash command; do not fail on unassigned/error
export -n SHELLOPTS
unset_strict
"${SCRgfs}/exglobal_enkf_earc_tars.py"
export err=$?
set_strict
if [[ ${err} -ne 0 ]]; then
    err_exit "Failed to archive the ensemble COM structure"
fi

###############################################################

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
