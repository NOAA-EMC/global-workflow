#! /usr/bin/env bash

export DATA=${DATA:-${DATAROOT}/${RUN}atmanl_${cyc}}
source "${HOMEgfs}/ush/jjob_header.sh" -e "atmanlinit"

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.atmanl"
source "${EXPDIR}/config.atmanlinit"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
gPDY=${GDATE:0:8}
gcyc=${GDATE:8:2}
GDUMP="gdas"

##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates
export YMD=${PDY}
export HH=${cyc}
export COMIN_OBS="{{ COM_OBS_TMPL }}"

RUN=${GDUMP} YMD=${gPDY} HH=${gcyc}
export COMIN_ATMOS_ANALYSIS_PREV="{{ COM_ATMOS_ANALYSIS_TMPL }}"
export COMIN_ATMOS_HISTORY_PREV="{{ COM_ATMOS_HISTORY_TMPL }}"
export RUN=${RUN} YMD=${PDY} HH=${cyc}

###############################################################
# Run relevant script

EXSCRIPT=${GDASATMINITPY:-${SCRgfs}/exglobal_atm_analysis_initialize.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

exit 0
