#! /usr/bin/env bash

# TODO (#1227) This job is not used in the rocoto suite

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.post"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

####################################
# Specify NET and RUN Name and model
####################################
export NET=${NET:-gfs}
export RUN=${RUN:-gfs}

###########################
# Set up EXT variable
###########################
export EXT_FCST=NO

export YMD=${PDY}
export HH=${cyc}
export COMIN_ATMOS_HISTORY="{{ COM_ATMOS_HISTORY_TMPL }}"

########################################################
# Execute the script.
"${SCRgfs}/exglobal_atmos_pmgr.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi
########################################################
