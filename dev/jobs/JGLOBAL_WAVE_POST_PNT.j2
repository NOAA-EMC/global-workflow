#! /usr/bin/env bash

cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.wave"
source "${EXPDIR}/config.wavepostsbs"
source "${EXPDIR}/config.wavepostpnt"



export MP_PULSE=0

# Set COM Paths
export YMD=${PDY}
export HH=${cyc}
export COMIN_WAVE_PREP="{{ COM_WAVE_PREP_TMPL }}"
export COMIN_WAVE_HISTORY="{{ COM_WAVE_HISTORY_TMPL }}"
export COMOUT_WAVE_STATION="{{ COM_WAVE_STATION_TMPL }}"

mkdir -p "${COMOUT_WAVE_STATION}"

export CFP_VERBOSE=1

export FHMAX_WAV_PNT=$((FHMAX_WAV - OFFSET_START_HOUR))
export DOSPC_WAV='YES'   # Spectral post
export DOBLL_WAV='YES'   # Bulletin post
export DOBNDPNT_WAV='NO' #not boundary points

# Execute the Script
"${SCRgfs}/exgfs_wave_post_pnt.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "ex-script of JGLOBAL_WAVE_POST_PNT failed!"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
