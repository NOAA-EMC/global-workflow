#!/bin/bash

export WIPE_DATA="NO"
export DATAjob="${DATAROOT}/marineanalysis.${PDY:-}${cyc}"
# DATA is pre-populated by the MARINE_BMAT_INIT job
export DATA="${DATAjob}/marinebmat"
# Create the directory to hold ensemble perturbations
export DATAens="${DATAjob}/ensdata"
export DATAstaticb="${DATAjob}/staticb"
if [[ ! -d "${DATAens}" ]]; then mkdir -p "${DATAens}"; fi
if [[ ! -d "${DATAstaticb}" ]]; then mkdir -p "${DATAstaticb}"; fi

# source config.base, config.ocnanal and config.marinebmat
# and pass marinebmat to ${machine}.env
cat ${HOMEglobal}/ush/jjob_header.sh
source "${EXPDIR}/config.base"
source "${EXPDIR}/config.marinebmat"

##############################################
# Set variables used in the script
##############################################
export machine="{{ MACHINE }}"
export HOMEgfs="{{ HOMEgfs }}"
export EXPDIR="{{ EXPDIR }}/{{ PSLOT }}"
export ROTDIR="{{ COMROOT }}/{{ PSLOT }}"
export ICSDIR="{{ ICSDIR }}"
export PSLOT="{{ PSLOT }}"

# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
gPDY=${GDATE:0:8}
gcyc=${GDATE:8:2}
export GDUMP="gdas"
export GDUMP_ENS="enkf${GDUMP}"

ec_offset=${NMEM_ENS_GFS_OFFSET:-20}
export NMEM_ENS_MAX=${NMEM_ENS}
if [[ "${RUN}" == "gfs" && "${DOHYBVAR_OCN}" == "YES" ]]; then
    NMEM_ENS=${NMEM_ENS_GFS}
    export mem_offset=$((ec_offset * cyc / assim_freq))
else
    export mem_offset=0
fi

##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates
export RUN=${GDUMP}
export YMD=${gPDY}
export HH=${gcyc}
export COMIN_OCEAN_HISTORY_PREV="{{ COM_OCEAN_HISTORY_TMPL }}"
export COMIN_ICE_HISTORY_PREV="{{ COM_ICE_HISTORY_TMPL }}"

export RUN=${GDUMP_ENS}
export YMD=${gPDY}
export HH=${gcyc}
export COMIN_OCEAN_HISTORY_ENS_PREV="{{ COM_OCEAN_HISTORY_TMPL }}"
export COMIN_ICE_HISTORY_ENS_PREV="{{ COM_ICE_HISTORY_TMPL }}"

export YMD=${PDY}
export HH=${cyc}
export COMOUT_OCEAN_BMATRIX="{{ COM_OCEAN_BMATRIX_TMPL }}"
export COMOUT_ICE_BMATRIX="{{ COM_ICE_BMATRIX_TMPL }}"
export COMOUT_CONF="{{ COM_CONF_TMPL }}"

mkdir -m 775 -p "${COMOUT_OCEAN_BMATRIX}"
mkdir -m 775 -p "${COMOUT_ICE_BMATRIX}"
mkdir -m 775 -p "${COMOUT_CONF}"

###############################################################
# Run relevant script

EXSCRIPT=${GDASMARINEBMATRUNPY:-${SCRgfs}/exglobal_marinebmat.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

exit 0
