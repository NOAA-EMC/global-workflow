#! /usr/bin/env bash

export WIPE_DATA="NO"
export DATA=${DATA:-${DATAROOT}/${RUN}aeroanl_${cyc}}
cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.aeroanl"
source "${EXPDIR}/config.aeroanlfinal"



##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates
export YMD=${PDY}
export HH=${cyc}
export COMOUT_CHEM_ANALYSIS="{{ COM_CHEM_ANALYSIS_TMPL }}"
export COMOUT_CONF="{{ COM_CONF_TMPL }}"
export COMOUT_ATMOS_RESTART="{{ COM_ATMOS_RESTART_TMPL }}"

mkdir -m 755 -p "${COMOUT_CHEM_ANALYSIS}"
mkdir -m 755 -p "${COMOUT_ATMOS_RESTART}"
mkdir -m 755 -p "${COMOUT_CONF}"

###############################################################
# Run relevant script

EXSCRIPT=${GDASAEROFINALPY:-${SCRgfs}/exglobal_aero_analysis_finalize.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi

exit 0
