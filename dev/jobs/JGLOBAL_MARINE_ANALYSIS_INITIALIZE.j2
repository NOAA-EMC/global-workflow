#!/bin/bash

export DATAjob="${DATAROOT}/marineanalysis.${PDY:-}${cyc}"
export DATAens="${DATAjob}/ensdata"
export DATA="${DATAjob}/marineanlvar"
cat ${HOMEglobal}/ush/jjob_header.sh

source "${EXPDIR}/config.base"
source "${EXPDIR}/config.marineanl"
source "${EXPDIR}/config.marineanlinit"



# Ignore possible spelling error (nothing is misspelled)
# shellcheck disable=SC2153
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
gPDY=${GDATE:0:8}
gcyc=${GDATE:8:2}
export GDUMP=${GDUMP:-"gdas"}

##############################################
# Begin JOB SPECIFIC work
##############################################

# Generate COM variables from templates
export YMD=${PDY}
export HH=${cyc}
export COMIN_OBS="{{ COM_OBS_TMPL }}"

RUN=${GDUMP} YMD=${gPDY} HH=${gcyc}
export COMIN_OCEAN_HISTORY_PREV="{{ COM_OCEAN_HISTORY_TMPL }}"
export COMIN_ICE_HISTORY_PREV="{{ COM_ICE_HISTORY_TMPL }}"
export COMIN_ICE_RESTART_PREV="{{ COM_ICE_RESTART_TMPL }}"
export RUN=${RUN} YMD=${PDY} HH=${cyc}

export YMD=${PDY}
export HH=${cyc}
export COMIN_OCEAN_BMATRIX="{{ COM_OCEAN_BMATRIX_TMPL }}"
export COMIN_ICE_BMATRIX="{{ COM_ICE_BMATRIX_TMPL }}"

###############################################################
# Run relevant script

EXSCRIPT=${GDASMARINEANALYSIS:-${SCRgfs}/exglobal_marine_analysis_initialize.py}
${EXSCRIPT} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##############################################
# End JOB SPECIFIC work
##############################################

##############################################
# Final processing
##############################################
if [[ -e "${pgmout}" ]]; then
    cat "${pgmout}"
fi

exit 0
