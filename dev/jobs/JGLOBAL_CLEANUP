#! /usr/bin/env bash
set -x
export EXPDIR="${EXPDIR:-${HOMEglobal}/parm/config/${NET}}"
source "${HOMEglobal}/ush/jjob_header.sh" -e "cleanup" -c "base cleanup"

#{% if false %}
source "${HOMEglobal}/ush/jjob_standard_vars.sh"
#{% else %}
#{% include jjob_var_setup.j2 %}
#{% endif %}

source "${USHglobal}/jjob_shell_setup.sh"
# Set strict mode which will exit on error or undefined variable
# and exit on error in a pipeline (e.g. if a command in "cmd | cmd2" fails)
source "${USHglobal}/set_strict.sh"

# Additional variables are set in scripts/exglobal_cleanup.sh in order to loop over the previous
# cycles being cleaned up:
#  COMOUT_TOP

"${SCRglobal}/exglobal_cleanup.sh" && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "Failed to complete cleanup"
fi

#################################################
# Remove the Temporary working directory DATAROOT
# In XML, DATAROOT is defined as:
# DATAROOT="${STMP}/RUNDIRS/${PSLOT}/${RUN}.${PDY}${cyc}"
# cleanup is only executed after the entire cycle is successfully completed.
# Removing DATAROOT should be possible if that is the case.

# Honor KEEPDATA like every other job so run directories can be retained for
# debugging. (DEBUG bug/gfsv17-ocean_logs: with KEEPDATA=YES the forecast rundirs
# under DATAROOT are preserved instead of being removed at end of cycle.)
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATAROOT}"
    echo "Cleanup ${DATAROOT} completed!"
else
    echo "KEEPDATA=${KEEPDATA}: retaining ${DATAROOT} for debugging"
fi

exit 0
