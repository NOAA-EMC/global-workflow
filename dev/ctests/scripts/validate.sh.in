#!/usr/bin/env bash
set -ux

CASE_NAME=${1:?"Name of the case is required"}
TEST_NAME=${2:?"Name of the test is required"}
TEST_DATE=${3:?"idate of the test is required"}

# CMake to fill these variables
CTESTS_STAGED_TESTS_DIR="@CTESTS_STAGED_TESTS_DIR@"
RUNTESTS="@RUNTESTS@"
HOMEgfs="@PROJECT_SOURCE_DIR@"

# Load the runtime environment for this script (needs wxflow and its dependencies)
set +x
source "${HOMEgfs}/dev/ush/gw_setup.sh"
rc=$?
if [[ "${rc}" -ne 0 ]]; then
   exit "${rc}"
fi
set -x
PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${HOMEgfs}/sorc/wxflow/src"
export PYTHONPATH

YAML_FILE="${HOMEgfs}/dev/ctests/cases/${TEST_NAME}.yaml"

# Find pslot with pattern CASE_NAME_<suffix> where suffix could be a date or anything else
# We don't use ci_utils.sh at all to reduce dependencies
if [[ ! -d "${CTESTS_STAGED_TESTS_DIR}/EXPDIR" ]]; then
  echo "ERROR: ${CTESTS_STAGED_TESTS_DIR}/EXPDIR directory not found"
  exit 1
fi

# First try to find directories matching the date pattern CASE_NAME_MMDDYY
# find uses glob patterns, not regex, so we need to use [0-9][0-9][0-9][0-9][0-9][0-9]
PSLOT_DIR=$(find "${CTESTS_STAGED_TESTS_DIR}/EXPDIR" -maxdepth 1 -type d -name "${CASE_NAME}_[0-9][0-9][0-9][0-9][0-9][0-9]" -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)

# If no date pattern match, try any suffix
if [[ -z "${PSLOT_DIR}" ]]; then
  PSLOT_DIR=$(find "${CTESTS_STAGED_TESTS_DIR}/EXPDIR" -maxdepth 1 -type d -name "${CASE_NAME}_*" -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)
fi

# If still no match, list available directories to help with debugging
if [[ -z "${PSLOT_DIR}" ]]; then
  echo "ERROR: Could not find any directory matching pattern ${CASE_NAME}_* in ${CTESTS_STAGED_TESTS_DIR}" "${CASE_NAME}")"
echo "validating '${TEST_NAME}' with yaml file '${YAML_FILE}'"

PSLOT="${PSLOT}" \
TEST_NAME="${TEST_NAME}" \
RUNTESTS="${RUNTESTS}" \
CTESTS_STAGED_TESTS_DIR="${CTESTS_STAGED_TESTS_DIR}" \
"${HOMEgfs}/dev/ctests/scripts/validate.py" --yaml "${YAML_FILE}"  --test_date "${TEST_DATE}"
rc=$?
if [[ "${rc}" -ne 0 ]]; then
    set +x
    echo "Failed to validate for '${TEST_NAME}' with '${YAML_FILE}'"
    set -x
    exit "${rc}"
fi

exit 0
