#!/bin/bash

source HOMEgfs/dev/ush/load_gw_run_modules.sh

module load wgrib2/3.6.0

arg=$@

new_arg=""
has_ftime=false
has_sets=false

sets=""

# Basic argument parsing using a while loop and case statement
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -set_date)
            sdate=$2
            shift
            ;;
        -set_ftime)
	    has_ftime=true
            ftime="$2 $3 $4"
            shift
            shift
            shift
            ;;
        -set)
            has_sets=true
            sets="$sets -set $2 $3"
            shift
            shift
            ;;
        -grib)
            outfile=$2
            shift
            ;;
        *)
            # echo "Unknown option: $1"
            new_arg="$new_arg $1"
            ;;
    esac
    shift # Consume the option/argument
done

if [[ "$has_ftime" == "true" ]]; then
    echo "new_arg: $new_arg"
    if [[ "$has_sets" == "true" ]]; then
        wgrib2 $new_arg -set_date "$sdate" -set_ftime "$ftime" $sets -grib $outfile
    else
        wgrib2 $new_arg -set_date "$sdate" -set_ftime "$ftime" -grib $outfile
    fi
else
    wgrib2 $arg
fi

