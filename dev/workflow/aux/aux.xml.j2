<metatask name="gfs_metp" mode="parallel">

	<var name="metpcase">g2g1 g2o1 pcp1</var>

	<task name="gfs_metp#metpcase#" cycledefs="metp" maxtries="&MAXTRIES;">

		<command>&HOME_repo;/dev/job_cards/rocoto/metp.sh</command>

		<jobname><cyclestr>&PSLOT;_gfs_metp#metpcase#_@H</cyclestr></jobname>
		<account>GFS-DEV</account>
		<queue>dev</queue>
		<walltime>06:00:00</walltime>
		<nodes>1:ppn=1:tpp=1</nodes>
		<memory>80G</memory>
		<native>-l place=vscatter:shared</native>

		<join><cyclestr>&COM_aux;/logs/@Y@m@d@H/gfs_metp#metpcase#.log</cyclestr></join>

		<envar><name>RUN_ENVIR</name><value>emc</value></envar>
		<envar><name>HOMEglobal</name><value>&HOME_repo;</value></envar>
		<envar><name>EXPDIR</name><value>&EXP_aux;</value></envar>
		<envar><name>NET</name><value>gfs</value></envar>
		<envar><name>RUN</name><value>gfs</value></envar>
		<envar><name>PDY</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
		<envar><name>cyc</name><value><cyclestr>@H</cyclestr></value></envar>
		<envar><name>COMROOT</name><value>&COM_aux;</value></envar>
		<envar><name>DATAROOT</name><value>&DATAROOT_aux;/gfs.<cyclestr>@Y@m@d@H</cyclestr></value></envar>
		<envar><name>EDATE_GFS</name><value>2030010100</value></envar>
		<envar><name>METPCASE</name><value>#metpcase#</value></envar>
    <envar><name>ARCDIR</name><value>&ARCDIR;</value></envar>
    <envar><name>PSLOT</name><value>&PSLOT;</value></envar>

		<dependency>
			<or>
				<taskdep task="gfs_arch_vrfy"/>
				<and>
					<not><taskvalid task="gfs_arch_vrfy"/></not>
					<taskdep task="gfs_arch_vrfy" cycle_offset="-18:00:00"/>
					<not><cycleexistdep cycle_offset="-6:00:00"/></not>
					<not><cycleexistdep cycle_offset="-12:00:00"/></not>
				</and>
			</or>
		</dependency>

	</task>

</metatask>

