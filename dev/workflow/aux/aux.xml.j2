<?xml version="1.0"?>
<!DOCTYPE workflow
[
	<!--
	PROGRAM
		Auxiliary workflow manager for Global Forecast System
		Variables:
		PSLOT: The name of this auxiliary system (used for offline archiving and verification)
		MAXTRIES: How many times to run a job
		HOME_repo: Where the official repository is located
		EXP_aux: Where the expdir for this auxiliary system lives (can be the same as GFS)
		ECF_OUT_gfs: The GFS ecflow output directory; used as triggers
		DATAROOT_aux: DATAROOT for this auxiliary system
		COM_aux: The auxiliary COM directory (ONLY set this to COM_gfs when going live, not for testing)
	-->
	<!ENTITY PSLOT "{{ PSLOT }}">
	<!ENTITY MAXTRIES "1">
	<!ENTITY HOME_repo "{{ HOMEglobal }}">
	<!ENTITY EXP_aux "{{ EXP_aux }}">
	<!ENTITY ECF_OUT_gfs "{{ ECF_OUT_gfs }}">
	<!ENTITY COM_aux "{{ COM_aux }}">
	<!ENTITY DATAROOT_aux "{{ DATAROOT_aux }}">
	<!ENTITY ARCDIR "{{ ARCDIR }}">
	<!ENTITY ATARDIR "{{ ATARDIR }}">

]>

<workflow realtime="F" scheduler="pbspro" cyclethrottle="1" taskthrottle="25">

	<log verbosity="10"><cyclestr>&EXP_aux;/logs/@Y@m@d@H.log</cyclestr></log>

	<!-- Define the cycles -->
	<cycledef group="gdas">{{ start_date }} {{ end_date }} 06:00:00</cycledef>
	<cycledef group="gfs">{{ start_date }} {{ end_date }} 06:00:00</cycledef>
	<cycledef group="metp">{{ start_date_metp }} {{ end_date_metp }} 24:00:00</cycledef>

<task name="gfs_tracker" cycledefs="gfs" maxtries="&MAXTRIES;">

	<command>&HOME_repo;/dev/job_cards/rocoto/tracker.sh</command>

	<jobname><cyclestr>&PSLOT;_gfs_tracker_@H</cyclestr></jobname>
	<account>GFS-DEV</account>
	<queue>dev</queue>
	<walltime>00:10:00</walltime>
	<nodes>1:ppn=1:tpp=1</nodes>
	<memory>6G</memory>
	<native>-l place=vscatter:shared</native>

	<join><cyclestr>&COM_aux;/logs/@Y@m@d@H/gfs_tracker.log</cyclestr></join>

	<envar><name>RUN_ENVIR</name><value>emc</value></envar>
	<envar><name>HOMEglobal</name><value>&HOME_repo;</value></envar>
	<envar><name>EXPDIR</name><value>&EXP_aux;</value></envar>
	<envar><name>NET</name><value>gfs</value></envar>
	<envar><name>RUN</name><value>gfs</value></envar>
	<envar><name>PDY</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
	<envar><name>cyc</name><value><cyclestr>@H</cyclestr></value></envar>
	<envar><name>COMROOT</name><value>&COM_aux;</value></envar>
	<envar><name>DATAROOT</name><value>&DATAROOT_aux;/gfs.<cyclestr>@Y@m@d@H</cyclestr></value></envar>

	<dependency>
		<datadep><cyclestr offset="06:00:00">&ECF_OUT_gfs;/@Y@m@d@H</cyclestr></datadep>
	</dependency>

</task>

