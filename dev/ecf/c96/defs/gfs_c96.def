              edit RJN 'prep'
              trigger :TIME >= 0300 and :TIME < 0630
              event 1 release_gdas_marine_prepoceanobs
            task jgdas_marine_prepoceanobs
              trigger ../../../../12/gdas/forecast/jgdas_fcst==complete and jgdas_marine_prep_fsm:release_gdas_marine_prepoceanobs
          endfamily		//marine
        endfamily		//prep
        family init
