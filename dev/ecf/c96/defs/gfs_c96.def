suite gfs_c96
  family primary
    edit gfs_ver 'v17.0'
    edit PACKAGEHOME '/lfs/h3/emc/eib/noscrub/%EMC_USER%/gfs/para/packages/gfs.%gfs_ver%'
    edit NET 'gfs'
    edit RUN 'gfs'
    edit PROJ 'GFS'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'development'
    edit ENVIR 'prod'
    edit QUEUE 'devhigh'
    edit QUEUE_ARCH 'dev_transfer'
    edit OUTPUTDIR '/lfs/h3/emc/eib/noscrub/ptmp/%EMC_USER%/ecflow_gfs/para/output/prod/today'
    family 12
      edit CYC '12'
      edit ECF_FILES '%PACKAGEHOME%/dev/ecf/c96/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_prep_fsm
              edit RJN 'prep'
              trigger :TIME >= 1500 and :TIME < 1830
              event 1 release_gfs_atmos_prep
            task jgfs_atmos_prep
              trigger jgfs_atmos_prep_fsm:release_gfs_atmos_prep
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_prep_fsm
              edit RJN 'prep'
              trigger :TIME >= 1500 and :TIME < 1830
              event 1 release_gfs_marine_prepoceanobs
            task jgfs_marine_prepoceanobs
              trigger jgfs_marine_prep_fsm:release_gfs_marine_prepoceanobs
          endfamily		//marine
        endfamily		//prep
        family init
          family marine
            edit WGF 'marine'
            task jgfs_marine_bmat_init
              trigger ../../prep/marine/jgfs_marine_prepoceanobs==complete
            task jgfs_marine_bmat
              trigger jgfs_marine_bmat_init==complete
            task jgfs_marine_anal_init
              trigger jgfs_marine_bmat==complete and ../../prep/marine/jgfs_marine_prepoceanobs==complete
          endfamily		//marine
          family wave
            edit WGF 'wave'
            task jgfs_wave_init
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
          endfamily		//wave
        endfamily		//init
        family analysis
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_anal
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
            task jgfs_atmos_anal_sfc_gcycle
              trigger jgfs_atmos_anal==complete and ../snow/jgfs_atmos_analsnow==complete
            task jgfs_atmos_anal_calc
              trigger jgfs_atmos_anal_sfc_gcycle==complete
            task jgfs_atmos_analupp
              trigger jgfs_atmos_anal_calc==complete
            task jgfs_atmos_analprod
              trigger ../../forecast/jgfs_fcst_fsm:release_gfs_atmos_product_f000
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_analvar
              trigger ../../init/marine/jgfs_marine_anal_init==complete
            task jgfs_marine_analchkpt
              trigger jgfs_marine_analvar==complete
            task jgfs_marine_analfinal
              trigger jgfs_marine_analchkpt==complete
          endfamily		//marine
          family snow
            edit WGF 'snow'
            task jgfs_atmos_analsnow
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
          endfamily		//snow
        endfamily		//analysis
        family forecast
          task jgfs_fcst_fsm
            edit RJN 'forecast'
            trigger jgfs_fcst==active or jgfs_fcst==complete
            event 100 release_gfs_atmos_product_f000
            event 101 release_gfs_atmos_product_f001
