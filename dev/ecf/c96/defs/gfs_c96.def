            edit WGF 'atmos'
            task jgdas_verfozn
              trigger ../../analysis/atmos/jgdas_atmos_analdiag==complete
            task jgdas_verfrad
              trigger ../../analysis/atmos/jgdas_atmos_analdiag==complete
            task jgdas_anlstat
              trigger ../../analysis/atmos/jgdas_atmos_analdiag==complete and ../../analysis/snow/jgdas_atmos_analsnow==complete and ../../analysis/marine/jgdas_marine_analfinal==complete
            task jgdas_vminmon
              trigger ../../analysis/atmos==complete
          endfamily		//atmos
        endfamily		//verf
      endfamily		//gdas
      family enkfgdas
        edit RUN 'enkfgdas'
        edit WGF 'enkf'
        family analysis
          family create
            task jenkfgdas_atmos_ens_observer
              trigger ../../../gdas/prep/atmos/jgdas_atmos_prep==complete and ../../../../12/enkfgdas/ensstat==complete
            task jenkfgdas_snow_anal_ens
              trigger ../../../gdas/prep/atmos/jgdas_atmos_prep==complete and ../../../../12/enkfgdas/ensstat==complete
            task jenkfgdas_atmos_ens_update
              trigger ../recenter/jenkfgdas_atmos_diag_ens==complete
          endfamily		//create
          family recenter
            task jenkfgdas_marine_ens_recenter
              trigger ../../../gdas/init/marine/jgdas_marine_bmat_init==complete
            task jenkfgdas_atmos_diag_ens
              trigger ../create/jenkfgdas_atmos_ens_observer==complete
            task jenkfgdas_atmos_ens_recenter000
              trigger ../create/jenkfgdas_atmos_ens_update==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
              edit FHRGRP '000'
              edit FHRLST '003'
            task jenkfgdas_atmos_ens_recenter001
              trigger ../create/jenkfgdas_atmos_ens_update==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
              edit FHRGRP '001'
              edit FHRLST '006'
            task jenkfgdas_atmos_ens_recenter002
              trigger ../create/jenkfgdas_atmos_ens_update==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
              edit FHRGRP '002'
              edit FHRLST '009'
            task jenkfgdas_change_res_ens
              trigger ../../../gdas/forecast/jgdas_fcst==complete and ../../forecast/jenkfgdas_fcst_mem001==complete
            task jenkfgdas_atmos_ens_anal_sfc_regrid
              trigger ../create/jenkfgdas_atmos_ens_update==complete
            task jenkfgdas_atmos_ens_anal_sfc_gcycle
              trigger ../create/jenkfgdas_snow_anal_ens==complete and ../../../gdas/analysis/atmos/jgdas_atmos_anal_calc==complete
          endfamily		//recenter
        endfamily		//analysis
        family forecast
          trigger analysis/recenter/jenkfgdas_atmos_ens_recenter000==complete and analysis/recenter/jenkfgdas_atmos_ens_recenter001==complete and analysis/recenter/jenkfgdas_atmos_ens_recenter002==complete and analysis/recenter/jenkfgdas_atmos_ens_anal_sfc_gcycle==complete and analysis/recenter/jenkfgdas_marine_ens_recenter==complete
          task jenkfgdas_fcst_mem001
            edit ENSMEM '001'
            edit MEMDIR 'mem001'
          task jenkfgdas_fcst_mem002
            edit ENSMEM '002'
            edit MEMDIR 'mem002'
        endfamily		//forecast
        family ensstat
          trigger forecast==complete
          task jenkfgdas_ens_post000
            edit FHRGRP '000'
            edit FHR '003'
            edit FHRLST 'f003'
          task jenkfgdas_ens_post001
            edit FHRGRP '001'
            edit FHR '004'
            edit FHRLST 'f004'
          task jenkfgdas_ens_post002
            edit FHRGRP '002'
            edit FHR '005'
            edit FHRLST 'f005'
          task jenkfgdas_ens_post003
            edit FHRGRP '003'
            edit FHR '006'
            edit FHRLST 'f006'
          task jenkfgdas_ens_post004
            edit FHRGRP '004'
            edit FHR '007'
            edit FHRLST 'f007'
          task jenkfgdas_ens_post005
            edit FHRGRP '005'
            edit FHR '008'
            edit FHRLST 'f008'
          task jenkfgdas_ens_post006
            edit FHRGRP '006'
            edit FHR '009'
            edit FHRLST 'f009'
        endfamily		//ensstat
      endfamily		//enkfgdas
      task cycle_end
        trigger ../12/gdas/forecast == active or ../12/gdas/forecast == complete
    endfamily		//00

  endfamily		//primary
endsuite		//gfs_c96
