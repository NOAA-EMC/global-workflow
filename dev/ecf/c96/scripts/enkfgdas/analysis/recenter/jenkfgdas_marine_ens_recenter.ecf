#PBS -S /bin/bash
#PBS -N enkfgdas_marine_ens_recenter_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=64:ompthreads=1:ncpus=64:mem=24GB
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufsda

module list
############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}

#### ${HOMEgfs}/dev/job_cards/rocoto/marineanlecen.sh
${HOMEgfs}/jobs/JGLOBAL_MARINE_ANALYSIS_ECEN
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

%end
