#PBS -S /bin/bash
#PBS -N gfs_wave_init_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=4GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufswm

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/waveinit.sh
${HOMEgfs}/jobs/JGLOBAL_WAVE_INIT
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_wave_init

PURPOSE: Creates grid definition files (mod_def.*) for WW3 forecasts and post
programs.

TROUBLESHOOTING

Critical upstream dependency for all wave tasks. If this fails, no wave
forecast or post-processing can run. Check for ww3_grid executable and
grid input files. Common failure: mod_def generation fails if grid
configuration is inconsistent. Verify wave grid configs in parm/wave/.

%end
