#PBS -S /bin/bash
#PBS -N gfs_atmos_analupp_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=1:mpiprocs=120:ompthreads=1:ncpus=120:mem=500GB
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh upp
#### work around for JGLOBAL_ATMOS_UPP that wired the PYTHONPATH to HOMEgfs/sorc location

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}
export FORECAST_HOUR='0'
export FHR3='000'
export UPP_RUN='analysis'
#### ${HOMEgfs}/dev/job_cards/rocoto/upp.sh
${HOMEgfs}/jobs/JGLOBAL_ATMOS_UPP
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_atmos_analupp

PURPOSE: Runs UPP on the atmospheric analysis to produce GRIB2 master files from
analysis fields.

TROUBLESHOOTING

Depends on analysis output. If analysis did not produce valid fields,
UPP may fail or produce empty output. Check UPP itag for correct input
file paths. Module load (upp) must succeed. If GRIB2 output is missing
downstream, check this job first.

%end
