#PBS -S /bin/bash
#PBS -N gfs_marine_analfinal_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufsda

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/marineanlfinal.sh
${HOMEgfs}/jobs/JGLOBAL_MARINE_ANALYSIS_FINALIZE
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_marine_analfinal

PURPOSE: Marine analysis finalization -- applies increments to background,
performs QC, produces final analysis files for forecast.

TROUBLESHOOTING

Depends on marine_anlvar and marine_anlchkpt. If solver failed,
finalization has no valid increments. Check that checkpoint files exist.
Also performs quality control -- may reject analysis if increments are
unreasonably large (indicates solver problem upstream).

%end
