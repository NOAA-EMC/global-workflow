#PBS -S /bin/bash
#PBS -N gdas_wave_postpnt_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:35:00
#PBS -l select=1:mpiprocs=40:ompthreads=1:ncpus=40
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufswm

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/wavepostpnt.sh
${HOMEgfs}/jobs/JGLOBAL_WAVE_POST_PNT
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_wave_postpnt

PURPOSE: Generates wave station/point spectral and bulletin output from GDAS
9-hour WW3 forecast.

TROUBLESHOOTING

Same as GFS wave_postpnt but for GDAS cycle. Depends on GDAS wave
forecast point output. If wave component of GDAS forecast failed, no
point data exists.

%end
