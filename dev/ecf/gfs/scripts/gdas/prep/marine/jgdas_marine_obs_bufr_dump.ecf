#PBS -S /bin/bash
#PBS -N gdas_marine_obs_bufr_dump_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=1:ompthreads=1:ncpus=1:mem=32GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufsda

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_MARINE_OBS_BUFR_DUMP
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_marine_obs_bufr_dump

PURPOSE: Ocean observation preparation -- converts observations in BUFR produced by obsproc to IODA format for the GDAS marine analysis.

TROUBLESHOOTING

Ensure obsproc produced BUFR files and are on disk before this job has begun

%end
