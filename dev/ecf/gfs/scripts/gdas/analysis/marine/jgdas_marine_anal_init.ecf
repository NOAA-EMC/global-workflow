#PBS -S /bin/bash
#PBS -N gdas_marine_anal_init_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=24GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufsda

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/marineanlinit.sh
${HOMEgfs}/jobs/JGLOBAL_MARINE_ANALYSIS_INITIALIZE
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_marine_anal_init

PURPOSE: Initializes marine DA for the GDAS cycle. Same shared
JGLOBAL_MARINE_ANALYSIS_INITIALIZE J-Job.

TROUBLESHOOTING

Same troubleshooting as GFS marine_anl_init. Check background restarts
from previous GDAS cycle forecast and observation files from
prepoceanobs.

%end
