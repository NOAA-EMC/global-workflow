#PBS -S /bin/bash
#PBS -N gdas_atmos_analsnow_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=4:mpiprocs=64:ompthreads=2:ncpus=128
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufsda

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/snowanl.sh
${HOMEgfs}/jobs/JGLOBAL_SNOW_ANALYSIS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_analsnow

PURPOSE: GDAS JEDI snow analysis -- same as GFS version. Assimilates snow obs to
update land surface snow state.

TROUBLESHOOTING

Same troubleshooting as GFS snowanl. Check for missing IMS/GHCN/SNODEP
observations and background snow fields.

%end
