#!/bin/bash
# Fake dbn_alert stub — logs alert calls to a file for verification.
# Alerts are logged to ${DBNLOG_DIR}/dbn_alerts.log

DBNLOG_DIR="${DBNLOG_DIR:-${COMROOT:-/tmp}/dbn_alerts}"
mkdir -p "${DBNLOG_DIR}"

LOGFILE="${DBNLOG_DIR}/dbn_alerts.log"
TIMESTAMP=$(date -u '+%Y-%m-%d %H:%M:%S UTC')

TYPE="${1:-UNKNOWN}"
SUBTYPE="${2:-UNKNOWN}"
JOB_NAME="${3:-UNKNOWN}"
FILE_PATH="${4:-UNKNOWN}"

if [[ -n "${FILE_PATH}" && -f "${FILE_PATH}" ]]; then
    FILE_STATUS="EXISTS"
    FILE_SIZE=$(stat -c %s "${FILE_PATH}" 2> /dev/null || echo "?")
else
    FILE_STATUS="MISSING"
    FILE_SIZE="0"
fi

echo "${TIMESTAMP} | ${TYPE} | ${SUBTYPE} | ${JOB_NAME} | ${FILE_STATUS} | ${FILE_SIZE} bytes | ${FILE_PATH}" >> "${LOGFILE}"

exit 0
