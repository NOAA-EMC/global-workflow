#!/bin/bash
# Fake dbn_alert stub — logs alert calls for verification.
# Extracts RUN.PDY from the file path and writes to RUN.PDY/dbn_alerts/

TYPE="${1:-UNKNOWN}"
SUBTYPE="${2:-UNKNOWN}"
JOB_NAME="${3:-UNKNOWN}"
FILE_PATH="${4:-UNKNOWN}"

# Extract the RUN.PDY directory from the file path.
# COM paths follow: ROTDIR/RUN.PDY/cyc/...
# Walk up from the file until we find a directory matching *.YYYYMMDD
DBNLOG_DIR="/tmp/dbn_alerts"
if [[ -n "${FILE_PATH}" && "${FILE_PATH}" != "UNKNOWN" ]]; then
  dir="${FILE_PATH}"
  while dir="$(dirname "${dir}")" && [[ "${dir}" != "/" ]]; do
    base="$(basename "${dir}")"
    if [[ "${base}" =~ \.[0-9]{8}$ ]]; then
      DBNLOG_DIR="${dir}/dbn_alerts"
      break
    fi
  done
fi

mkdir -p "${DBNLOG_DIR}"
LOGFILE="${DBNLOG_DIR}/dbn_alerts.log"
TIMESTAMP=$(date -u '+%Y-%m-%d %H:%M:%S UTC')

if [[ -n "${FILE_PATH}" && -f "${FILE_PATH}" ]]; then
  FILE_STATUS="EXISTS"
  FILE_SIZE=$(stat -c %s "${FILE_PATH}" 2>/dev/null || echo "?")
else
  FILE_STATUS="MISSING"
  FILE_SIZE="0"
fi

echo "${TIMESTAMP} | ${TYPE} | ${SUBTYPE} | ${JOB_NAME} | ${FILE_STATUS} | ${FILE_SIZE} bytes | ${FILE_PATH}" >> "${LOGFILE}"

exit 0
