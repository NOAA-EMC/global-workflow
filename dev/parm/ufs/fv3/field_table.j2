{#- dev/parm/ufs/fv3/field_table.j2 -#}
{#- Traces to: Requirement 1 AC5-10, Requirement 6 AC1 -#}
{%- set suite = model.physics_suite -%}
{%- set pbl = model.get('pbl_scheme', 'satmedmf') -%}
{%- set progsigma = model.get('progsigma', true) -%}
# added by FRE: sphum must be present in atmos
# specific humidity for moist runs
 "TRACER", "atmos_mod", "sphum"
           "longname",     "specific humidity"
           "units",        "kg/kg"
{% if suite == 'gfdl' %}       "profile_type", "fixed", "surface_value=1.e30" /
{% else %}       "profile_type", "fixed", "surface_value=3.e-6" /
{% endif %}# prognostic cloud water mixing ratio
 "TRACER", "atmos_mod", "liq_wat"
           "longname",     "cloud water mixing ratio"
           "units",        "kg/kg"
       "profile_type", "fixed", "surface_value=1.e30" /
{% if suite in ['gfdl', 'wsm6', 'thompson'] %} "TRACER", "atmos_mod", "rainwat"
           "longname",     "rain mixing ratio"
           "units",        "kg/kg"
       "profile_type", "fixed", "surface_value=1.e30" /
 "TRACER", "atmos_mod", "ice_wat"
           "longname",     "cloud ice mixing ratio"
           "units",        "kg/kg"
       "profile_type", "fixed", "surface_value=1.e30" /
 "TRACER", "atmos_mod", "snowwat"
           "longname",     "snow mixing ratio"
           "units",        "kg/kg"
       "profile_type", "fixed", "surface_value=1.e30" /
 "TRACER", "atmos_mod", "graupel"
           "longname",     "graupel mixing ratio"
           "units",        "kg/kg"
       "profile_type", "fixed", "surface_value=1.e30" /
{% endif %}{% if suite == 'thompson' %} "TRACER", "atmos_mod", "ice_nc"
           "longname",     "cloud ice water number concentration"
           "units",        "/kg"
       "profile_type", "fixed", "surface_value=0.0" /
 "TRACER", "atmos_mod", "rain_nc"
           "longname",     "rain number concentration"
           "units",        "/kg"
       "profile_type", "fixed", "surface_value=0.0" /
{% endif %}# prognostic ozone mixing ratio tracer
 "TRACER", "atmos_mod", "o3mr"
           "longname",     "ozone mixing ratio"
           "units",        "kg/kg"
       "profile_type", "fixed", "surface_value=1.e30" /
{% if pbl == 'satmedmf' %}# prognostic subgrid scale turbulent kinetic energy
 "TRACER", "atmos_mod", "sgs_tke"
           "longname",     "subgrid scale turbulent kinetic energy"
           "units",        "m2/s2"
       "profile_type", "fixed", "surface_value=0.0" /
{% endif %}{% if progsigma %}# prognotsitc sigmab tracer
 "TRACER", "atmos_mod", "sigmab"
           "longname",     "sigma fraction"
           "units",        "fraction"
       "profile_type", "fixed", "surface_value=0.0" /
{% endif %}{% if suite == 'gfdl' %}# non-prognostic cloud amount
 "TRACER", "atmos_mod", "cld_amt"
           "longname",     "cloud amount"
           "units",        "1"
       "profile_type", "fixed", "surface_value=1.e30" /
{% endif %}