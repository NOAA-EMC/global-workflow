{# dev/parm/ufs/fv3/input.nml.j2 #}
{# Comprehensive FV3 input.nml Jinja2 template #}
{# Replaces: parsing_namelists_FV3.sh + global_control.nml.IN #}
{# Traces to: Requirement 1 AC4, Requirement 5 AC3 #}

{# --- Namespace defaults: ensure all sub-dicts exist even if not in context --- #}
{% set physics = model.get('physics', {}) %}
{% set radiation = model.get('radiation', {}) %}
{% set stochastic = model.get('stochastic', {}) %}
{% set land = model.get('land', {}) %}
{% set ugwp = model.get('ugwp', {}) %}
{% set surface_data = model.get('surface_data', {}) %}
{% set iau = model.get('iau', {}) %}
{% set fv3 = model.fv3 %}

&amip_interp_nml
  interp_oi_sst = .true.
  use_ncep_sst  = .true.
  use_ncep_ice  = .false.
  no_anom_sst   = .false.
  data_set      = 'reynolds_oi'
/

&atmos_model_nml
  blocksize   = {{ fv3.blocksize | default(32) }}
  chksum_debug = {{ fv3.chksum_debug | default(false) | fortran_logical }}
  dycore_only = {{ fv3.dycore_only | default(false) | fortran_logical }}
  ccpp_suite  = '{{ fv3.ccpp_suite | default("FV3_GFS_v17_p8") }}'
/

&diag_manager_nml
  max_output_fields = {{ fv3.max_output_fields | default(300) }}
  prepend_date = .true.
/

&fms_nml
  domains_stack_size = {{ fv3.domains_stack_size | default(3000000) }}
  print_memory_usage = {{ fv3.print_memory_usage | default(false) | fortran_logical }}
/

&fv_core_nml
  layout   = {{ fv3.layout[0] }},{{ fv3.layout[1] }}
  io_layout = {{ fv3.io_layout[0] }},{{ fv3.io_layout[1] }}
  npx      = {{ fv3.npx }}
  npy      = {{ fv3.npy }}
  ntiles   = {{ fv3.ntiles | default(6) }}
  npz      = {{ fv3.npz }}
  npzp     = {{ fv3.npzp | default(fv3.npz + 1) }}
  dz_min   = {{ fv3.dz_min | default(6) }}
  psm_bc   = {{ fv3.psm_bc | default(0) }}
  dt_atmos = {{ model.dt_atmos }}
  k_split  = {{ fv3.k_split | default(1) }}
  n_split  = {{ fv3.n_split | default(1) }}
  nwat     = {{ fv3.nwat | default(2) }}
  na_init  = {{ fv3.na_init | default(0) }}
  dnats    = {{ fv3.dnats | default(0) }}
  fv_sg_adj = {{ fv3.fv_sg_adj | default(450) }}
  d_con    = {{ fv3.d_con | default(1.0) }}
  hydrostatic = {{ (fv3.type | default('nh') != 'nh') | fortran_logical }}
  phys_hydrostatic = {{ fv3.phys_hydrostatic | default(false) | fortran_logical }}
  use_hydro_pressure = {{ fv3.use_hydro_pressure | default(false) | fortran_logical }}
  pass_full_omega_to_physics_in_non_hydrostatic_mode = {{ fv3.pass_full_omega_to_physics | default(false) | fortran_logical }}
  make_nh  = {{ (fv3.type | default('nh') == 'nh') | fortran_logical }}
  fv_debug = {{ fv3.fv_debug | default(false) | fortran_logical }}
  range_warn = {{ fv3.range_warn | default(true) | fortran_logical }}
  n_sponge = {{ fv3.n_sponge | default(10) }}
  nudge_qv = {{ fv3.nudge_qv | default(false) | fortran_logical }}
  nudge_dz = {{ fv3.nudge_dz | default(false) | fortran_logical }}
  tau      = {{ fv3.tau | default(10.0) }}
  fast_tau_w_sec = {{ fv3.fast_tau_w_sec | default(0.2) }}
  rf_cutoff = {{ fv3.rf_cutoff | default("7.5e2") }}
  d2_bg_k1 = {{ fv3.d2_bg_k1 | default(0.15) }}
  d2_bg_k2 = {{ fv3.d2_bg_k2 | default(0.02) }}
  kord_tm  = {{ fv3.kord_tm | default(-9) }}
  kord_mt  = {{ fv3.kord_mt | default(9) }}
  kord_wz  = {{ fv3.kord_wz | default(9) }}
  kord_tr  = {{ fv3.kord_tr | default(9) }}
  hord_mt  = {{ fv3.hord_mt | default(5) }}
  hord_vt  = {{ fv3.hord_vt | default(5) }}
  hord_tm  = {{ fv3.hord_tm | default(5) }}
  hord_dp  = {{ fv3.hord_dp | default(-5) }}
  hord_tr  = {{ fv3.hord_tr | default(8) }}
  nord     = {{ fv3.nord | default(3) }}
  dddmp    = {{ fv3.dddmp | default(0.1) }}
  d4_bg    = {{ fv3.d4_bg | default(0.15) }}
  vtdm4    = {{ fv3.vtdm4 | default(0.06) }}
  delt_max = {{ fv3.delt_max | default(0.002) }}
  do_vort_damp = {{ fv3.do_vort_damp | default(true) | fortran_logical }}
  external_ic = {{ fv3.external_ic | default(false) | fortran_logical }}
  external_eta = {{ fv3.external_eta | default(true) | fortran_logical }}
  gfs_phil = {{ fv3.gfs_phil | default(false) | fortran_logical }}
  nggps_ic = {{ fv3.nggps_ic | default(false) | fortran_logical }}
  mountain = {{ fv3.mountain | default(true) | fortran_logical }}
  ncep_ic  = {{ fv3.ncep_ic | default(false) | fortran_logical }}
  adjust_dry_mass = {{ fv3.adjust_dry_mass | default(true) | fortran_logical }}
  dry_mass = {{ fv3.dry_mass | default(98320.0) }}
  consv_te = {{ fv3.consv_te | default(1.0) }}
  do_sat_adj = {{ fv3.do_sat_adj | default(false) | fortran_logical }}
  print_freq = {{ fv3.print_freq | default(6) }}
  warm_start = {{ fv3.warm_start | default(true) | fortran_logical }}
  no_dycore = {{ fv3.no_dycore | default(false) | fortran_logical }}
  agrid_vel_rst = {{ fv3.agrid_vel_rst | default(true) | fortran_logical }}
  read_increment = {{ fv3.read_increment | default(false) | fortran_logical }}
  res_latlon_dynamics = '{{ fv3.res_latlon_dynamics | default("") }}'
  ignore_rst_cksum = .false.
  increment_file_on_native_grid = {{ fv3.increment_file_on_native_grid | default(false) | fortran_logical }}
  filtered_terrain = {{ fv3.filtered_terrain | default(true) | fortran_logical }}
  gfs_dwinds = {{ fv3.gfs_dwinds | default(true) | fortran_logical }}
/

&fv_grid_nml
/

&external_ic_nml
  filtered_terrain = {{ fv3.filtered_terrain | default(true) | fortran_logical }}
  ncep_ic    = {{ fv3.ncep_ic | default(false) | fortran_logical }}
  levp       = {{ fv3.npzp | default(fv3.npz + 1) }}
  gfs_dwinds = {{ fv3.gfs_dwinds | default(true) | fortran_logical }}
  checker_tr = .false.
  nt_checker = 0
/


&gfs_physics_nml
{# --- Timing --- #}
  fhzero   = {{ physics.fhzero | default(6) }}
  fhcyc    = {{ physics.fhcyc | default(0) }}
{# --- Microphysics --- #}
  imp_physics = {{ physics.imp_physics | default(11) }}
