  ico2     = {{ radiation.ico2 | default(2) }}
  isubc_sw = {{ radiation.isubc_sw | default(2) }}
  isubc_lw = {{ radiation.isubc_lw | default(2) }}
  isol     = {{ radiation.isol | default(2) }}
  lwhtr    = {{ radiation.lwhtr | default(true) | fortran_logical }}
  swhtr    = {{ radiation.swhtr | default(true) | fortran_logical }}
  iovr     = {{ radiation.iovr | default(3) }}
  do_RRTMGP = {{ radiation.do_RRTMGP | default(false) | fortran_logical }}
  active_gases = '{{ radiation.active_gases | default("h2o_co2_o3_n2o_ch4_o2") }}'
