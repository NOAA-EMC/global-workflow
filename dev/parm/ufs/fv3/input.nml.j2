  doGP_cldoptics_LUT = {{ radiation.doGP_cldoptics_LUT | default(false) | fortran_logical }}
  doGP_lwscat = {{ radiation.doGP_lwscat | default(false) | fortran_logical }}
  doGP_sgs_cnv = .true.
{# --- PBL --- #}
  hybedmf  = {{ physics.hybedmf | default(false) | fortran_logical }}
