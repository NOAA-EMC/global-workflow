{# Per-collection field definition for inst_ss_bin (Binned sea salt diagnostics). #}
{# All @[VAR] atparse patterns converted to Jinja2 {{ var }} syntax. #}
#
# Binned aerosols - Sea Salt
#
  inst_ss_bin.format:     'CFIO' ,
  inst_ss_bin.descr:      '2d,Hourly,Instantaneous'
  inst_ss_bin.template:   '%y4%m2%d2_%h2%n2z.nc4',
  inst_ss_bin.mode:       'instantaneous'
  inst_ss_bin.grid_label: {{ model.aerosol.grid_label }} ,
  inst_ss_bin.splitField: 1,
  inst_ss_bin.frequency:  {{ model.aerosol.frequencies.inst_ss_bin | default('010000') }} ,
  inst_ss_bin.duration:   010000 ,
  inst_ss_bin.ref_time:   000000 ,
  inst_ss_bin.nbits:      10,
  inst_ss_bin.fields:     'SSEM' , 'SS' ,
                          'SSSD' , 'SS' ,
                          'SSDP' , 'SS' ,
                          'SSWT' , 'SS' ,
                          'SSSV' , 'SS' ,
                          ::
