#! /usr/bin/env bash

########## config.ediag ##########
# GFS ensemble post-eobs specific

echo "BEGIN: config.ediag"

# Get task specific resources
source "${EXPDIR}/config.resources" ediag

# Set to YES to retain the shared temporary GSI diagnostic staging directory
# (gsidiags) for debugging. Default NO; forced NO in operations.
export KEEP_TEMP_DIAGS="NO"

echo "END: config.ediag"
