#! /usr/bin/env bash

########## config.ediag ##########
# GFS ensemble post-eobs specific

echo "BEGIN: config.ediag"

# Get task specific resources
source "${EXPDIR}/config.resources" ediag

# Retain the shared temporary GSI diagnostic staging directory (gsidiags)
# for debugging. Default NO; forced NO in operations.
# TEMP TEST: set to YES to verify retention path (revert to "NO" after testing).
export KEEP_TEMP_DIAGS="YES"

echo "END: config.ediag"
