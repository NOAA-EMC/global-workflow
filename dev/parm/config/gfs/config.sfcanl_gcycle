#! /usr/bin/env bash

########## config.sfcanl_gcycle ##########
# GFS surface analysis specific

echo "BEGIN: config.sfcanl_gcycle"

# Get task specific resources
source "${EXPDIR}/config.resources" sfcanl_gcycle

# Run global_cycle in coupled mode
if [[ "${DO_OCN}" == "YES" && "${DO_ICE}" == "YES" ]]; then
   export COUPLED=".true."
fi

# Turn off NST in JEDIATMVAR
if [[ "${DO_JEDIATMVAR}" == "YES" ]]; then
   export DONST="NO"
fi

if [[ "${DO_GSISOILDA}" == "YES" || "${DO_JEDISOILDAVAR}" == "YES" ]]; then
    if [[ ${DO_LAND_IAU} = ".true." ]]; then
        export GCYCLE_DO_SOILINCR=".false."
    else
        export GCYCLE_DO_SOILINCR=".true."
    fi
fi
#TODO:reconcycle with gsi_soilda
if [[ "${DO_JEDISOILDAVAR}" == "YES" ]]; then
    export SFCANALSH="${SCRglobal}/exglobal_soil_analysis.py"
    export SOIL_STATICB_TYPE="csg"  #soill1" #smcstctq2m"
    export TASK_CONFIG_YAML="${PARMglobal}/gdas/soil/soil_det_config.yaml.j2"
    export OBS_LIST_YAML="${PARMglobal}/gdas/soil/soil_obs_list.yaml.j2"
    export SOIL_FILE_TYPE="csg"

    export BCOV_DIR="/scratch4/NCEPDEV/land/data/DA/bump_soil/"  #TODO change to soil B
    export BCOV_FNAME="c384_soillt_sl_250v700_bump_nicas.nc"    

    # for non-landiau soil increments
    export APPLY_INCR_EXE="${EXECglobal}/apply_soil_incr.x"  #gdas_apply_incr.x"
    export APPLY_INCR_NML_TMPL="${PARMglobal}/gdas/soil/apply_incr_nml.j2"
    export print_debug=".false."
    export truncate_incr=".true."
    export upd_stc=.false.   #SMAP only slc
    export upd_slc=.true.
    export csg_increment=.true.
    export SOIL_INC_PREFIX="soilinc."
    export SOIL_GINC_PREFIX="sfcinc"
    export ADD_SOIL_INC=".false."
fi


echo "END: config.sfcanl_gcycle"
