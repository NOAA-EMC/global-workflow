#! /usr/bin/env bash

echo "BEGIN: config.ice"

# Override atm-only FV3 settings when ice model is on
export min_seaice="1.0e-6"
export use_cice_alb=".true."

# Location of the CICE6 input template.  link_workflow.sh stages ice_in.IN under
# ${PARMglobal}/ufs and recreates it on every run, so an experiment that tracks a
# modified ice_in points at its own copy here instead.  The path is used as given,
# so a custom template can be named anything.
export CICE_TEMPLATE="{{ CICE_TEMPLATE | default('${PARMglobal}/ufs/ice_in.IN') }}"

export MESH_ICE="mesh.mx${ICERES}.nc"

export CICE_GRID="grid_cice_NEMS_mx${ICERES}.nc"
export CICE_MASK="kmtu_cice_NEMS_mx${ICERES}.nc"

echo "END: config.ice"
