#! /usr/bin/env bash

########## config.soilanlens ##########
# JEDI Soil Ensemble Analysis

echo "BEGIN: config.soilanlens"

# Get task specific resources
source "${EXPDIR}/config.resources" soilanlens

# set up soil ensemble analysis
if [[ "${DO_JEDISOILDAENS}" == "YES" ]]; then
    if [[ "${DO_LAND_IAU}" = ".true." ]]; then
        export GCYCLE_DO_SOILINCR=".false."
    else
        export GCYCLE_DO_SOILINCR=".true."
    fi
fi
export SOILENKFSH="${SCRglobal}/exglobal_soil_letkf_analysis.py"
export SOIL_STATICB_TYPE="csg"
export TASK_CONFIG_YAML="${PARMglobal}/gdas/soil/soil_letkf_config.yaml.j2"
export OBS_LIST_YAML="${PARMglobal}/gdas/soil/soil_obs_list.yaml.j2"
export SOIL_FILE_TYPE="csg"

export BCOV_DIR="${HOMEglobal}/fix/gdas/soil/"
export BCOV_FNAME="soill1_bump_nicas_1000km.nc"    

# for non-landiau soil increments
export APPLY_INCR_EXE="${EXECglobal}/apply_soil_incr.x"  
export APPLY_INCR_NML_TMPL="${PARMglobal}/gdas/soil/apply_incr_nml.j2"
export print_debug=".false."
export truncate_incr=".true."
export upd_stc=.false.   # only slc for SMAP
export upd_slc=.true.
export LSOIL_INCR=1
export csg_increment=.true.
export SOIL_INC_PREFIX="soilinc."
export SOIL_GINC_PREFIX="sfcinc"
export ADD_SOIL_INC=".false."
export ens_size={{ NMEM_ENS }}
export layout_x_soil=1
export layout_y_soil=1

echo "END: config.esfc_gcycle"
