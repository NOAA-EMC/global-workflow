#! /usr/bin/env bash

########## config.awips ##########
# GFS awips step specific

echo "BEGIN: config.awips"

# Get task specific resources
. "${EXPDIR}/config.resources" awips

# No. of concurrent awips jobs
# Chosen so np.array_split(55 fhrs, MAX_TASKS) yields packed groups of ~4
# (13 groups of 4 + 1 group of 3) instead of singleton buckets. Adjust if
# FHOUT_HF_GFS_AWIPS / FHMAX_HF_GFS_AWIPS / FHOUT_GFS_AWIPS changes the
# total AWIPS fhr count.
export MAX_TASKS=14

# AWIPS forecast-hour frequency (overrides the model FHOUT_HF_GFS / FHMAX_HF_GFS
# / FHOUT_GFS on the awips path). The AWIPS 20km job is driven by per-fhr WMO
# header parm files at
#   ${PARMglobal}/wmo/grib2_awpgfs_20km_${GRID}f${FHR}
# which are only provided every 3 hours out to f084 and every 6 hours to f240,
# so the metatask must fan out at exactly those hours (not at the model
# FHOUT_HF_GFS=1 / FHMAX_HF_GFS=120 / FHOUT_GFS=3 rates).
export FHOUT_HF_GFS_AWIPS=3
export FHMAX_HF_GFS_AWIPS=84
export FHOUT_GFS_AWIPS=6

echo "END: config.awips"
