#! /usr/bin/env bash

########## config.awips ##########
# GFS awips step specific

echo "BEGIN: config.awips"

# Get task specific resources
. "${EXPDIR}/config.resources" awips

# No. of concurrent awips jobs
export MAX_TASKS=42

# AWIPS high-frequency output interval (overrides FHOUT_HF_GFS on the awips path).
# The AWIPS 20km job is driven by per-fhr WMO header parm files at
#   ${PARMglobal}/wmo/grib2_awpgfs_20km_${GRID}f${FHR}
# which are only provided every 3 hours in the high-frequency range, so the
# metatask must fan out every 3 hours (not at the model FHOUT_HF_GFS=1 rate).
export FHOUT_HF_GFS_AWIPS=3

echo "END: config.awips"
