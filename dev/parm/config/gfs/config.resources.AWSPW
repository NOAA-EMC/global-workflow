#! /usr/bin/env bash
# shellcheck disable=SC2034

# AWS-specific job resources

unset memory
unset "memory_${RUN}"

step=$1

case ${step} in
  "prep")
    export PARTITION_BATCH="process"
    export ntasks=12
    tasks_per_node=12
    ;;

  "fcst" | "efcs" | "wavepostpnt")
    export PARTITION_BATCH="compute"
    unset PARTITION_SERVICE
    max_tasks_per_node=48
    ;;

  "anal")
    export is_exclusive="True"
    export PARTITION_BATCH="compute"
    export threads_per_task=1
    max_tasks_per_node=48
    tasks_per_node=48
    ;;

  "sfcanl")
    export is_exclusive=False
    export PARTITION_BATCH="process"
    tasks_per_node=${ntiles:-6}
    ;;

  "analcalc" | "analdiag" | "upp")
    export PARTITION_BATCH="compute"
    max_tasks_per_node=48
    ;;

  *)
    export PARTITION_BATCH="process"
    unset PARTITION_SERVICE
    max_tasks_per_node=24
    tasks_per_node=24
    ;;

esac

export max_tasks_per_node
export tasks_per_node
