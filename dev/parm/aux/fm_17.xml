		<envar><name>DATAROOT</name><value>&DATAROOT_aux;/gfs.<cyclestr>@Y@m@d@H</cyclestr></value></envar>
		<envar><name>EDATE_GFS</name><value>2030010100</value></envar>
		<envar><name>METPCASE</name><value>#metpcase#</value></envar>

		<dependency>
			<or>
				<taskdep task="gfs_arch_vrfy"/>
				<and>
					<not><taskvalid task="gfs_arch_vrfy"/></not>
					<taskdep task="gfs_arch_vrfy" cycle_offset="-18:00:00"/>
					<not><cycleexistdep cycle_offset="-6:00:00"/></not>
					<not><cycleexistdep cycle_offset="-12:00:00"/></not>
				</and>
			</or>
		</dependency>

