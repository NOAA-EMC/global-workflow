<?xml version="1.0"?>
<!DOCTYPE workflow
[
	<!--
	PROGRAM
		Auxillary workflow manager for Global Forecast System
		Variables:
		PSLOT: The name of this auxillary system
		MAXTRIES: How many times to run a job
		HOME_repo: Where the official repository is located
		EXP_aux: Where the expdir for this auxillary system lives (can be the same as GFS)
		ECF_OUT_gfs: The GFS ecflow output directory; used as triggers
		COM_aux: The auxillary COM directory (ONLY set this to COM_gfs when going live, not for testing)
		DATAROOT_aux: DATAROOT for this auxillary system (can be the same as GFS)
		COMROOT_r: The root of this auxillary system (ONLY set this to COMROOT_gfs when going live, not for testing)
	-->
	<!ENTITY PSLOT "aux_gfs">
	<!ENTITY MAXTRIES "1">
	<!ENTITY HOME_repo "/lfs/h2/emc/global/noscrub/David.Huber/GW/gw_aux_v17">
	<!ENTITY EXP_aux "/lfs/h2/emc/global/noscrub/David.Huber/EXP/aux">
	<!ENTITY ECF_OUT_gfs "/lfs/h2/emc/global/noscrub/emc.global/ecflow_gfsv17/para/output/prod/today">
	<!ENTITY COM_aux "/lfs/h2/emc/ptmp/david.huber/realtime_aux/COM/&PSLOT;">
	<!ENTITY DATAROOT_aux "/lfs/h2/emc/stmp/david.huber/RUNDIRS/&PSLOT;">
	<!ENTITY COMROOT_r "/lfs/h2/emc/ptmp/david.huber/realtime_aux/COM">
]>

<workflow realtime="F" scheduler="pbspro" cyclethrottle="1" taskthrottle="25">

	<log verbosity="10"><cyclestr>&EXP_aux;/logs/@Y@m@d@H.log</cyclestr></log>

	<!-- Define the cycles -->
	<cycledef group="gdas">202605260000 202605270000 06:00:00</cycledef>
	<cycledef group="gfs">202605260000 202605270000 06:00:00</cycledef>

<task name="gfs_tracker" cycledefs="gfs" maxtries="&MAXTRIES;">

	<command>&HOME_repo;/dev/job_cards/rocoto/tracker.sh</command>

	<jobname><cyclestr>fm_17_gfs_tracker_@H</cyclestr></jobname>
	<account>GFS-DEV</account>
	<queue>dev</queue>
	<walltime>00:10:00</walltime>
	<nodes>1:ppn=1:tpp=1</nodes>
	<memory>6G</memory>
	<native>-l place=vscatter:shared</native>

	<join><cyclestr>&COM_aux;/logs/@Y@m@d@H/gfs_tracker.log</cyclestr></join>

	<envar><name>RUN_ENVIR</name><value>emc</value></envar>
	<envar><name>HOMEgfs</name><value>&HOME_repo;</value></envar>
	<envar><name>EXPDIR</name><value>&EXP_aux;</value></envar>
	<envar><name>NET</name><value>gfs</value></envar>
	<envar><name>RUN</name><value>gfs</value></envar>
	<envar><name>CDATE</name><value><cyclestr>@Y@m@d@H</cyclestr></value></envar>
	<envar><name>PDY</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
	<envar><name>cyc</name><value><cyclestr>@H</cyclestr></value></envar>
	<envar><name>COMROOT</name><value>&COMROOT_r;</value></envar>
	<envar><name>DATAROOT</name><value>&DATAROOT_aux;/gfs.<cyclestr>@Y@m@d@H</cyclestr></value></envar>

	<dependency>
		<datadep><cyclestr offset="06:00:00">&ECF_OUT_gfs;/@Y@m@d@H</cyclestr></datadep>
	</dependency>

</task>

