&config
  n_vars=@[n_vars],
  variable_list=@[soil_incr_vars]
  missing_value=0.,
  time_list=@[time_list],
  add_time_dim=@[add_time_dim], 
/
&input
  gridtype="gau_inc",
  ires=@[ires],
  jres=@[jres],
  fname=@[in_fname], 
  dir="./",
  fname_coord="gaussian_scrip.nc",
  dir_coord="./",
  fname_mask=@[fname_mask_in],
  dir_mask=@[dir_mask_in]
/
&output
  gridtype="fv3_rst",
  ires=@[ireso],
  jres=@[jreso],
  fname=@[out_fname],
  dir="./",
  fname_mask="vegetation_type" 
  dir_mask="./"
  dir_coord="./"
 /
