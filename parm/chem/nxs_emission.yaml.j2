nxs_emission:
  data_in:
    link:
      - ["{{ NXS_INPUT_DIR }}", "{{ LOCAL_INPUT_DIR }}"]
    copy:
      - ["{{ NXS_EXECUTABLE }}", "{{ WORK_DIR }}/"]
  data_out:
    mkdir:
      - "{{ COMOUT_CHEM_INPUT }}"
      - "{{ COMOUT_CHEM_RESTART }}"
    copy:
      {% for fileout in FINAL_OUTPUT %}
      - ["{{ WORK_DIR }}/{{ fileout }}", "{{ COMOUT_CHEM_INPUT }}/"]
      {% endfor %}
      - ["{{ WORK_DIR }}/{{ RestartFile }}", "{{ COMOUT_CHEM_RESTART }}/"]