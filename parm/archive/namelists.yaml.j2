namelists:
    name: "NAMELISTS"
    target: "{{ ATARDIR }}/{{ cycle_YMDH }}/namelists.tar"
    required:
        {% set FILES = ['diag_table', 'ice_in', 'input.nml', 'model_configure', 'MOM_input', 'ufs.configure'] %}
        {% for file in FILES %}
        - '{{ COMIN_CONF | relpath(ROTDIR) }}/ufs.{{ file }}'
        
        {% for mem in range(1, NMEM_ENS + 1) %}
        {% set mem_char = 'mem%03d' | format(mem) %}
        {% set tmpl_dict = ({ '${ROTDIR}':ROTDIR,
                              '${RUN}':RUN,
                              '${YMD}':cycle_YMD,
                              '${HH}':cycle_HH,
                              '${MEMDIR}': mem_char }) %}
        {% set COMIN_CONF = COM_CONF_TMPL | replace_tmpl(tmpl_dict) %}
        - '{{ COMIN_CONF | relpath(ROTDIR) }}/ufs.{{ file }}'
        
        {% endfor %}
        {% endfor %}
        

