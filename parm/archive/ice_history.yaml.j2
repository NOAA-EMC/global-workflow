{% set cycle_YMDH = current_cycle | to_YMDH %}
{% set head = RUN ~ ".ice.t" ~ cycle_HH ~ "z." %}
ice_history:
    name: "ICE_HISTORY"
    target: "{{ ATARDIR }}/{{ cycle_YMDH }}/ice_history.tar"
    required:
        - "{{ COMIN_ICE_HISTORY | relpath(ROTDIR) }}/{{ head }}*.nc"
        {% for mem in range(1, NMEM_ENS + 1) %}
        {% set mem_char = 'mem%03d' | format(mem) %}
        {% set tmpl_dict = ({ '${ROTDIR}':ROTDIR,
                              '${RUN}':RUN,
                              '${YMD}':cycle_YMD,
                              '${HH}':cycle_HH,
                              '${MEMDIR}': mem_char }) %}
        {% set COMIN_ICE_HISTORY = COM_ICE_HISTORY_TMPL | replace_tmpl(tmpl_dict) %}
        - "{{ COMIN_ICE_HISTORY | relpath(ROTDIR) }}/{{ head }}*.nc"
        {% endfor %}
       
