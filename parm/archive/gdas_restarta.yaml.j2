gdas_restarta:
    {% set head = "gdas.t" + cycle_HH + "z." %}
    name: "GDAS_RESTARTA"
    target: "{{ ATARDIR }}/{{ cycle_YMDH }}/gdas_restarta.tar"
    required:
        # Deterministic analysis increments
        {% if DO_JEDIATMVAR and not (ATMINC_GRID == 'gaussian') %}
            {% for iaufhr in IAUFHRS %}
                {% for itile in range(6) %}
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}jedi_increment.atm.i{{ "%03d" % iaufhr }}.tile{{ itile+1 }}.nc"
                {% endfor %}
            {% endfor %}
        {% else %}
        # IAU increments
            {% for iaufhr in IAUFHRS %}
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}increment.atm.i{{ "%03d" % iaufhr }}.nc"
            {% endfor %}
        {% endif %}

        # Soil DA increments
        {% if DO_GSISOILDA %}
            {% if DO_LAND_IAU %}    #regridded tiles for land iau
                {% for itile in range(1,7) %}
        - "{{ COMIN_ATMOS_ANALYSIS }}/increment.sfc.tile{{ itile }}.nc"
                {% endfor %}
            {% endif %}
        {% endif %}

        # Surface analysis tiles
        # anl_time_YMD and anl_time_HH are pre-calculated in Python: -3H if DOHYBVAR and DOIAU, 0H otherwise
        {% for itile in range(1,7) %}
        - "{{ COMIN_ATMOS_RESTART }}/{{ anl_time_YMD }}.{{ anl_time_HH }}0000.sfcanl_data.tile{{ itile }}.nc"
        {% endfor %}

        # Initial biases
        {% if not DO_JEDIATMVAR %}
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}abias.txt"
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}abias_air.txt"
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}abias_pc.txt"
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}cnvstat.tar"
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}abias_int.txt"
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}analysis.dtf.a006.nc"
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}analysis.done.txt"
        {% else %}
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}rad_varbc_params.tar"
        {% endif %}

        # Input BUFR files
        - "{{ COMIN_OBS }}/{{ head }}nsstbufr"
        - "{{ COMIN_OBS }}/{{ head }}prepbufr"
        - "{{ COMIN_OBS }}/{{ head }}prepbufr.acft_profiles"
    optional:
        - "{{ COMIN_ATMOS_ANALYSIS }}/{{ head }}radstat.tar"
