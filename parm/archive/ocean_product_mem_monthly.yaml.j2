{% set cycle_YMDH = current_cycle | to_YMDH %}
{% set head = RUN ~ "*t??????????.1p00.monthly_avg." %}
{% for mem in range(0, NMEM_ENS + 1) %}
{% set mem_char = 'mem%03d' | format(mem) %}
{% set tmpl_dict = ({ '${ROTDIR}':ROTDIR,
                              '${RUN}':RUN,
                              '${YMD}':cycle_YMD,
                              '${HH}':cycle_HH,
                              '${MEMDIR}': mem_char }) %}
ocean_product_monthly_{{ mem_char }}:
    name: "OCEAN_PRODUCT_MONTHLY_{{ mem_char }}"
    target: "{{ ATARDIR }}/{{ cycle_YMDH }}/ocean_product_monthly_{{ mem_char }}.tar"
    required:
        {% set COMIN_OCEAN_NETCDF = COM_OCEAN_NETCDF_TMPL | replace_tmpl(tmpl_dict) %}
        - "{{ COMIN_OCEAN_NETCDF | relpath(ROTDIR) }}/1p00/{{ head }}*.nc"
{% endfor %}
