# NOTE: Complex logic (cycle vars, COM paths, file set building) has been moved to
# ush/python/pygfs/task/archive_vars.py (ArchiveVrfy.gfs_arcdir() method)
# This YAML now receives pre-calculated file_set and mkdir_list from Python

# The Python code calculates and returns:
# - file_set: List of [source, destination] pairs
# - mkdir_list: List of directories to create

# Directory creation
mkdir:
{% for dir_path in mkdir_list %}
    - "{{ dir_path }}"
{% endfor %}

# File copying operations
copy_opt:
{% for source_dest_pair in file_set %}
    - {{ source_dest_pair }}
{% endfor %}
