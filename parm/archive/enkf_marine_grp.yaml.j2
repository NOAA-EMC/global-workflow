enkf_marine_grp:
    name: "ENKF_MARINE_GRP"
    target: "{{ ATARDIR }}/{{ cycle_YMDH }}/{{ RUN }}_marine_grp{{ ENSGRP }}.tar"
    required:
        # Forecast data
        {% if is_gdas %}
        - "{{ COMIN_OCEAN_HISTORY_MEM }}/{{ head }}inst.f009.nc"

        {% for body in ["ic", "inst.f009"] %}
        - "{{ COMIN_ICE_HISTORY_MEM }}/{{ head }}{{ body }}.nc"
        {% endfor %}
        {% endif %}

        # Store the individual member analysis data
        {% if DOLETKF_OCN or DOLETKF_OCN_INC %}
        - "{{ COMIN_OCEAN_ANALYSIS_MEM }}/{{ head }}mom6_increment.i006.nc"
        - "{{ COMIN_OCEAN_ANALYSIS_MEM }}/{{ head }}jedi_increment.i006.nc"
        - "{{ COMIN_ICE_ANALYSIS_MEM }}/{{ head }}jedi_increment.i006.nc"
        - "{{ COMIN_CONF }}/soca_letkf.yaml"
        {% endif %}
