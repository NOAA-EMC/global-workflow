{% set cycle_YMDH = current_cycle | to_YMDH %}
{% set head = RUN ~ ".ocean.t" ~ cycle_HH ~ "z.6hr_avg.f???" %}
{% for mem in range(0, NMEM_ENS + 1) %}
{% set mem_char = 'mem%03d' | format(mem) %}
{% set tmpl_dict = ({ '${ROTDIR}':ROTDIR,
                              '${RUN}':RUN,
                              '${YMD}':cycle_YMD,
                              '${HH}':cycle_HH,
                              '${MEMDIR}': mem_char }) %}
ocean_history_6hrly_{{ mem_char }}:
    name: "OCEAN_HISTORY_6HRLY_{{ mem_char }}"
    target: "{{ ATARDIR }}/{{ cycle_YMDH }}/ocean_history_6hrly_{{ mem_char }}.tar"
    required:
        {% set COMIN_OCEAN_HISTORY = COM_OCEAN_HISTORY_TMPL | replace_tmpl(tmpl_dict) %}
        - "{{ COMIN_OCEAN_HISTORY | relpath(ROTDIR) }}/{{ head }}.nc"
{% endfor %}
       
