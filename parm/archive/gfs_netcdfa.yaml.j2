gfs_netcdfa:
    {% set head = "gfs.t" + cycle_HH + "z." %}
    name: "GFS_NETCDFA"
    target: "{{ ATARDIR }}/{{ cycle_YMDH }}/gfs_netcdfa.tar"
    required:
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}anl.atm.nc"
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}anl.sfc.nc"
        {% if DO_JEDIATMVAR %}
        {% for itile in range(6) %}
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}increment.cs_atm.tile{{ itile+1 }}.nc"
        {% endfor %}
        {% else %}
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}increment.atm.nc"
        {% endif %}
        {% for iauhr in IAUFHRS if iauhr != 6 %}
        {% if DO_JEDIATMVAR %}
        {% for itile in range(6) %}
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}increment.cs_atm.i{{ "%03d" % iauhr }}.tile{{ itile+1 }}.nc"
        {% endfor %}
        {% else %}
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}increment.atm.i{{ "%03d" % iauhr }}.nc"
        {% endif %}
        {% endfor %}
    optional:
        {% if not DO_JEDIATMVAR %}
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}anl.dtn.nc"
        - "{{ COMIN_ATMOS_ANALYSIS | relpath(ROTDIR) }}/{{ head }}anl.done.txt"
        {% endif %}
