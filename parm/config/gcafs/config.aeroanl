#!/bin/bash -x

########## config.aeroanl ##########
# configuration common to all aero analysis tasks

echo "BEGIN: config.aeroanl"

# define analysis resolution
export CASE_ANL="C384"

export STATICB_TYPE='diffusion'

export TASK_CONFIG_YAML="${PARMglobal}/gdas/aero/aero_det_config.yaml.j2"
export OBS_LIST_YAML="${PARMglobal}/gdas/aero/aero_obs_list.yaml.j2"

export io_layout_x="1"
export io_layout_y="1"

export aero_bkg_times="3,6,9"

echo "END: config.aeroanl"