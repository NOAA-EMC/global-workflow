#!/bin/bash
# Jinja-templated variables
# For now, there is no easy way to determine which log file belongs to which
# tarball.  So, the verify script simply checks all log files for "SUCCESS".
# TODO when the Doorman is capable of providing the xfer ID, use that instead
# globus_xfer_id=""
log_directory="{{server_home}}/doorman/{{jobid}}/logs/"

hpss_stat=""
for log in "${log_directory}"/*.log; do
    hpss_stat_tmp=$(tail -1 "${log}")
    hpss_stat="${log}: ${hpss_stat}\n${hpss_stat_tmp}"
done

echo "${hpss_stat}"
