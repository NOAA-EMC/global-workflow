source "${HOMEgfs}/ush/jjob_header.sh" -e "wave_stat" -c "base wave wave_stat wave_stat_pnt"
source "${USHgfs}/wave_domain_grid.sh"

# Set COM Paths

for grid in ${wavepostGRD}; do
  process_grdID "${grid}"
