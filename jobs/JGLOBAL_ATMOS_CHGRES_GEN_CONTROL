#! /usr/bin/env bash
# shellcheck disable=SC2153  # PDY is always set in environment
source "${HOMEgfs}/ush/jjob_header.sh" -e "gen_control_ic" -c "base gen_control_ic"

# Define COM directories
MEMDIR="mem000" YMD=${GDATE:0:8} HH=${GDATE:8:2} declare_from_tmpl -rx \
    COMIN_ATMOS_HISTORY_MEM:COM_ATMOS_HISTORY_TMPL
MEMDIR="mem000" YMD=${PDY} HH=${cyc} declare_from_tmpl -rx \
    COMOUT_ATMOS_INPUT_MEM:COM_ATMOS_INPUT_TMPL
###############################################################
# Ensure COMIN_ATMOS_INPUT_MEM exists, create if needed
if [[ ! -d "${COMOUT_ATMOS_INPUT_MEM}" ]]; then
  if ! mkdir -p "${COMOUT_ATMOS_INPUT_MEM}"; then
    echo "ERROR: Failed to create directory ${COMOUT_ATMOS_INPUT_MEM}"
    exit 1
  fi
fi
###############################################################
# Run relevant script
${CHGRESFCSTSH:-${SCRgfs}/exglobal_atmos_chgres_gen_control.sh} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit "Failed to run chgres_cube, ABORT!"
fi
##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi


exit 0
