#! /usr/bin/env bash

source "${HOMEgfs}/ush/jjob_header.sh" -e "gen_control_ic" -c "base gen_control_ic"
##############################################
# Calculate gPDY (previous day) and gcyc (previous cycle hour)
PDY="${PDY:-$(date +%Y%m%d)}"
cyc="${cyc:-00}"

# gPDY: previous day in YYYYMMDD format
GDATE=$(date --utc +%Y%m%d%H -d "${PDY} ${cyc} - ${assim_freq} hours")
export gPDY=${GDATE:0:8}
export gcyc=${GDATE:8:2}

# Define COM directories
MEMDIR="mem000" YMD=${gPDY} HH=${gcyc} declare_from_tmpl -rx \
    COMIN_ATMOS_HISTORY_MEM:COM_ATMOS_HISTORY_TMPL
MEMDIR="mem000" YMD=${PDY} HH=${cyc} declare_from_tmpl -rx \
    COMOUT_ATMOS_INPUT_MEM:COM_ATMOS_INPUT_TMPL
###############################################################
# Run relevant script
${CHGRESFCSTSH:-${SCRgfs}/exglobal_atmos_chgres_gen_control.sh} && true
export err=$?
if [[ ${err} -ne 0 ]]; then
    err_exit
fi

##########################################
# Remove the Temporary working directory
##########################################
cd "${DATAROOT}" || true
if [[ "${KEEPDATA}" == "NO" ]]; then
    rm -rf "${DATA}"
fi


exit 0
