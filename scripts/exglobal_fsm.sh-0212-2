#!/bin/bash
set -x

# File Service Manager (FSM) for Global Workfow
# WGF (Workflow Group Family Assignment) - atmos, ocean
# RJN (Request Job Name) - prep, forecast

previous_cycle_PDY=$(echo $($NDATE -6 ${CDATE}) | cut -c1-8)
previous_cycle_cyc=$(echo $($NDATE -6 ${CDATE}) | cut -c9-10)

# Initialize switch
scan_release_gfs_atmos_prep="NO"
scan_release_gfs_ocean_prepoceanobs="NO"
scan_release_gfs_atmos_product="NO"
scan_release_gfs_ocean_wavepostsbs="NO"
scan_release_gfs_ocean_produc="NO"
scan_release_gfs_ice_product="NO"
scan_release_gdas_atmos_prep="NO"
scan_release_gdas_ocean_prepoceanobs="NO"
scan_release_gdas_atmos_prod="NO"
scan_release_gdas_ocean_wavepostsbs="NO"

if [ ${RUN} == "gfs" ]; then
  if [ ${RJN} == "prep" ]; then
    if [ ${WGF} == "atmos" ]; then
      scan_release_gfs_atmos_prep="YES"
    elif [ ${WGF} == "ocean" ]; then
      scan_release_gfs_ocean_prepoceanobs="YES"
    fi
  fi
fi
if [ ${RUN} == "gdas" ]; then
  if [ ${RJN} == "prep" ]; then
    if [ ${WGF} == "atmos" ]; then
      scan_release_gdas_atmos_prep="YES"
    elif [ ${WGF} == "ocean" ]; then
      scan_release_gdas_ocean_prepoceanobs="YES"
    fi
  fi
fi

if [ ${RJN} == "forecast" ]; then
  if [ ${RUN} == "gfs" ]; then
    COMIN_ATMOS_HISTORY=${COMgfs}/gfs.${PDY}/${cyc}/model/atmos/history
    COMIN_ATMOS_MASTER=${COMgfs}/gfs.${PDY}/${cyc}/model/atmos/master
    COMIN_OCEAN_HISTORY=${COMgfs}/gfs.${PDY}/${cyc}/model/ocean/history
    COMIN_ICE_HISTORY=${COMgfs}/gfs.${PDY}/${cyc}/model/ice/history
    scan_release_gfs_atmos_product="YES"
    scan_release_gfs_ocean_wavepostsbs="YES"
    scan_release_gfs_ocean_produc="YES"
    scan_release_gfs_ice_product="YES"
    # Initialize search array
    for fhr in $(seq 0 3 384); do
      array_element_atmos_master[$((10#$fhr))]="NO"
      array_element_ocean_uglo_15km[$((10#$fhr))]="NO"
    done
    for fhr in $(seq 6 6 384); do
      array_element_ocean_6hr_avg[$((10#$fhr))]="NO"
      array_element_ice_6hr_avg[$((10#$fhr))]="NO"
    done
  fi
  if [ ${RUN} == "gdas" ]; then
    COMIN_ATMOS_HISTORY=${COMgfs}/gdas.${PDY}/${cyc}/model/atmos/history
    COMIN_WAVE_HISTORY=${COMgfs}/gdas.${PDY}/${cyc}/model/wave/history
    COMIN_OCEAN_HISTORY=${COMgfs}/gdas.${PDY}/${cyc}/model/ocean/history
    scan_release_gdas_atmos_prod="YES"
    scan_release_gdas_ocean_wavepostsbs="YES"
  fi
fi

COMINobsproc=${COMINobsproc:-${DMPDIR}/gfs.${PDY}/${cyc}/atmos}
COMINgdasobs=${COMINgdasobs:-${DMPDIR}/gdas.${previous_cycle_PDY}/${previous_cycle_cyc}/atmos}

proceed_trigger_scan="YES"
while [ ${proceed_trigger_scan} == "YES" ]; do
  proceed_trigger_scan="NO"

  #### release_gfs_atmos_prep
  if [ ${scan_release_gfs_atmos_prep} == "YES" ]; then
    echo "Proceeding with scan_release_gfs_atmos_prep"
    if [[ -s ${COMINgdasobs}/gdas.t${previous_cycle_cyc}z.updated.status.tm00.bufr_d ]] && [[ -s ${COMINobsproc}/gfs.t${cyc}z.prepbufr ]]; then
      ecflow_client --event release_gfs_atmos_prep
      scan_release_gfs_atmos_prep="NO"
    else
      proceed_trigger_scan="YES"
    fi
  fi

  #### release_gfs_ocean_prepoceanobs
  if [ ${scan_release_gfs_ocean_prepoceanobs} == "YES" ]; then
    skip_this_scan="YES"
    echo "Proceeding with scan_release_gfs_ocean_prepoceanobs"
    COMIN_prep_ocean_obs=${COMROOT}/ocean/gfs.${PDY}/${cyc}/ocean
    for ty_md in adt icec sst insitu; do
      if [[ $(ls ${COMIN_prep_ocean_obs}/${ty_md}/*${ty_md}* | wc -l) -eq 0 ]]; then
        skip_this_scan="NO"
        proceed_trigger_scan="YES"
      fi
    done
    if [ ${skip_this_scan} == "YES" ]; then
      ecflow_client --event release_gfs_ocean_prepoceanobs
      scan_release_gfs_ocean_prepoceanobs="NO"
    fi
  fi

  #### release_gfs_atmos_product
  if [ ${scan_release_gfs_atmos_product} == "YES" ]; then
    skip_this_scan="NO"
    scan_release_gfs_atmos_product="NO"
    echo "Proceeding with scan_release_gfs_atmos_product"
    gfs_atmos_product_group_idx_head=0
    gfs_atmos_product_group_idx_tail=0
    for gfs_atmos_product_group in $(seq 18 18 384); do
      release_event="NO"
      gfs_atmos_product_group_idx_nls=${gfs_atmos_product_group_idx_head}
      gfs_atmos_product_group_idx_head=${gfs_atmos_product_group_idx_tail}
      gfs_atmos_product_group_idx_tail=$(( gfs_atmos_product_group-3 ))
      for fhr in $(seq ${gfs_atmos_product_group_idx_nls} 3 ${gfs_atmos_product_group_idx_tail}); do
        # Looking for file those FHR is the subset group
        fhr_3d=$( printf "%03d" ${fhr} )
        atmos_master=${COMIN_ATMOS_MASTER}/gfs.t${cyc}z.master.f${fhr_3d}.grib2
        if [ ${array_element_atmos_master[$((10#$fhr))]} == "NO" ] && [ ${skip_this_scan} == "NO" ]; then 
          # Increase I/O performance by avoid redundant file search
          if [ -s ${atmos_master} ]; then
            # Check for the file and set ecflow event as needed
            array_element_atmos_master[$((10#$fhr))]="YES"
            if [ ${fhr} -eq ${gfs_atmos_product_group_idx_tail} ]; then
              # Release event if all files within the subset group are found
              gfs_atmos_product_group_idx_head_3d=$( printf "%03d" ${gfs_atmos_product_group_idx_head} )
              gfs_atmos_product_group_idx_tail_3d=$( printf "%03d" ${gfs_atmos_product_group_idx_tail} )
              ecflow_client --event release_gfs_atmos_product_f${gfs_atmos_product_group_idx_head_3d}_f${gfs_atmos_product_group_idx_tail_3d}
            fi
          else
            echo "FSM release_gfs_atmos_product is waiting for file: ${atmos_master}"
            # Restart the search if one of the member is not found by skip the rest
            skip_this_scan="YES"
            scan_release_gfs_atmos_product="YES"
            proceed_trigger_scan="YES"
          fi
        fi
      done
      # Update search group range
      gfs_atmos_product_group_idx_head=$gfs_atmos_product_group
    done
  fi

  #### release_gfs_ocean_wavepostsbs
  if [ ${scan_release_gfs_ocean_wavepostsbs} == "YES" ]; then
    skip_this_scan="NO"
    scan_release_gfs_ocean_wavepostsbs="NO"
    echo "Proceeding with scan_release_gfs_ocean_wavepostsbs"
    gfs_ocean_wavepostsbs_group_idx_head=0
    gfs_ocean_wavepostsbs_group_idx_tail=0
    for gfs_ocean_wavepostsbs_group in $(seq 18 18 384); do
      release_event="NO"
      gfs_ocean_wavepostsbs_group_idx_nls=${gfs_ocean_wavepostsbs_group_idx_head}
      gfs_ocean_wavepostsbs_group_idx_head=${gfs_ocean_wavepostsbs_group_idx_tail}
      gfs_ocean_wavepostsbs_group_idx_tail=$(( gfs_ocean_wavepostsbs_group-3 ))
      for fhr in $(seq ${gfs_ocean_wavepostsbs_group_idx_nls} 3 ${gfs_ocean_wavepostsbs_group_idx_tail}); do
        # Looking for file those FHR is the subset group
        fhr_3d=$( printf "%03d" ${fhr} )
        ocean_uglo_15km=${COMIN_OCEAN_HISTORY}/gfs.t${cyc}z.uglo_15km.f${fhr_3d}.bin
        if [ ${array_element_ocean_uglo_15km[$((10#$fhr))]} == "NO" ] && [ ${skip_this_scan} == "NO" ]; then
          # Increase I/O performance by avoid redundant file search
          if [ -s ${ocean_uglo_15km} ]; then
            # Check for the file and set ecflow event as needed
            array_element_ocean_uglo_15km[$((10#$fhr))]="YES"
            if [ ${fhr} -eq ${gfs_ocean_wavepostsbs_group_idx_tail} ]; then
              # Release event if all files within the subset group are found
              gfs_ocean_wavepostsbs_group_idx_head_3d=$( printf "%03d" ${gfs_ocean_wavepostsbs_group_idx_head} )
              gfs_ocean_wavepostsbs_group_idx_tail_3d=$( printf "%03d" ${gfs_ocean_wavepostsbs_group_idx_tail} )
              ecflow_client --event release_gfs_ocean_wavepostsbs_f${gfs_ocean_wavepostsbs_group_idx_head_3d}_f${gfs_ocean_wavepostsbs_group_idx_tail_3d}
            fi
          else
            echo "FSM release_gfs_ocean_wavepostsbs is waiting for file: ${ocean_uglo_15km}"
            # Restart the search if one of the member is not found by skip the rest
            skip_this_scan="YES"
            scan_release_gfs_ocean_wavepostsbs="YES"
            proceed_trigger_scan="YES"
          fi
        fi
      done
      # Update search group range
      gfs_ocean_wavepostsbs_group_idx_head=$gfs_ocean_wavepostsbs_group
    done
  fi

  #### release_gfs_ocean_product
  if [ ${scan_release_gfs_ocean_product} == "YES" ]; then
    skip_this_scan="NO"
    scan_release_gfs_ocean_product="NO"
    echo "Proceeding with scan_release_gfs_ocean_product"
    gfs_ocean_product_group_idx_head=0
    gfs_ocean_product_group_idx_tail=0
    fhr_end=384
    fhr_start=6
    while [ $fhr_start -le $fhr_end ]; do
      step=12
      [[ $fhr_start -gt 240 ]]&& step=6
      gfs_ocean_product_group_idx_tail=$(( fhr_start+step ))
      for fhr in $(seq ${fhr_start} 6 ${gfs_ocean_product_group_idx_tail}); do
        echo "Working on event group: $fhr_start"
        fhr_3d=$( printf "%03d" ${fhr} )
        ocean_6hr_avg=${COMIN_OCEAN_HISTORY}/gfs.t${cyc}z.6hr_avg.f${fhr_3d}.nc
        if [ ${array_element_ocean_6hr_avg[$((10#$fhr))]} == "NO" ] && [ ${skip_this_scan} == "NO" ]; then
          echo "Checking on file $ocean_6hr_avg"
          if [ -s ${ocean_6hr_avg} ]; then
            array_element_ocean_6hr_avg[$((10#$fhr))]="YES"
            gfs_ocean_product_group_idx_head_3d=$( printf "%03d" ${fhr_start} )
            gfs_ocean_product_group_idx_tail_3d=$( printf "%03d" ${gfs_ocean_product_group_idx_tail} )
            ecflow_client --event release_gfs_ocean_product_f${gfs_ocean_product_group_idx_head_3d}_f${gfs_ocean_product_group_idx_tail_3d}
          else
            echo "FSM release_gfs_ocean_product is waiting for file: ${ocean_6hr_avg}"
            skip_this_scan="YES"
            scan_release_gfs_ocean_product="YES"
            proceed_trigger_scan="YES"
          fi
        fi
      done
      fhr_start=$(( fhr_start+step+6 ))
    done
  fi

  #### release_gfs_ice_product
  if [ ${scan_release_gfs_ice_product} == "YES" ]; then
    skip_this_scan="NO"
    scan_release_gfs_ice_product="NO"
    echo "Proceeding with scan_release_gfs_ice_product"
    gfs_ice_product_group_idx_head=0
    gfs_ice_product_group_idx_tail=0
    fhr_end=384
    fhr_start=6
    while [ $fhr_start -le $fhr_end ]; do
      step=12
      [[ $fhr_start -gt 240 ]]&& step=6
      gfs_ice_product_group_idx_tail=$(( fhr_start+step ))
      for fhr in $(seq ${fhr_start} 6 ${gfs_ice_product_group_idx_tail}); do
        echo "Working on event group: $fhr_start"
        fhr_3d=$( printf "%03d" ${fhr} )
        ice_6hr_avg=${COMIN_ICE_HISTORY}/gfs.t${cyc}z.6hr_avg.f${fhr_3d}.nc
        if [ ${array_element_ice_6hr_avg[$((10#$fhr))]} == "NO" ] && [ ${skip_this_scan} == "NO" ]; then
          echo "Checking on file $ice_6hr_avg"
          if [ -s ${ice_6hr_avg} ]; then
            array_element_ice_6hr_avg[$((10#$fhr))]="YES"
            gfs_ice_product_group_idx_head_3d=$( printf "%03d" ${fhr_start} ) 
            gfs_ice_product_group_idx_tail_3d=$( printf "%03d" ${gfs_ice_product_group_idx_tail} )
            ecflow_client --event release_gfs_ice_product_f${gfs_ice_product_group_idx_head_3d}_f${gfs_ice_product_group_idx_tail_3d}
          else
            echo "FSM release_gfs_ice_product is waiting for file: ${ice_6hr_avg}"
            skip_this_scan="YES"
            scan_release_gfs_ice_product="YES"
            proceed_trigger_scan="YES"
          fi
        fi
      done
      fhr_start=$(( fhr_start+step+6 ))
    done
  fi

  #### release_gdas_atmos_prep
  if [ ${scan_release_gdas_atmos_prep} == "YES" ]; then
    echo "Proceeding with scan_release_gdas_atmos_prep"
    if [[ -s ${COMINgdasobs}/gdas.t${previous_cycle_cyc}z.updated.status.tm00.bufr_d ]] && [[ -s ${COMINobsproc}/gfs.t${cyc}z.prepbufr ]]; then
      ecflow_client --event release_gdas_atmos_prep
      scan_release_gdas_atmos_prep="NO"
    else
      proceed_trigger_scan="YES"
    fi
  fi

  #### release_gdas_ocean_prepoceanobs
  if [ ${scan_release_gdas_ocean_prepoceanobs} == "YES" ]; then
    skip_this_scan="YES"
    echo "Proceeding with scan_release_gdas_ocean_prepoceanobs"
    COMIN_prep_ocean_obs=${COMROOT}/ocean/gdas.${PDY}/${cyc}/ocean
    for ty_md in adt icec sst insitu; do
      if [[ $(ls ${COMIN_prep_ocean_obs}/${ty_md}/*${ty_md}* | wc -l) -eq 0 ]]; then
        skip_this_scan="NO"
        proceed_trigger_scan="YES"
      fi
    done
    if [ ${skip_this_scan} == "YES" ]; then
      ecflow_client --event release_gdas_ocean_prepoceanobs
      scan_release_gdas_ocean_prepoceanobs="NO"
    fi
  fi

  #### release_gdas_atmos_product
  if [ ${scan_release_gdas_atmos_product} == "YES" ]; then
    skip_this_scan="NO"
    scan_release_gdas_atmos_product="NO"
    echo "Proceeding with scan_release_gdas_atmos_product"
    gfs_atmos_product_group_idx_head=0
    gfs_atmos_product_group_idx_tail=0
    for gfs_atmos_product_group in $(seq 18 18 384); do
      release_event="NO"
      gfs_atmos_product_group_idx_nls=${gfs_atmos_product_group_idx_head}
      gfs_atmos_product_group_idx_head=${gfs_atmos_product_group_idx_tail}
      gfs_atmos_product_group_idx_tail=$(( gfs_atmos_product_group-3 ))
      for fhr in $(seq ${gfs_atmos_product_group_idx_nls} 3 ${gfs_atmos_product_group_idx_tail}); do
        # Looking for file those FHR is the subset group
        fhr_3d=$( printf "%03d" ${fhr} )
        atmos_master=${COMIN_ATMOS_MASTER}/gfs.t${cyc}z.master.f${fhr_3d}.grib2
        if [ ${array_element_atmos_master[$((10#$fhr))]} == "NO" ] && [ ${skip_this_scan} == "NO" ]; then
          # Increase I/O performance by avoid redundant file search
          if [ -s ${atmos_master} ]; then
            # Check for the file and set ecflow event as needed
            array_element_atmos_master[$((10#$fhr))]="YES"
            if [ ${fhr} -eq ${gfs_atmos_product_group_idx_tail} ]; then
              # Release event if all files within the subset group are found
              gfs_atmos_product_group_idx_head_3d=$( printf "%03d" ${gfs_atmos_product_group_idx_head} )
              gfs_atmos_product_group_idx_tail_3d=$( printf "%03d" ${gfs_atmos_product_group_idx_tail} )
              ecflow_client --event release_gdas_atmos_product_f${gfs_atmos_product_group_idx_head_3d}_f${gfs_atmos_product_group_idx_tail_3d}
            fi
          else
            echo "FSM release_gdas_atmos_product is waiting for file: ${atmos_master}"
            # Restart the search if one of the member is not found by skip the rest
            skip_this_scan="YES"
            scan_release_gdas_atmos_product="YES" 
            proceed_trigger_scan="YES"
          fi
        fi
      done
      # Update search group range
      gfs_atmos_product_group_idx_head=$gfs_atmos_product_group
    done
  fi

  #### release_gdas_ocean_wavepostsbs
  if [ ${scan_release_gdas_ocean_wavepostsbs} == "YES" ]; then
    skip_this_scan="NO"
    scan_release_gdas_ocean_wavepostsbs="NO"
    echo "Proceeding with scan_release_gdas_ocean_wavepostsbs"
    gfs_ocean_wavepostsbs_group_idx_head=0
    gfs_ocean_wavepostsbs_group_idx_tail=0
    for gfs_ocean_wavepostsbs_group in $(seq 18 18 384); do
      release_event="NO"
      gfs_ocean_wavepostsbs_group_idx_nls=${gfs_ocean_wavepostsbs_group_idx_head}
      gfs_ocean_wavepostsbs_group_idx_head=${gfs_ocean_wavepostsbs_group_idx_tail}
      gfs_ocean_wavepostsbs_group_idx_tail=$(( gfs_ocean_wavepostsbs_group-3 ))
      for fhr in $(seq ${gfs_ocean_wavepostsbs_group_idx_nls} 3 ${gfs_ocean_wavepostsbs_group_idx_tail}); do
        # Looking for file those FHR is the subset group
        fhr_3d=$( printf "%03d" ${fhr} )
        ocean_uglo_15km=${COMIN_OCEAN_HISTORY}/gfs.t${cyc}z.uglo_15km.f${fhr_3d}.bin
        if [ ${array_element_ocean_uglo_15km[$((10#$fhr))]} == "NO" ] && [ ${skip_this_scan} == "NO" ]; then
          # Increase I/O performance by avoid redundant file search
          if [ -s ${ocean_uglo_15km} ]; then
            # Check for the file and set ecflow event as needed
            array_element_ocean_uglo_15km[$((10#$fhr))]="YES"
            if [ ${fhr} -eq ${gfs_ocean_wavepostsbs_group_idx_tail} ]; then
              # Release event if all files within the subset group are found
              gfs_ocean_wavepostsbs_group_idx_head_3d=$( printf "%03d" ${gfs_ocean_wavepostsbs_group_idx_head} )
              gfs_ocean_wavepostsbs_group_idx_tail_3d=$( printf "%03d" ${gfs_ocean_wavepostsbs_group_idx_tail} )
              ecflow_client --event release_gdas_ocean_wavepostsbs_f${gfs_ocean_wavepostsbs_group_idx_head_3d}_f${gfs_ocean_wavepostsbs_group_idx_tail_3d}
            fi
          else
            echo "FSM release_gdas_ocean_wavepostsbs is waiting for file: ${ocean_uglo_15km}"
            # Restart the search if one of the member is not found by skip the rest
            skip_this_scan="YES"
            scan_release_gdas_ocean_wavepostsbs="YES"
            proceed_trigger_scan="YES"
          fi
        fi
      done
      # Update search group range
      gfs_ocean_wavepostsbs_group_idx_head=$gfs_ocean_wavepostsbs_group
    done
  fi
  [[ ${proceed_trigger_scan} == "YES" ]]&& sleep 30
done		# proceed_trigger_scan



exit 0
