suite gfs_v17_nco
  family primary
    edit gfs_ver 'v17.0'
    edit PACKAGEHOME '/lfs/h3/emc/eib/noscrub/%EMC_USER%/gfs/para/packages/gfs.%gfs_ver%'
    edit NET 'gfs'
    edit RUN 'gfs'
    edit PROJ 'GFS'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'development'
    edit ENVIR 'prod'
    edit QUEUE 'devmax'
    edit QUEUE_ARCH 'dev_transfer'
    edit OUTPUTDIR '/lfs/h3/emc/eib/noscrub/ptmp/%EMC_USER%/ecflow_gfs/para/output/prod/today'
    edit EXPDIR '/lfs/h3/emc/eib/noscrub/%EMC_USER%/gfs/para/packages/gfs.%gfs_ver%/parm/config/gfs' 
    family 00
      edit CYC '00'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_tropcy_qc_reloc
              #event 1 jtwc_bull_email
              trigger :TIME >= 0241 and :TIME < 0245
            task jgfs_atmos_emcsfc_sfc_prep
              #NCO/Ops should use obsproc trigger.  Time trigger is a workaround for development
              #trigger /gfs_v17_0/primary/00/obsproc/v1.3/gfs/atmos/dump/jobsproc_gfs_atmos_dump:release_sfcprep
              trigger :TIME >= 0307 and :TIME < 0312
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_obs_bufr_dump
              # TODO make this trigger off of obsproc dump job completion
              trigger :TIME >= 0307 and :TIME < 0312
            task jgfs_marine_obs_dump
              # this should start when the obsproc job starts
              trigger :TIME >= 0245 and :TIME < 0630
          endfamily		//marine
        endfamily		//prep
        family init
          family wave
            edit WGF 'wave'
            task jgfs_wave_init
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/00/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
          endfamily		//wave
        endfamily		//init
        family analysis
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_anal
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger  /gfs_v17_0/primary/00/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete and  ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete and ../../../../18/enkfgdas/ensstat==complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete and ../../../../18/enkfgdas/ensstat==complete and ../../../../18/gdas/forecast==complete
            task jgfs_atmos_anal_sfc_gcycle
              trigger jgfs_atmos_anal==complete and ../snow/jgfs_atmos_analsnow==complete
            task jgfs_atmos_anal_calc
              trigger jgfs_atmos_anal_sfc_gcycle==complete
            task jgfs_atmos_analupp
              trigger jgfs_atmos_anal_calc==complete
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_bmat_init
              # TODO make this trigger off of obsproc dump job completion
              trigger ../../prep/marine/jgfs_marine_obs_dump==complete and ../../../../18/enkfgdas/forecast==complete and ../../../../18/gdas/forecast==complete
            task jgfs_marine_bmat
              trigger jgfs_marine_bmat_init==complete
            task jgfs_marine_anal_init
              trigger jgfs_marine_bmat==complete and ../../prep/marine/jgfs_marine_obs_dump==complete and ../../prep/marine/jgfs_marine_obs_bufr_dump==complete
            task jgfs_marine_analvar
              trigger jgfs_marine_anal_init==complete
            task jgfs_marine_analchkpt
              trigger jgfs_marine_analvar==complete
            task jgfs_marine_analfinal
              trigger jgfs_marine_analchkpt==complete
          endfamily		//marine
          family snow
            edit WGF 'snow'
            task jgfs_atmos_analsnow
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/00/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete and ../../../../18/gdas/forecast/jgdas_fcst==complete 
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete and ../../../../18/gdas/forecast/jgdas_fcst==complete 
          endfamily		//snow
        endfamily		//analysis
        family forecast
          task jgfs_fcst_fsm
            edit RJN 'forecast'
            trigger jgfs_fcst==active or jgfs_fcst==complete
            event 100 release_gfs_atmos_product_f000
            event 101 release_gfs_atmos_product_f001
            event 102 release_gfs_atmos_product_f002
            event 103 release_gfs_atmos_product_f003
