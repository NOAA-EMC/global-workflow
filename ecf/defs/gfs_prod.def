              #trigger /gfs_v17_0/primary/18/obsproc/v1.3/gdas/atmos/dump/jobsproc_gdas_atmos_dump:release_sfcprep
              trigger :TIME >= 0010 and :TIME < 0015
          endfamily  		//atmos
          family marine
            edit WGF 'marine'
            task jgdas_marine_obs_bufr_dump
              #TODO NCO/OPS should use obsproc completion trigger
              trigger :TIME >= 0010 and :TIME < 0015 
            task jgdas_marine_obs_dump
              # this should start when the obsproc job starts
              trigger :TIME >= 2345 or :TIME < 0030
          endfamily  		//marine
        endfamily    		//prep
        family init
          family wave
            edit WGF 'wave'
            task jgdas_wave_init
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/18/obsproc/v1.3/gdas/atmos/prep/jobsproc_gdas_atmos_prep == complete
