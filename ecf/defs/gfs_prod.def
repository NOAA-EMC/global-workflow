          endfamily		//atmos
        endfamily		//verf
      endfamily			//gfs
      family gdas
        edit RUN 'gdas'
        family prep
          family atmos
            edit WGF 'atmos'
            task jgdas_atmos_tropcy_qc_reloc
              trigger :TIME >= 1145 and :TIME < 1150
            task jgdas_atmos_emcsfc_sfc_prep
              #NCO/Ops should use obsproc trigger.  Time trigger is a workaround for development
              #trigger /gfs_v17_0/primary/06/obsproc/v1.3/gdas/atmos/dump/jobsproc_gdas_atmos_dump:release_sfcprep
              trigger :TIME >= 1210 and :TIME < 1215
          endfamily  		//atmos
          family marine
            edit WGF 'marine'
            task jgdas_marine_obs_bufr_dump
              #NCO/Ops should use obsproc trigger.  Time trigger is a workaround for development
              trigger :TIME >= 1210 and :TIME < 1215 
            task jgdas_marine_obs_dump
              trigger :TIME >= 1145 and :TIME < 1230
          endfamily  		//marine
        endfamily    		//prep
        family init
          family wave
            edit WGF 'wave'
            task jgdas_wave_init
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/06/obsproc/v1.3/gdas/atmos/prep/jobsproc_gdas_atmos_prep == complete
              trigger ../../prep/atmos/jgdas_atmos_emcsfc_sfc_prep==complete
          endfamily  		//wave
        endfamily    		//init
        family analysis
          family atmos
            task jgdas_atmos_anal
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/06/obsproc/v1.3/gdas/atmos/prep/jobsproc_gdas_atmos_prep == complete and ../../prep/atmos/jgdas_atmos_emcsfc_sfc_prep == complete and ../../../../00/enkfgdas/ensstat==complete
              trigger ../../prep/atmos/jgdas_atmos_emcsfc_sfc_prep==complete and ../../../../00/enkfgdas/ensstat==complete and ../../../../00/gdas/forecast==complete
            task jgdas_atmos_analdiag
              trigger jgdas_atmos_anal==complete
            task jgdas_atmos_anal_wdqms
              trigger jgdas_atmos_analdiag==complete
            task jgdas_atmos_anal_sfc_regrid
              trigger ../../../enkfgdas/analysis/create/jenkfgdas_atmos_ens_update==complete
            task jgdas_atmos_anal_sfc_gcycle
              trigger jgdas_atmos_anal==complete and ../snow/jgdas_atmos_analsnow==complete
            task jgdas_atmos_anal_calc
              trigger jgdas_atmos_anal_sfc_regrid==complete and jgdas_atmos_anal_sfc_gcycle==complete and ../../../../00/enkfgdas/analysis/create/jenkfgdas_change_res_ens==complete
            task jgdas_atmos_analupp
              trigger jgdas_atmos_anal_calc==complete
          endfamily  		//atmos
          family marine
            edit WGF 'marine'
            task jgdas_marine_bmat_init
              # TODO make this trigger off of obsproc dump job completion
              trigger ../../prep/marine/jgdas_marine_obs_dump==complete and ../../../../00/enkfgdas/forecast==complete and ../../../../00/gdas/forecast==complete
            task jgdas_marine_bmat
              trigger jgdas_marine_bmat_init==complete
            task jgdas_marine_anal_init
              trigger jgdas_marine_bmat==complete and ../../prep/marine/jgdas_marine_obs_dump==complete and ../../prep/marine/jgdas_marine_obs_bufr_dump==complete
            task jgdas_marine_analvar
              trigger jgdas_marine_anal_init==complete
            task jgdas_marine_analchkpt
              trigger jgdas_marine_analvar==complete and ../../../enkfgdas/analysis/recenter/jenkfgdas_marine_ens_recenter==complete
            task jgdas_marine_analfinal
              trigger jgdas_marine_analchkpt==complete
          endfamily  		//marine
          family snow
            edit WGF 'snow'
            task jgdas_atmos_analsnow
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/06/obsproc/v1.3/gdas/atmos/prep/jobsproc_gdas_atmos_prep == complete and ../../../../00/gdas/forecast/jgdas_fcst==complete 
              trigger ../../prep/atmos/jgdas_atmos_emcsfc_sfc_prep==complete and ../../../../00/gdas/forecast/jgdas_fcst==complete 
          endfamily  		//snow
        endfamily    		//analysis
        family forecast
          task jgdas_fcst_fsm
            edit RJN 'forecast'
            trigger jgdas_fcst==active or jgdas_fcst==complete
            event 100 release_gdas_atmos_product_f000
            event 101 release_gdas_atmos_product_f001
            event 102 release_gdas_atmos_product_f002
            event 103 release_gdas_atmos_product_f003
            event 104 release_gdas_atmos_product_f004
            event 105 release_gdas_atmos_product_f005
            event 106 release_gdas_atmos_product_f006
            event 107 release_gdas_atmos_product_f007
