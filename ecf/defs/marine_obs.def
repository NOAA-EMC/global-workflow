suite marine_obs 
  family primary
    edit EMC_USER 'cory.r.martin'
    edit gfs_ver 'v17.0'
    edit PACKAGEHOME '/lfs/h2/emc/da/noscrub/cory.r.martin/gfsv17/git/global-workflow'
    edit NET 'gfs'
    edit RUN 'gfs'
    edit PROJ 'GFS'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'development'
    edit ENVIR 'para'
    edit QUEUE 'dev'
    edit QUEUE_ARCH 'dev_transfer'
    edit OUTPUTDIR '/lfs/h2/emc/ptmp/%EMC_USER%/ecflow_gfs/para/output/prod/today'
    edit DATAROOT '/lfs/h2/emc/ptmp/cory.r.martin/gfs/dataroot'
    edit ECF_INCLUDE '/lfs/h2/emc/da/noscrub/cory.r.martin/gfsv17/git/global-workflow/ecf/include'
    family 00
      edit CYC '00'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gfs/prep/marine'
            task jgfs_marine_obs_dump
              trigger :TIME >= 0245 and :TIME < 0630
            task jgfs_marine_obs_bufr_dump
              trigger :TIME >= 0300 and :TIME < 0630
          endfamily		//marine
        endfamily		//prep
      endfamily			//gfs
      family gdas
        edit RUN 'gdas'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gdas/prep/marine'
            task jgdas_marine_obs_dump
              trigger :TIME >= 0545 and :TIME < 0630
            task jgdas_marine_obs_bufr_dump
              trigger :TIME >= 0600 and :TIME < 0630
          endfamily		//marine
        endfamily		//prep
      endfamily
    endfamily			//00
    family 06
      edit CYC '06'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gfs/prep/marine'
            task jgfs_marine_obs_dump
              trigger :TIME >= 0845 and :TIME < 1230
            task jgfs_marine_obs_bufr_dump
              trigger :TIME >= 0900 and :TIME < 1230
          endfamily		//marine
        endfamily		//prep
      endfamily			//gfs
      family gdas
        edit RUN 'gdas'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gdas/prep/marine'
            task jgdas_marine_obs_dump
              trigger :TIME >= 1145 and :TIME < 1230
            task jgdas_marine_obs_bufr_dump
              trigger :TIME >= 1200 and :TIME < 1230
          endfamily		//marine
        endfamily		//prep
      endfamily
    endfamily			//06
    family 12
      edit CYC '12'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gfs/prep/marine'
            task jgfs_marine_obs_dump
              trigger :TIME >= 1445 and :TIME < 1830
            task jgfs_marine_obs_bufr_dump
              trigger :TIME >= 1500 and :TIME < 1830
          endfamily		//marine
        endfamily		//prep
      endfamily			//gfs
      family gdas
        edit RUN 'gdas'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gdas/prep/marine'
            task jgdas_marine_obs_dump
              trigger :TIME >= 1745 and :TIME < 1830
            task jgdas_marine_obs_bufr_dump
              trigger :TIME >= 1800 and :TIME < 1830
          endfamily		//marine
        endfamily		//prep
      endfamily
    endfamily			//12
    family 18
      edit CYC '18'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gfs/prep/marine'
            task jgfs_marine_obs_dump
              trigger :TIME >= 2045 or :TIME < 0030
            task jgfs_marine_obs_bufr_dump
              trigger :TIME >= 2100 or :TIME < 0030
          endfamily		//marine
        endfamily		//prep
      endfamily			//gfs
      family gdas
        edit RUN 'gdas'
        family prep
          family marine
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gdas/prep/marine'
            task jgdas_marine_obs_dump
              trigger :TIME >= 2345 or :TIME < 0030
            task jgdas_marine_obs_bufr_dump
              trigger :TIME >= 0000 and :TIME < 0030
          endfamily		//marine
        endfamily		//prep
      endfamily
    endfamily			//18
  endfamily			//primary
endsuite			//gfs_v17_0
