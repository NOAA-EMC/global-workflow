suite gcafs_v1
  family primary
    edit PACKAGEHOME '/lfs/h2/emc/da/noscrub/cory.r.martin/gcafs/git/release/gcafs.v1.0.0'
    edit OUTPUTDIR '/lfs/h2/emc/ptmp/cory.r.martin/gcafs/output'
    edit gcafs_ver 'v1.0.0'
    edit QUEUE 'dev'
    edit QUEUE_ARCH 'dev_transfer'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'development'
    edit ENVIR 'para'
    edit EXPDIR '%PACKAGEHOME%/parm/config/gcafs'
    edit COMROOT '/lfs/h2/emc/ptmp/cory.r.martin/gcafs/com'
    edit DATAROOT '/lfs/h2/emc/ptmp/cory.r.martin/gcafs/dataroot'
    edit ECF_INCLUDE '/lfs/h2/emc/da/noscrub/cory.r.martin/gcafs/git/release/gcafs.v1.0.0/ecf/include'
    family 00
      edit CYC '00'
      family gcafs
        edit NET 'gcafs'
        edit PROJ 'GCAFS'
        family v1.0
          family gcdas
            edit RUN 'gcdas'
            edit ECF_FILES '%PACKAGEHOME%/ecf/scripts/gcdas'
            family atmos
              family init
                task jgcdas_atmos_initialize
                  # TODO trigger gdas analysis == complete
                  time 07:00
                task jgcdas_surface_initialize
                  trigger ./jgcdas_atmos_initialize == complete and ../../chem/analysis/jgcdas_prepare_obs == complete
              endfamily
              family post
                task jgcdas_atmos_post_manager
                  trigger ../../jgcdas_forecast == active
                  event 1 release_postanl
                  event 2 release_post000
                  event 3 release_post003
                  event 4 release_post006
                  event 5 release_post009
                task jgcdas_atmos_post_anl
                  trigger ./jgcdas_atmos_post_manager:release_postanl
                  edit FORECAST_HOUR '-3'
		  edit FHRGRP '000'
                  edit FHRLST 'anl'
                  edit HR 'anl'
                  edit FHR 'anl'
                task jgcdas_atmos_post_f000
                  trigger ./jgcdas_atmos_post_manager:release_post000
                  edit FORECAST_HOUR '0'
		  edit FHR 'f000'
                  edit HR '000'
                  edit FHRGRP '001'
                  edit FHRLST 'f000'
                task jgcdas_atmos_post_f003
                  trigger ./jgcdas_atmos_post_manager:release_post003
                  edit FORECAST_HOUR '3'
		  edit FHR 'f003'
                  edit HR '003'
                  edit FHRGRP '002'
                  edit FHRLST 'f003'
                task jgcdas_atmos_post_f006
                  trigger ./jgcdas_atmos_post_manager:release_post006
                  edit FORECAST_HOUR '6'
		  edit FHR 'f006'
                  edit HR '006'
                  edit FHRGRP '003'
                  edit FHRLST 'f006'
                task jgcdas_atmos_post_f009
