            task jenkfgdas_eupd
              trigger ../recenter/ecen/jenkfgdas_ediag==complete
          endfamily		//create
          family recenter
            family ecen
              task jenkfgdas_marineanlecen
                trigger ../../../../gdas/init/marine/jgdas_marine_bmat_init==complete
              task jenkfgdas_esnowanl
                trigger ../../../../gdas/prep/atmos/jgdas_atmos_prep==complete and /emc_dev/gfs_v17_0/primary/18/enkfgdas/post==complete
              task jenkfgdas_ediag
                trigger ../../create/jenkfgdas_eobs==complete
              task jenkfgdas_ecen000
                trigger ../../create/jenkfgdas_eupd==complete and ../../../../gdas/analysis/atmos/jgdas_atmos_analcalc==complete
                edit FHRGRP '000'
                edit FHRLST '003'
              task jenkfgdas_ecen001
                trigger ../../create/jenkfgdas_eupd==complete and ../../../../gdas/analysis/atmos/jgdas_atmos_analcalc==complete
                edit FHRGRP '001'
                edit FHRLST '006'
              task jenkfgdas_ecen002
                trigger ../../create/jenkfgdas_eupd==complete and ../../../../gdas/analysis/atmos/jgdas_atmos_analcalc==complete
                edit FHRGRP '002'
                edit FHRLST '009'
              task jenkfgdas_echgres
                trigger ../../../../gdas/forecast/jgdas_fcst==complete and ../../../forecast/jenkfgdas_fcst_mem001==complete
            endfamily	//ecen
            task jenkfgdas_esfc
              trigger ecen/jenkfgdas_esnowanl==complete and ../create/jenkfgdas_eupd==complete and ../../../gdas/analysis/atmos/jgdas_atmos_analcalc==complete
          endfamily		//recenter
