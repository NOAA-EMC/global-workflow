extern /emc_dev/gfs_v17_0/primary/18/gdas/forecast/jgdas_fcst
extern /emc_dev/gfs_v17_0/primary/18/enkfgdas/post
extern /emc_dev/gfs_v17_0/primary/18/gdas/product/atmos
extern /emc_dev/gfs_v17_0/primary/18/enkfgdas/forecast
extern /emc_dev/gfs_v17_0/primary/18/enkfgdas/analysis/recenter/ecen/jenkfgdas_echgres

suite gfs_v17_0_d1
  family primary
    edit gfs_ver 'v17.0'
    edit PACKAGEHOME '/lfs/h3/emc/eib/noscrub/%EMC_USER%/gfs/para/packages/gfs.%gfs_ver%'
    edit NET 'gfs'
    edit RUN 'gfs'
    edit PROJ 'GFS'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'development'
    edit ENVIR 'prod'
    edit QUEUE 'devhigh'
    edit QUEUE_ARCH 'dev_transfer'
    edit OUTPUTDIR '/lfs/h3/emc/eib/noscrub/ptmp/%EMC_USER%/ecflow_gfs/para/output/prod/today'
    family 00
      edit CYC '00'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_prep_fsm
              edit RJN 'prep'
              trigger :TIME >= 0300 and :TIME < 0330
              event 1 release_gfs_atmos_prep
            task jgfs_atmos_prep
              trigger jgfs_atmos_prep_fsm:release_gfs_atmos_prep and /emc_dev/gfs_v17_0/primary/18/gdas/forecast/jgdas_fcst==complete and /emc_dev/gfs_v17_0/primary/18/gdas/product/atmos==complete
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_prep_fsm
              edit RJN 'prep'
              trigger :TIME >= 0300 and :TIME < 0330
              event 1 release_gfs_marine_prepoceanobs
            task jgfs_marine_prepoceanobs
              trigger jgfs_marine_prep_fsm:release_gfs_marine_prepoceanobs
          endfamily		//marine
        endfamily		//prep
        family init
          family marine
            edit WGF 'marine'
            task jgfs_marine_bmat_init
              trigger /emc_dev/gfs_v17_0/primary/18/gdas/forecast/jgdas_fcst==complete and /emc_dev/gfs_v17_0/primary/18/enkfgdas/forecast==complete
            task jgfs_marine_bmat
              trigger jgfs_marine_bmat_init==complete
            task jgfs_marine_anl_init
              trigger jgfs_marine_bmat==complete and ../../prep/marine/jgfs_marine_prepoceanobs==complete
          endfamily		//marine
          family wave
            edit WGF 'wave'
            task jgfs_wave_init
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
          endfamily		//wave
        endfamily		//init
        family analysis
          family atmos
           edit WGF 'atmos'
            task jgfs_atmos_anal
              trigger ../../prep/atmos/jgfs_atmos_prep==complete and /emc_dev/gfs_v17_0/primary/18/enkfgdas/post==complete
            task jgfs_atmos_sfcanl
              trigger jgfs_atmos_anal==complete and ../snow/jgfs_atmos_snowanl==complete
            task jgfs_atmos_analcalc
              trigger jgfs_atmos_sfcanl==complete
            task jgfs_atmos_atmanlupp
              trigger jgfs_atmos_analcalc==complete
            task jgfs_atmos_atmanlprod
              trigger jgfs_atmos_atmanlupp==complete
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_anlvar
              trigger ../../init/marine/jgfs_marine_anl_init==complete
            task jgfs_marine_anlchkpt
              trigger jgfs_marine_anlvar==complete
            task jgfs_marine_anlfinal
              trigger jgfs_marine_anlchkpt==complete
          endfamily		//marine
          family snow
            edit WGF 'snow'
            task jgfs_atmos_snowanl
              trigger ../../prep/atmos/jgfs_atmos_prep==complete
          endfamily		//snow
        endfamily		//analysis
        family forecast
          task jgfs_fcst_fsm
