#PBS -S /bin/bash
#PBS -N gdas_verfozn_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=1:ompthreads=1:ncpus=1:mem=1G
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh gsi

module list
############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}

#### ${HOMEgfs}/dev/job_cards/rocoto/verfozn.sh
${HOMEgfs}/jobs/JGDAS_ATMOS_VERFOZN
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

%end

