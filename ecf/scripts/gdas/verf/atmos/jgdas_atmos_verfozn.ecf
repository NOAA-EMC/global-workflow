#PBS -S /bin/bash
#PBS -N gdas_atmos_verfozn_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=1:ompthreads=1:ncpus=1:mem=1G
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load libjpeg/${libjpeg_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load grib_util/${grib_util_ver}
module load util_shared/${util_shared_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGDAS_ATMOS_VERFOZN
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_verfozn

PURPOSE: Archives ozone-related analysis diagnostics from GDAS GSI for time-
series monitoring. GDAS-specific (no GFS counterpart).

TROUBLESHOOTING

Depends on GDAS analysis diagnostic output (ozstat files). If analysis
or analdiag did not produce ozone diagnostics, verfozn has no input.
Non-critical -- failure does not block downstream. Check that
cnvstat/radstat/ozstat files exist in COMOUT.

%end
