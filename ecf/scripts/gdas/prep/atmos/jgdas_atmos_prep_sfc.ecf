#PBS -S /bin/bash
#PBS -N %RUN%_atmos_prep_sfc_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:08:00
#PBS -l select=1:ncpus=1:mem=10GB
#PBS -l place=vscatter
#PBS -l debug=true

model=gfs
%include <head.h>
%include <envir-p1.h>

set -x

export NET=%NET:gfs%
export RUN=%RUN%
export CDUMP=%RUN%

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load wgrib2/${wgrib2_ver}

module list

export cyc=%CYC%
export cycle=t%CYC%z

############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_ATMOS_PREP_SFC

if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_prep_sfc

PURPOSE: Computes global blended ice and snow analyses.

TROUBLESHOOTING

Reads data from IMS and AFWA. Calls a utility script for each of 
the ice and snow analyses. If external data is missing or if
another error in the utility script occurs, a non-zero exit code 
is produced and the job will copy the previous cycles output.
This is non-fatal and cycling can continue, but errors should
be investigated by developers. 

%end
