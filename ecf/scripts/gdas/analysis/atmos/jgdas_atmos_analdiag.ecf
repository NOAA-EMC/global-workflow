#PBS -S /bin/bash
#PBS -N gdas_atmos_analdiag_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=48GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module use /apps/dev/modulefiles
module load ve/gw/${gw_ve_ver}

module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load ncdiag-A/${ncdiag_ver}
module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/analdiag.sh
${HOMEgfs}/jobs/JGLOBAL_ATMOS_ANALYSIS_DIAG
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_analdiag

PURPOSE: Creates NetCDF diagnostic files (cnvstat, radstat, ozstat) from the GDAS
GSI analysis. GDAS-specific task.

TROUBLESHOOTING

Depends on successful GDAS analysis. If analysis failed, no diagnostics
to produce. Relatively simple job -- check that GSI diagnostic output directories
containing netCDF files exist. Feeds verfozn and verfrad downstream. Non-blocking
for forecast path.

%end
