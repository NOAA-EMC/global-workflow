#PBS -S /bin/bash
#PBS -N gdas_atmos_anal_calc_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=500GB
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh gsi

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/analcalc.sh
${HOMEgfs}/jobs/JGLOBAL_ATMOS_ANALYSIS_CALC
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_anal_calc

PURPOSE: GDAS analysis calc -- applies increments to produce full analysis
fields for products

TROUBLESHOOTING

Same troubleshooting as GFS analcalc. Depends on successful GDAS
analysis completion.

%end
