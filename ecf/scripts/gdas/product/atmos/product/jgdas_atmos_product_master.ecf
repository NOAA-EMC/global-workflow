#PBS -S /bin/bash
#PBS -N gdas_atmos_product_%CYC%_f%FHR%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=1:mpiprocs=24:ompthreads=1:ncpus=24
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh run

module list
############################################################
# CALL executable job script here
############################################################
export WGF="%WGF%"
export FHR_LIST="%FHR_LIST%"
export FORECAST_HOUR="${FHR_LIST}"
export HOMEglobal=${HOMEgfs}
export COMPONENT=${WGF}

#### ${HOMEgfs}/dev/job_cards/rocoto/atmos_products.sh
${HOMEgfs}/jobs/JGLOBAL_ATMOS_PRODUCTS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_product_master

PURPOSE: GDAS atmospheric product generation -- per-hour _master producing GRIB2
from GDAS 9-hour forecast. Same shared J-Job.

TROUBLESHOOTING

Same troubleshooting as GFS atmos_product_master. GDAS produces products
for f000-f009 only (vs GFS f000-f384). Check forecast output (atmos master files)
availability.

%end
