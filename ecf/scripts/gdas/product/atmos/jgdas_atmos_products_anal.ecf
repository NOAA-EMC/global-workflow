#PBS -S /bin/bash
#PBS -N gdas_atmos_products_anal_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=1:mpiprocs=24:ompthreads=1:ncpus=24
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load wgrib2/${wgrib2_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}
export FORECAST_HOUR='-1'
export FHR_LIST='-1'

${HOMEgfs}/jobs/JGLOBAL_ATMOS_PRODUCTS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_products_anal

PURPOSE: GDAS analysis product generation. On disk as jgdas_atmos_analprod.ecf --
name differs from manifest.

TROUBLESHOOTING

Depends on GDAS analysis output (atmos master files). Verify that these files are present and valid (${COMgfs}/gdas.${PDY}/${cyc}/analysis/atmos/gdas.t${cyc}z.master.analysis.grib2).

%end
