#PBS -S /bin/bash
#PBS -N gdas_atmos_gempak_meta_ncdc_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:05:00
#PBS -l select=1:mpiprocs=2:ompthreads=1:ncpus=2:mem=4GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh run

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/gempakmetancdc.sh
${HOMEgfs}/jobs/JGDAS_ATMOS_GEMPAK_META_NCDC
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_atmos_gempak_meta_ncdc

PURPOSE: Generates GEMPAK metafiles and NCDC archival products from GDAS output.
Single-instance per cycle.

TROUBLESHOOTING

Depends on GDAS GEMPAK grid files from gempak_master. If those are
missing, metafile generation fails. Lightweight job. Non-critical for
operations -- primarily archival.

%end
