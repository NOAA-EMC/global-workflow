#PBS -S /bin/bash
#PBS -N gdas_fcst_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=01:50:00
#PBS -l select=95:mpiprocs=128:ompthreads=1:ncpus=128
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cmake/${cmake_ver}
module load jasper/${jasper_ver}
module load zlib/${zlib_ver}
module load libpng/${libpng_ver}
module load hdf5-D/${hdf5_ver}
module load netcdf-D/${netcdf_ver}
module load pio-D/${pio_ver}
module load esmf-D/${esmf_ver}
module load fms-D/${fms_ver}
module load bacio/${bacio_ver}
module load crtm/${crtm_ver}
module load g2/${g2_ver}
module load g2tmpl/${g2tmpl_ver}
module load ip/${ip_ver}
module load sp/${sp_ver}
module load w3emc/${w3emc_ver}
module load gftl-shared/${gftl_shared_ver}
module load mapl-D/${mapl_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load scotch/${scotch_ver}
module load zstd/${zstd_ver}
module load cfp/${cfp_ver}
module load libjpeg/${libjpeg_ver}
module load craype-network-ucx
module load cray-mpich-ucx
module load python/${python_ver}
module load wgrib2/${wgrib2_ver}
module use /apps/dev/modulefiles
module load ve/gw/${gw_ve_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}
export FCST_SEGMENT='0'
#### ${HOMEgfs}/dev/job_cards/rocoto/fcst.sh
${HOMEgfs}/jobs/JGLOBAL_FORECAST
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gdas_fcst

PURPOSE: Runs the 9-hour coupled UFS Weather Model GDAS deterministic forecast.
95 nodes = 12160 MPI ranks. Provides background for next cycle analysis.

TROUBLESHOOTING

Four of many possible causes are listed below:
1. Numerical/Model Instability (NaNs, CFL violations, or massive/unrealistic values for temp/wind in log files).
2. MPI/Infrastructure Errors (downed compute nodes, interconnect failures).
3. Missing Restart/Initial Condition files.
4. Walltime Exceeded.

DIAGNOSTIC STEPS:
- Check the model stdout and job log for "FATAL" or "ERROR" string messages.
- Review compute node status to rule out system hardware failures.
- If the model blows up immediately (F000-F006), verify the quality of the incoming DA analysis.

ACTIONS FOR INSTABILITY:

A. ATMOSPHERIC MODEL INSTABILITY:
If log files indicate the atmosphere is blowing up due to numerical instability in the atmospheric model (see item 1 above), try reducing the atmospheric time step proportionally and restart.
To modify:
  1. Open parm/config/gfs/config.ufs in the gfsv17 package.
  2. Locate the ${fv3_res}=C786 case section.
  3. Modify the step value (DELTIM) downward from its default setting:
     export DELTIM=120  

B. OCEAN MODEL INSTABILITY (MOM6):
If the logfile shows "btstep: eta has dropped below bathyT" warnings or ocean CFL crashes, mitigate this by reducing the ocean thermal/dynamics step.
To modify:
  1. Open parm/config/gfs/config.ufs in the gfsv17 package.
  2. Locate the "MOM6 specific settings" section for case ${mom6_res}=025.
  3. Reduce the time step values from 1800 to 900:
     OCNTIM=900
     DT_THERM_MOM6='900'

%end
