#PBS -S /bin/bash
#PBS -N enkfgdas_fcst_%CYC%_mem%ENSMEM%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l select=8:mpiprocs=128:ompthreads=1:ncpus=128
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufswm

module list
############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}
export HOMEglobal=${HOMEgfs}
export WGF="%WGF%"
export ENSMEM="%ENSMEM%"
export MEMDIR="%MEMDIR%"

#### ${HOMEgfs}/dev/job_cards/rocoto/fcst.sh
${HOMEgfs}/jobs/JGLOBAL_FORECAST
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_fcst_master

PURPOSE: EnKF ensemble member forecast -- runs 9-hour coupled UFS for a single
ensemble member. 8 nodes per member. Per-member _master template (80
members).

TROUBLESHOOTING

Same UFS model as deterministic but lower resolution and without wave coupling. 
check model stdout for that ENSMEM. MPI errors, node failures, or model
instability. If multiple members fail simultaneously, suspect systemic
issue (filesystem, interconnect). Individual member failures are
tolerable if enough members complete for EnKF update.

%end
