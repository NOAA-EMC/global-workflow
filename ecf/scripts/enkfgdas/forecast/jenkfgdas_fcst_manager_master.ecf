#PBS -S /bin/bash
#PBS -N enkfgdas_fcst_manager_%CYC%_mem%ENSMEM%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:45:00
### Note, the exact number of CPUs will need to be fine tuned.
#PBS -l select=1:ncpus=14:ompthreads=1:mem=20GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
export USE_CFP=YES

module list
############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}
export HOMEglobal=${HOMEgfs}
export ENSMEM="%ENSMEM%"
export MEMDIR="%MEMDIR%"
export FCST_SEGMENT='0'

${HOMEglobal}/jobs/JGLOBAL_FCST_MANAGER
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

%end
