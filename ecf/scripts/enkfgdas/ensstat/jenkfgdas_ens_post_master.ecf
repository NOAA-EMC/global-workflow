#PBS -S /bin/bash
#PBS -N enkfgdas_ens_post%FHRGRP%_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:35:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=500GB
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
export USE_CFP=YES
module load python/${python_ver}
module load ve/gfs/${ve_gfs_ver}
module load gempak/${gempak_ver}
module load perl/${perl_ver}
module load libjpeg/${libjpeg_ver}
module load udunits/${udunits_ver}
module load gsl/${gsl_ver}
module load cdo/${cdo_ver}
module load imagemagick/${imagemagick_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load esmf-D/${esmf_ver}
module load nco/${nco_ver}
module load grib_util/${grib_util_ver}
module load bufr_dump/${bufr_dump_ver}
module load util_shared/${util_shared_ver}
module load g2tmpl/${g2tmpl_ver}
module load ncdiag-A/${ncdiag_ver}
module load crtm/${crtm_ver}
module load wgrib2/${wgrib2_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}
export WGF="%WGF%"
export FHRGRP="%FHRGRP%"
export FHRLST="%FHRLST%"
export FHMIN_EPOS="%FHR%"
export FHMAX_EPOS="%FHR%"
export FHOUT_EPOS="%FHR%"

#### ${HOMEgfs}/dev/job_cards/rocoto/epos.sh
${HOMEgfs}/jobs/JGDAS_ENKF_POST
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_ens_post_master

PURPOSE: EnKF ensemble post -- generates ensemble mean and spread from all member
forecasts. Per-hour-group _master template.

TROUBLESHOOTING

Depends on ALL ensemble member forecasts completing. If too many members
failed, ensemble statistics are unreliable. Check which members
completed. High memory (500 GB) -- OOM possible. If only a few members
missing, may still produce usable output with reduced ensemble size.

%end
