#PBS -S /bin/bash
#PBS -N enkfgdas_atmos_ens_anal_sfc_gcycle_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=01:00:00
#PBS -l select=2:mpiprocs=64:ompthreads=1:ncpus=64
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load python/${python_ver}
module load libjpeg/${libjpeg_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load grib_util/${grib_util_ver}
module load ncdiag-A/${ncdiag_ver}
module load crtm/${crtm_ver}
module load ve/gfs/${ve_gfs_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_ATMOS_ENS_ANAL_SFC_GCYCLE
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_atmos_ens_anal_sfc_gcycle

PURPOSE: EnKF ensemble surface analysis -- runs global_cycle on ensemble member
tiles to update SST, sea ice, soil, vegetation per member.

TROUBLESHOOTING

Depends on observation data and previous cycle ensemble surface fields.
If obs data is missing, GCycle may use degraded data with warnings.
Check global_cycle stdout for per-member errors. Individual member
failures do not block other members.

%end
