#PBS -S /bin/bash
#PBS -N enkfgdas_atmos_ens_anal_sfc_gcycle_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=01:00:00
#PBS -l select=2:mpiprocs=64:ompthreads=1:ncpus=64
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh gsi

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/esfc.sh
${HOMEgfs}/jobs/JGLOBAL_ENKF_SFC_GCYCLE
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_atmos_ens_anal_sfc_gcycle

PURPOSE: EnKF ensemble surface analysis -- runs global_cycle on ensemble member
tiles to update SST, sea ice, soil, vegetation per member.

TROUBLESHOOTING

Depends on observation data and previous cycle ensemble surface fields.
If obs data is missing, GCycle may use degraded data with warnings.
Check global_cycle stdout for per-member errors. Individual member
failures do not block other members.

%end
