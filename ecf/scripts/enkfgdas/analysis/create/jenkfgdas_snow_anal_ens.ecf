#PBS -S /bin/bash
#PBS -N enkfgdas_snow_anal_ens_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:50:00
#PBS -l select=4:mpiprocs=64:ompthreads=2:ncpus=128
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load intel/${intel_ver}
module load craype/${craype_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load zstd/${zstd_ver}
module load pigz/${pigz_ver}
module load curl/${curl_ver}
module load hdf5-D/${hdf5D_ver}
module load pnetcdf-D/${pnetcdfD_ver}
module load netcdf-D/${netcdfD_ver}
module load nco/${nco_ver}
module load boost/${boost_ver}
module load eigen/${eigen_ver}
module load eckit/${eckit_ver}
module load fckit/${fckit_ver}
module load fms-D/${fmsD_ver}
module load esmf-D/${esmfD_ver}
module load atlas/${atlas_ver}
module load sp/${sp_ver}
module load ip/${ip_ver}
module load gsl-lite/${gsl_lite_ver}
module load libjpeg/${libjpeg_ver}
module load libpng/${libpng_ver}
module load udunits/${udunits_ver}
module load grib_util/${grib_util_ver}
module load python/${python_ver}
module load bufr/${bufr_ver}
module load ve/gfs/${ve_gfs_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/esnowanl.sh
${HOMEgfs}/jobs/JGLOBAL_SNOWENS_ANALYSIS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_snow_anal_ens

PURPOSE: Applies snow analysis to ensemble members -- ensures consistent snow
state across all members.

TROUBLESHOOTING

Depends on deterministic snow analysis (snowanl) completing. If snow
analysis failed, ensemble snow update cannot proceed. Check that snow
analysis output exists. Per-member update -- individual failures
possible but non-critical.

%end
