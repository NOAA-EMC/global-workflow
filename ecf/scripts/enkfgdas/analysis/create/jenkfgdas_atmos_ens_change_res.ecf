#PBS -S /bin/bash
#PBS -N enkfgdas_atmos_ens_change_res_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=3:mpiprocs=1:ompthreads=128:ncpus=128:mem=200GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load python/${python_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load ve/gfs/${ve_gfs_ver}
module load cfp/${cfp_ver}
module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JENKFGDAS_ATMOS_ENS_CHANGE_RES
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_atmos_ens_change_res

PURPOSE: Runs chgres_cube to regrid deterministic forecast to ensemble resolution
for EnKF recentering.

TROUBLESHOOTING

Depends on deterministic forecast fields at ensemble resolution. Check
that chgres_cube executable and input files are available. If resolution
mismatch in grid specs, chgres will fail with grid dimension errors.

%end
