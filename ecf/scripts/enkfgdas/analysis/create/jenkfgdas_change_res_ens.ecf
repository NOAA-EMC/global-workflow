#PBS -S /bin/bash
#PBS -N enkfgdas_change_res_ens_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=3:mpiprocs=1:ompthreads=128:ncpus=128:mem=200GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh gsi

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/echgres.sh
${HOMEgfs}/jobs/JGDAS_ATMOS_CHGRES_FORENKF
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_change_res_ens

PURPOSE: Runs chgres_cube to regrid deterministic forecast to ensemble resolution
for EnKF recentering.

TROUBLESHOOTING

Depends on deterministic forecast fields at ensemble resolution. Check
that chgres_cube executable and input files are available. If resolution
mismatch in grid specs, chgres will fail with grid dimension errors.

%end
