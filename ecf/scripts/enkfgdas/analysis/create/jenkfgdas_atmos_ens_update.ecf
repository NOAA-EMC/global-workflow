#PBS -S /bin/bash
#PBS -N enkfgdas_atmos_ens_update_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:55:00
#PBS -l select=35:mpiprocs=9:ompthreads=14:ncpus=126
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load python/${python_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load ve/gfs/${ve_gfs_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load ncdiag-A/${ncdiag_ver}
module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/eupd.sh
${HOMEgfs}/jobs/JGLOBAL_ENKF_UPDATE
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_atmos_ens_update

PURPOSE: EnKF update -- THE core Ensemble Kalman Filter algorithm. 35 nodes =
4410 cores. Produces ensemble analysis increments.

TROUBLESHOOTING

CRITICAL and resource-intensive. Depends on eobs (observation
innovations) completing. If eobs failed, eupd has no observation-space
data. Failures: non-convergence, memory exhaustion (35 nodes x 126
cpus), MPI errors. Check EnKF stdout for error messages. If the ensemble
spread is too small, filter can diverge. Expert assistance required for
non-obvious failures.

%end
