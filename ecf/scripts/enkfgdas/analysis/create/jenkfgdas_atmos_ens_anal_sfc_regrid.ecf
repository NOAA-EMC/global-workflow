#PBS -S /bin/bash
#PBS -N enkfgdas_atmos_ens_anal_sfc_regrid_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l select=8:mpiprocs=64:ompthreads=1:ncpus=64
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_ATMOS_ENS_ANAL_SFC_REGRID
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_atmos_ens_anal_sfc_regrid

PURPOSE: EnKF ensemble surface analysis -- regrids the surface 
increments for each ensemble member from the Gaussian grid to 
the FV3 tiles 

TROUBLESHOOTING

There is a large amount of I/O in this job, check for I/O
performance issues. Each member is computed independently.
If input data for a single member is corrupted, rerun
enkfgdas_atmos_ens_update.  If rerun cannot be done, copy
full data from uncorrupted member into the corrupted member 
slot.

%end
