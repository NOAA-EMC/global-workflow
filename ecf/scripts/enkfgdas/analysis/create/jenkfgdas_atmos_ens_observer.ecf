#PBS -S /bin/bash
#PBS -N enkfgdas_atmos_ens_observer_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:25:00
#PBS -l select=4:mpiprocs=50:ompthreads=2:ncpus=100
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load python/${python_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load crtm/${crtm_ver}
module load ve/gfs/${ve_gfs_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load ncdiag-A/${ncdiag_ver}
module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_ATMOS_ENS_OBSERVER
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_atmos_ens_observer

PURPOSE: EnKF observation selection -- runs GSI in observer mode to compute
innovations (O-F) for all ensemble members. 4 nodes.

TROUBLESHOOTING

Prerequisite for eupd. Depends on ensemble member forecasts and
observation data (from prep). If prep failed or ensemble forecasts are
missing, eobs cannot compute innovations. Check GSI observer mode stdout
for missing data types or computation errors. If most observations are
rejected in QC, check observation input quality.

%end
