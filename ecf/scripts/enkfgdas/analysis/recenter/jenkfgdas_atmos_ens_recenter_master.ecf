#PBS -S /bin/bash
#PBS -N enkfgdas_atmos_ens_recenter_%CYC%_%FHRGRP%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:20:00
#PBS -l select=3:mpiprocs=32:ompthreads=4:ncpus=128
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load python/${python_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}

module use /apps/dev/modulefiles
module load ve/gw/${gw_ve_ver}




module list
############################################################
# CALL executable job script here
############################################################
export WGF="%WGF%"
export FHRGRP="%FHRGRP%"
export FHRLST="%FHRLST%"
export FHMIN_ECEN="${FHRLST}"
export FHMAX_ECEN="${FHRLST}"
export FHOUT_ECEN="${FHRLST}"
export HOMEglobal=${HOMEgfs}
export COMPONENT=${WGF}

#### ${HOMEgfs}/dev/job_cards/rocoto/ecen.sh
${HOMEgfs}/jobs/JGLOBAL_ENKF_ECEN
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_atmos_ens_recenter_master

PURPOSE: EnKF recentering -- recenters ensemble member analyses around the high-
resolution deterministic analysis. Per-group _master template.

TROUBLESHOOTING

Depends on both the deterministic GDAS analysis (atmos_anal) and the
EnKF update (eupd). If either upstream failed, recentering cannot
proceed. Check that both deterministic and ensemble analyses exist. If
recentering produces large increments, check analysis consistency
between deterministic and ensemble.

%end
