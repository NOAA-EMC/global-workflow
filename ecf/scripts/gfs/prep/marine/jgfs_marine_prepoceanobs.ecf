#PBS -S /bin/bash
#PBS -N gfs_marine_prepoceanobs_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=48GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufsda

module list
############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/prepoceanobs.sh
${HOMEgfs}/jobs/JGLOBAL_PREP_OCEAN_OBS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_marine_prepoceanobs

PURPOSE: Ocean observation preparation -- converts raw ocean obs (T/S profiles,
altimetry, SST, sea ice) to IODA format for SOCA.

TROUBLESHOOTING

Python-based IODA converters. Check Python traceback in stdout. Common
failures: missing raw observation files from data feeds, IODA converter
bugs on unusual data formats, or filesystem permission issues on input
directories. Non-critical obs may be skipped (data of opportunity) but
core obs (Argo profiles, satellite altimetry) are required.

%end
