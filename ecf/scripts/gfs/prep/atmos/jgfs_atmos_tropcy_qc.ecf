#PBS -S /bin/bash
#PBS -N %RUN%_atmos_tropcy_qc_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:05:00
#PBS -l select=1:ncpus=1:mem=1GB
#PBS -l place=vscatter
#PBS -l debug=true

model=gfs
%include <head.h>
%include <envir-p1.h>

set -x

export NET=%NET:gfs%
export RUN=%RUN%
export CDUMP=%RUN%

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load wgrib2/${wgrib2_ver}

module list

export PROCESS_TROPCY=YES
export cyc=%CYC%
export cycle=t%CYC%z

############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_ATMOS_TROPCY_QC

if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_atmos_tropcy_qc

PURPOSE: Performs tropical cyclone tcvitals quality control

TROUBLESHOOTING

Reads seasonal statistics as well as current TC data from NHC and JTWC.
If an error occurs in the qctropcy utility script, a null tcvitals
file should be produced and cycling should continue. If null file is
not produced and error is not easily rectified by rerunning, create
null tcvitals file and continue cycling.

%end
