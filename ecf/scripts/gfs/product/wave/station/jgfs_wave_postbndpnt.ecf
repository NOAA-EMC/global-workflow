#PBS -S /bin/bash
#PBS -N gfs_wave_postbndpnt_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l select=1:mpiprocs=40:ompthreads=1:ncpus=40
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufswm

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/wavepostbndpnt.sh
${HOMEgfs}/jobs/JGLOBAL_WAVE_POST_BNDPNT
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_wave_postbndpnt

PURPOSE: Generates wave boundary-point spectral data for nested regional wave
models. Single-instance per cycle.

TROUBLESHOOTING

Similar to postbndpntbll but produces spectral (not bulletin) output.
Depends on WW3 boundary point output from forecast. If boundary location
configuration changed, mod_def mismatch can cause segfaults. Check wave
grid definitions match between init and post. Downstream models use this
job, but can use previous cycle as back-up. While improved from v16,
this job will slow down or fail when there are filesystem issues.

%end
