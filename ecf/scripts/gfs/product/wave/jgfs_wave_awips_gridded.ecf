#PBS -S /bin/bash
#PBS -N gfs_wave_awips_gridded_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=02:00:00
#PBS -l select=1:mpiprocs=1:ompthreads=1:ncpus=128:mem=2G
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load libjpeg/${libjpeg_ver}
module load grib_util/${grib_util_ver}
module load wgrib2/${wgrib2_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/waveawipsgridded.sh
${HOMEgfs}/jobs/JGLOBAL_WAVE_PRDGEN_GRIDDED
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_wave_awips_gridded

PURPOSE: Generates AWIPS-compatible gridded wave bulletins (WMO GRIB2)
from WW3 output for NWS forecast offices. Single-instance task.

TROUBLESHOOTING

Depends on wave_postsbs_master gridded output. If wave GRIB2 files are
missing, AWIPS generation fails. Check $COMOUT_WAVE_GRID. Also check
tocgrib2 and wgrib2 utilities loaded correctly. If WMO headers are
wrong, products may generate but be rejected downstream.

%end
