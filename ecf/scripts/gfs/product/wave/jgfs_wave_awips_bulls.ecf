#PBS -S /bin/bash
#PBS -N gfs_wave_awips_bulls_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:20:00
#PBS -l select=1:mpiprocs=1:ompthreads=1:ncpus=128
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load util_shared/${util_shared_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGFS_WAVE_AWIPS_BULLS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_wave_awips_bulls

PURPOSE: Generates WMO text bulletins from wave station (point) output for AWIPS
distribution. Single-instance per cycle.

TROUBLESHOOTING

Depends on wave_postpnt output (point spectral data). If postpnt did not
complete, bulls will fail. Lightweight job. Check that bulletin station
list is present and point output files exist in COMOUT_WAVE_STATION.

%end
