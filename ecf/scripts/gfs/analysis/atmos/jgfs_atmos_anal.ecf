#PBS -S /bin/bash
#PBS -N gfs_atmos_anal_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=01:20:00
#PBS -l select=100:mpiprocs=16:ompthreads=8:ncpus=128
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load python/${python_ver}
module load libjpeg/${libjpeg_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load grib_util/${grib_util_ver}
module load ncdiag-A/${ncdiag_ver}
module load crtm/${crtm_ver}
module use /apps/dev/modulefiles
module load ve/gw/${gw_ve_ver}
module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/anal.sh
${HOMEgfs}/jobs/JGLOBAL_ATMOS_ANALYSIS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

=======
TASK gfs_atmos_anal

PURPOSE: Runs GSI atmospheric analysis (Hybrid-4DEnVar). 100 nodes. THE core DA
step producing atmospheric initial conditions for GFS forecast.

TROUBLESHOOTING

This job requires an enormous amount of observational data, the entire
GDAS EnKF ensemble, GDAS background, and many other inputs. Hence there
are many ways that failures elsewhere in the production suite can cause
the GSI to fail. Debugging requires expert assistance -- call on-call
staff unless the failure is immediately obvious (downed node, filesystem
crash). Check GSI stdout for FATAL ERROR messages and minimization
convergence in fort.220.

%end
