#PBS -S /bin/bash
#PBS -N gfs_atmos_anal_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=01:20:00
#PBS -l select=75:mpiprocs=16:ompthreads=8:ncpus=128
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh gsi

module list
############################################################
# CALL executable job script here
############################################################
export CDATE=${PDY}${cyc}

#### ${HOMEgfs}/dev/job_cards/rocoto/anal.sh
${HOMEgfs}/jobs/JGLOBAL_ATMOS_ANALYSIS
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

%end

