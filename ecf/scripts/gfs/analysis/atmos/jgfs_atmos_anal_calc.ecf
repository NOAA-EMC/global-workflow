#PBS -S /bin/bash
#PBS -N gfs_atmos_anal_calc_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=500GB
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load python/${python_ver}
module load libjpeg/${libjpeg_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load grib_util/${grib_util_ver}
module load ncdiag-A/${ncdiag_ver}
module load crtm/${crtm_ver}
module load ve/gfs/${ve_gfs_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/analcalc.sh
${HOMEgfs}/jobs/JGLOBAL_ATMOS_ANALYSIS_CALC
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_atmos_anal_calc

PURPOSE: Post-analysis calculations -- applies GSI increments to background to
produce full analysis fields and diagnostics.

TROUBLESHOOTING

Depends on successful completion of atmos_anal. If analysis failed,
analcalc has no input. Relatively simple job -- failures are usually
missing analysis increment files or module load issues. Check that
COMOUT from analysis step has the expected files (siganl, sfcanl).

%end
