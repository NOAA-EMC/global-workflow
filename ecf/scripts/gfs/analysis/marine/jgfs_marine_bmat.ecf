#PBS -S /bin/bash
#PBS -N gfs_marine_bmat_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l select=8:mpiprocs=64:ompthreads=1:ncpus=64:mem=500GB
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load intel/${intel_ver}
module load craype/${craype_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load udunits/${udunits_ver}
module load python/${python_ver}
module load ve/gfs/${ve_gfs_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/marinebmat.sh
${HOMEgfs}/jobs/JGLOBAL_MARINE_BMAT
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_marine_bmat

PURPOSE: Computes the marine background error covariance matrix (B-matrix) using
ensemble statistics. 8 nodes, heavy compute.

TROUBLESHOOTING

Requires ensemble member ocean restart files. If EnKF forecasts did not
complete, B-matrix computation fails. Check for sufficient ensemble
members available. SOCA B-matrix code can fail on singular matrices if
ensemble spread is too small. One case was found where a corrupted CICE
history file resulted in a failure in the B-matrix computation. While the
cause was fixed it is worth noting a workaround. If ice
or ocean inputs are corrupted, they can be regenerated by rerunning the
GDAS forecast or EnKFGDAS forecast for the affected member(s) from the
previous cycle. In a pinch, the GFS 6-hour average ocean and/or ice
file can be used as a substitute for the GDAS forecast. This can be
achieved by copying
$COMgfs/gfs.$pPDY/$pcyc/model/ocean/history/gfs.t${cyc}z.6hr_avg.f006.nc
to
$COMgfs/gdas.$pPDY/$pcyc/model/ocean/history/gdas.t${cyc}z.inst.fHHH.nc
where pPDY and pcyc are the previous PDY and cycle and HHH is the hour of
the corrupted file. The same can be done for the ice file.

Expert assistance is recommended for non-obvious failures.

%end
