#PBS -S /bin/bash
#PBS -N gfs_marine_anal_init_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=24GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load intel/${intel_ver}
module load craype/${craype_ver}
module load python/${python_ver}
module load ve/gfs/${ve_gfs_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_MARINE_ANAL_INIT
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_marine_anal_init

PURPOSE: Initializes the marine (ocean+ice) data assimilation -- stages
background fields, observations, and B-matrix inputs for SOCA solver.

TROUBLESHOOTING

Python-based (exglobal_marine_analysis_initialize.py). Check Python
traceback in stdout. Common failures: missing background restart files
from previous cycle forecast, missing observation files from
prepoceanobs, or B-matrix files from marine_bmat. If previous cycle
failed, marine_anl_init will fail. Check COMIN paths resolve.

%end
