#PBS -S /bin/bash
#PBS -N gfs_marine_bmat_init_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:20:00
#PBS -l select=1:mpiprocs=128:ompthreads=1:ncpus=128:mem=24GB
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
#TODO: load only the modules needed for each job
source ${HOMEgfs}/dev/ush/load_modules.sh ufsda

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

#### ${HOMEgfs}/dev/job_cards/rocoto/marinebmatinit.sh
${HOMEgfs}/jobs/JGLOBAL_MARINE_BMAT_INITIALIZE
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_marine_bmat_init

PURPOSE: Initializes B-matrix computation by staging ensemble member data and
preparing work environment.

TROUBLESHOOTING

Staging job -- fails if ensemble member restart files are not in
expected COM locations. Check that EnKF member forecasts completed and
restarts were written to COMOUT. If paths changed between versions,
check config.marinebmat for correct directory templates.

%end
