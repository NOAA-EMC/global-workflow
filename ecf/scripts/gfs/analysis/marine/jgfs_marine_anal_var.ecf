#PBS -S /bin/bash
#PBS -N gfs_marine_anal_var_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l select=8:mpiprocs=64:ompthreads=1:ncpus=64:mem=500GB
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load intel/${intel_ver}
module load craype/${craype_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load nco/${nco_ver}
module load boost/${boost_ver}
module load eigen/${eigen_ver}
module load eckit/${eckit_ver}
module load fckit/${fckit_ver}
module load fms-D/${fms_ver}
module load esmf-D/${esmf_ver}
module load atlas/${atlas_ver}
module load sp/${sp_ver}
module load libjpeg/${libjpeg_ver}
module load gsl-lite/${gsl_lite_ver}
module load udunits/${udunits_ver}
module load grib_util/${grib_util_ver}
module load python/${python_ver}
module load bufr/${bufr_ver}
module load ve/gfs/${ve_gfs_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_MARINE_ANAL_VAR
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_marine_anal_var

PURPOSE: Marine variational analysis solver (SOCA 3DVar-FGAT) -- core ocean/ice
DA producing analysis. 8 nodes, heavy compute.

TROUBLESHOOTING

Complex solver. Failures can be: non-convergence (check cost function in
stdout), missing observations (from prepoceanobs), missing background
(from forecast), or B-matrix issues (from marine_bmat). Expert
assistance recommended for solver failures. Check for SOCA FATAL
messages in stdout. MPI errors indicate node/interconnect problems.

%end
