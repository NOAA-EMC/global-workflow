#PBS -S /bin/bash
#PBS -N gfs_snow_anal_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:15:00
#PBS -l select=4:mpiprocs=64:ompthreads=2:ncpus=128
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load intel/${intel_ver}
module load craype/${craype_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load udunits/${udunits_ver}
module load python/${python_ver}
module load ve/gfs/${ve_gfs_ver}

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}

${HOMEgfs}/jobs/JGLOBAL_SNOW_ANAL
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK gfs_snow_anal

PURPOSE: JEDI snow analysis -- assimilates satellite snow cover/depth
observations (IMS, GHCN, SNODEP) to update land surface snow state. 4
nodes.

TROUBLESHOOTING

JEDI-based (Python driver). Check Python traceback in stdout. Common
failures: missing snow observation files (IMS data), missing background
snow fields from previous cycle, or JEDI configuration YAML errors. If
IMS data feed is delayed, snow analysis will fail. The job can proceed
without some obs (data of opportunity) but not without background.

%end
