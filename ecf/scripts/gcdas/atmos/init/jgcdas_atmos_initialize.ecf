#PBS -S /bin/bash
#PBS -N %RUN%_atmos_initialize_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=1:ompthreads=128:ncpus=128
#PBS -l place=vscatter:shared
#PBS -l debug=true

model=gcafs
%include <head.h>
%include <envir-p1.h>

set -x

export NET=%NET:gcafs%
export RUN=%RUN%

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
export USE_CFP="YES"

module load python/${python_ver}
module use /apps/dev/modulefiles
module load ve/gw/${gw_ve_ver}

module load gempak/${gempak_ver}
module load perl/${perl_ver}
module load libjpeg/${libjpeg_ver}
module load udunits/${udunits_ver}
module load gsl/${gsl_ver}
module load cdo/${cdo_ver}
module load imagemagick/${imagemagick_ver}

module load hdf5-D/${hdf5_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load netcdf-D/${netcdf_ver}
module load esmf-D/${esmf_ver}

module load nco/${nco_ver}
module load prod_util/${prod_util_ver}
module load grib_util/${grib_util_ver}
module load bufr_dump/${bufr_dump_ver}
module load util_shared/${util_shared_ver}
module load g2tmpl/${g2tmpl_ver}
module load ncdiag-A/${ncdiag_ver}
module load crtm/${crtm_ver}
module load wgrib2/${wgrib2_ver}

module list

#############################################################
# environment settings
#############################################################
export cyc=%CYC%
export cycle=t%CYC%z
export EXPDIR=%EXPDIR%

if [[ -d "${HOMEgcafs}/sorc/wxflow/src" ]]; then
  PYTHONPATH="${HOMEgcafs}/sorc/wxflow/src${PYTHONPATH:+:${PYTHONPATH}}"
fi
PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${HOMEgcafs}/ush/python"
export PYTHONPATH

############################################################
# CALL executable job script here
############################################################
${HOMEgcafs}/jobs/JGCDAS_ATMOS_INITIALIZE

if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

%end
