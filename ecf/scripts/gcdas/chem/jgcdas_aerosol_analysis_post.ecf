#PBS -S /bin/bash
#PBS -N %RUN%_aerosol_analysis_post_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:10:00
#PBS -l select=1:mpiprocs=120:ompthreads=1:ncpus=120
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gcafs
%include <head.h>
%include <envir-p1.h>

set -x

export NET=%NET:gcafs%
export RUN=%RUN%

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load cfp/${cfp_ver}
module load libjpeg/${libjpeg_ver}
#module load hdf5-D/${hdf5_ver}
#module load netcdf-D/${netcdf_ver}
module load grib_util/${grib_util_ver}
module load crtm/${crtm_ver}
module load g2tmpl/${g2tmpl_ver}
module load wgrib2/${wgrib2_ver}
#module load python/${python_ver}
#module load pnetcdf-D/${pnetcdf_ver}
module load jasper/2.0.25
module load libpng/1.6.37
module load zlib/1.2.11
module load g2/3.5.1
module load ip/4.0.0
module load sp/2.3.3
module load w3emc/2.12.0
module load bacio/2.4.1
module load w3nco/2.4.1
module load nemsio/2.5.2
module load sigio/2.3.2
module load wrf_io/1.2.0
module load python/3.12.0
module load hdf5/1.10.6
module load netcdf/4.7.4
module load libjpeg/9c
module load prod_util/2.0.9

module use /apps/dev/modulefiles
module load ve/gw/1.0


module list

#############################################################
# environment settings
#############################################################
export cyc=%CYC%
export cycle=t%CYC%z
export USE_CFP=YES
export g2tmpl_ver=v${g2tmpl_ver}
export FHR3=000
export UPP_RUN=analysis
export FORECAST_HOUR=0
export HOMEgfs=${HOMEgcafs}

if [[ -d "${HOMEgcafs}/sorc/wxflow/src" ]]; then
  PYTHONPATH="${HOMEgcafs}/sorc/wxflow/src${PYTHONPATH:+:${PYTHONPATH}}"
fi
PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${HOMEgcafs}/ush/python"
export PYTHONPATH


############################################################
# CALL executable job script here
############################################################
${HOMEgcafs}/jobs/JGCDAS_ATMOS_UPP

if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

%end
